# examples/streaming.cyr -- the zero-allocation real-time path.
# Ported from rust-old/examples/streaming.rs.
#
# ⚠ THE POINT OF THIS EXAMPLE: Cyrius's bump allocator NEVER frees. An
# allocation inside an audio callback is not a leak that grows slowly, it is one
# that ends the process. Allocate the block buffer ONCE, outside the loop, and
# use the `_into` forms which write into storage you own.
#
#   cyrius build examples/streaming.cyr build/example-streaming

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"
include "src/error.cyr"
include "src/logging.cyr"
include "src/rng.cyr"
include "src/smooth.cyr"
include "src/lod.cyr"
include "src/formant.cyr"
include "src/spectral.cyr"
include "src/glottal.cyr"
include "src/tract.cyr"
include "src/voice.cyr"
include "src/phoneme.cyr"
include "src/prosody.cyr"
include "src/trajectory.cyr"
include "src/sequence.cyr"

# print a literal without hand-counting its bytes
fn ex_s(t) { print(t, strlen(t)); return 0; }
# label + a float, one line
fn ex_f(label, v) { ex_s(label); fmt_float(v, 4); ex_s("\n"); return 0; }
# label + an integer, one line
fn ex_i(label, v) { ex_s(label); fmt_int(v); ex_s("\n"); return 0; }

#must_use
fn st_rms(buf, n) {
    var acc = 0;
    var i = 0;
    while (i < n) { var s = load64(buf + i * 8); acc = f64_add(acc, f64_mul(s, s)); i = i + 1; }
    return f64_sqrt(f64_div(acc, f64_from(n)));
}

#must_use
fn st_peak(buf, n) {
    var mx = 0;
    var i = 0;
    while (i < n) {
        var a = f64_abs(load64(buf + i * 8));
        if (f64_gt(a, mx) == 1) { mx = a; }
        i = i + 1;
    }
    return mx;
}

fn main() {
    alloc_init();
    var sr = f64_from(44100);
    var block = 512;
    var voice = svara_voice_new_male();

    var glottal = svara_voice_create_glottal_source(voice, sr);
    if (svara_is_err(glottal) == 1) { println("glottal failed"); return 1; }
    var tract = svara_tract_new(sr);
    if (svara_is_err(tract) == 1) { println("tract failed"); return 1; }
    var e = svara_tract_set_vowel(tract, SVARA_VOWEL_A);
    if (svara_is_err(e) == 1) { println("vowel failed"); return 1; }

    # ALLOCATE ONCE. svara_alloc_samples bounds the count and returns 0 rather
    # than handing back a pointer that cannot be written -- always test it.
    var buffer = svara_alloc_samples(block);
    if (buffer == 0) { println("buffer alloc failed"); return 1; }

    println("=== svara: streaming 512-sample blocks at 44100 Hz ===");
    var b = 0;
    while (b < 10) {
        # zero allocation from here down
        svara_tract_synthesize_into(tract, glottal, buffer, block);
        ex_s("  block "); fmt_int(b);
        ex_s("  rms="); fmt_float(st_rms(buffer, block), 4);
        ex_s("  peak="); fmt_float(st_peak(buffer, block), 4);
        ex_s("\n");
        # parameters can change mid-stream
        if (b == 4) {
            println("  --- switching to /i/ ---");
            var e2 = svara_tract_set_vowel(tract, SVARA_VOWEL_I);
            if (svara_is_err(e2) == 1) { println("switch failed"); return 1; }
        }
        b = b + 1;
    }

    # quality scaling, for background voices in a crowd
    println("");
    println("=== quality levels (same input, fewer pipeline stages) ===");
    var q = 0;
    while (q < 3) {
        var t2 = svara_tract_new(sr);
        if (svara_is_err(t2) == 1) { println("tract failed"); return 1; }
        svara_tract_set_quality(t2, q);
        var e3 = svara_tract_set_vowel(t2, SVARA_VOWEL_A);
        if (svara_is_err(e3) == 1) { println("vowel failed"); return 1; }
        var g2 = svara_voice_create_glottal_source(voice, sr);
        if (svara_is_err(g2) == 1) { println("glottal failed"); return 1; }
        svara_tract_synthesize_into(t2, g2, buffer, block);
        ex_s("  quality "); fmt_int(q);
        ex_s(" (max formants "); fmt_int(svara_quality_max_formants(q));
        ex_s(")  rms="); fmt_float(st_rms(buffer, block), 4);
        ex_s("\n");
        q = q + 1;
    }
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
