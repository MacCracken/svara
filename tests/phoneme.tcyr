# phoneme.tcyr -- tests for src/phoneme.cyr PART 1 (inventory + classification).
# class() + is_voiced() checked for ALL 101 phonemes against golden arrays
# derived from an independent transcription of the Rust match logic;
# coarticulation_resistance() spot-checked across every arm + class fallback.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "src/error.cyr"
include "src/rng.cyr"
include "src/smooth.cyr"
include "src/lod.cyr"
include "src/formant.cyr"
include "src/glottal.cyr"
include "src/tract.cyr"
include "src/voice.cyr"
include "src/phoneme.cyr"

var TOL_1EM9 = 0x3E112E0BE826D695;   # 1e-9
var TOL_1EM6 = 0x3EB0C6F7A0B5ED8D;   # 1e-6

#must_use
fn ph_approx(a, b, eps) {
    return f64_lt(f64_abs(f64_sub(a, b)), eps);
}
# out[0] = any |s| > 1e-6, out[1] = all finite, over a sample vec.
fn ph_vec_scan(v, out) {
    var any = 0;
    var fin = 1;
    var i = 0;
    var n = vec_len(v);
    while (i < n) {
        var s = vec_get(v, i);
        if (f64_gt(f64_abs(s), TOL_1EM6) == 1) { any = 1; }
        if (svara_is_finite(s) == 0) { fin = 0; }
        i = i + 1;
    }
    store64(out, any);
    store64(out + 8, fin);
}
# sum of |samples| (rough energy proxy for "differs" checks).
#must_use
fn ph_vec_absum(v) {
    var e = 0;
    var i = 0;
    var n = vec_len(v);
    while (i < n) { e = f64_add(e, f64_abs(vec_get(v, i))); i = i + 1; }
    return e;
}
# out[0] = any |s| > 1e-6, out[1] = all finite, over a raw f64 buffer of n slots.
fn ph_raw_scan(buf, n, out) {
    var any = 0;
    var fin = 1;
    var i = 0;
    while (i < n) {
        var s = load64(buf + i * 8);
        if (f64_gt(f64_abs(s), TOL_1EM6) == 1) { any = 1; }
        if (svara_is_finite(s) == 0) { fin = 0; }
        i = i + 1;
    }
    store64(out, any);
    store64(out + 8, fin);
}

alloc_init();

test_group("phoneme count");
assert_eq(SVARA_PHONEME_COUNT, 101, "101 phonemes (IPA-complete)");

