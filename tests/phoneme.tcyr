# phoneme.tcyr -- tests for src/phoneme.cyr PART 1 (inventory + classification).
# class() + is_voiced() checked for ALL 101 phonemes against golden arrays
# derived from an independent transcription of the Rust match logic;
# coarticulation_resistance() spot-checked across every arm + class fallback.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "src/error.cyr"
include "src/rng.cyr"
include "src/smooth.cyr"
include "src/lod.cyr"
include "src/formant.cyr"
include "src/glottal.cyr"
include "src/tract.cyr"
include "src/phoneme.cyr"

var TOL_1EM9 = 0x3E112E0BE826D695;   # 1e-9

#must_use
fn ph_approx(a, b, eps) {
    return f64_lt(f64_abs(f64_sub(a, b)), eps);
}

alloc_init();

test_group("phoneme count");
assert_eq(SVARA_PHONEME_COUNT, 101, "101 phonemes (IPA-complete)");

test_group("class() for all 101");
