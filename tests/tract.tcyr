# tract.tcyr -- tests for src/tract.cyr. Ports rust-old/src/tract.rs #[test]
# blocks (serde: tests/serde.tcyr) + a determinism check. Include order:
# hisab -> goonj -> naad -> error -> rng -> smooth -> lod -> formant -> glottal -> tract.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"
include "src/error.cyr"
include "src/rng.cyr"
include "src/smooth.cyr"
include "src/lod.cyr"
include "src/formant.cyr"
include "src/glottal.cyr"
include "src/tract.cyr"
include "tests/approx.cyr"

var TOL_1EM6 = 0x3EB0C6F7A0B5ED8D;   # 1e-6

# out[0] = any |s| > thresh, out[1] = all finite, over an n-slot f64 buffer
fn buf_scan(buf, n, thresh, out) {
    var any = 0;
    var fin = 1;
    var i = 0;
    while (i < n) {
        var s = load64(buf + i * 8);
        if (f64_gt(f64_abs(s), thresh) == 1) { any = 1; }
        if (svara_is_finite(s) == 0) { fin = 0; }
        i = i + 1;
    }
    store64(out, any);
    store64(out + 8, fin);
}

alloc_init();
var SR = f64_from(44100);
var scan = alloc(16);

# ================================================================
test_group("creation");
var vt = svara_tract_new(SR);
assert_eq(approx(svara_tract_sample_rate(vt), f64_from(44100), SV_EPSILON), 1, "sample_rate == 44100");
assert_eq(svara_tract_quality(vt), SVARA_QUALITY_FULL, "default quality Full");

# ================================================================
test_group("synthesize /a/");
var vta = svara_tract_new(SR);
assert_eq(svara_is_err(svara_tract_set_vowel(vta, SVARA_VOWEL_A)), 0, "set_vowel(A) ok");
var ga = svara_glottal_new(f64_from(120), SR);
var out = svara_tract_synthesize(vta, ga, 1024);
buf_scan(out, 1024, TOL_1EM6, scan);
assert_eq(load64(scan + 8), 1, "1024 samples all finite");
assert_eq(load64(scan), 1, "some |s| > 1e-6 (non-silent)");

# ================================================================
test_group("nasal coupling");
var vtn = svara_tract_new(SR);
assert_eq(svara_is_err(svara_tract_set_vowel(vtn, SVARA_VOWEL_A)), 0, "set_vowel(A) ok");
svara_tract_set_nasal_coupling(vtn, F64_HALF);
var gn = svara_glottal_new(f64_from(120), SR);
var outn = svara_tract_synthesize(vtn, gn, 512);
buf_scan(outn, 512, TOL_1EM6, scan);
assert_eq(load64(scan + 8), 1, "nasal-coupled output all finite");

# ================================================================
test_group("nasal place retune");
var vtp = svara_tract_new(SR);
assert_eq(svara_is_err(svara_tract_set_vowel(vtp, SVARA_VOWEL_A)), 0, "set_vowel(A) ok");
svara_tract_set_nasal_place(vtp, SVARA_NASAL_BILABIAL);
svara_tract_set_nasal_coupling(vtp, F64_HALF);
var gp = svara_glottal_new(f64_from(120), SR);
var outp = svara_tract_synthesize(vtp, gp, 256);
buf_scan(outp, 256, TOL_1EM6, scan);
assert_eq(load64(scan + 8), 1, "bilabial-nasal output all finite");
var velar_af = svara_nasal_place_antiformant_frequency(SVARA_NASAL_VELAR);
assert_eq(approx(velar_af, f64_from(3000), SV_EPSILON), 1, "velar antiformant 3000 Hz");

# ================================================================
test_group("reset -> silence");
var vtr = svara_tract_new(SR);
var gr = svara_glottal_new(f64_from(120), SR);
var junk = svara_tract_synthesize(vtr, gr, 100);
svara_tract_reset(vtr);
assert_eq(f64_lt(f64_abs(svara_tract_process_sample(vtr, 0)), TOL_1EM6), 1, "post-reset silence in -> ~0 out");

# ================================================================
test_group("determinism (same config + seed)");
var t1 = svara_tract_new(SR);
assert_eq(svara_is_err(svara_tract_set_vowel(t1, SVARA_VOWEL_A)), 0, "t1 set_vowel ok");
var b1 = svara_tract_synthesize(t1, svara_glottal_new(f64_from(120), SR), 256);
var t2 = svara_tract_new(SR);
assert_eq(svara_is_err(svara_tract_set_vowel(t2, SVARA_VOWEL_A)), 0, "t2 set_vowel ok");
var b2 = svara_tract_synthesize(t2, svara_glottal_new(f64_from(120), SR), 256);
var identical = 1;
var i = 0;
while (i < 256) {
    if (load64(b1 + i * 8) != load64(b2 + i * 8)) { identical = 0; }
    i = i + 1;
}
assert_eq(identical, 1, "identical config + seed -> bit-identical output");

# ================================================================
test_group("3.8.5: each SV_VT_* offset is the SvVocalTract field its accessor names");
# ================================================================
# Every field gets a distinct value through its derived setter; each offset the
# per-sample code uses must then read its own field's value.
var pin_vt = alloc(sizeof(SvVocalTract));
SvVocalTract_set_filter(pin_vt, 1000);
SvVocalTract_set_nasal_coupling(pin_vt, 1001);
SvVocalTract_set_nasal_antiformant(pin_vt, 1002);
SvVocalTract_set_lip_prev(pin_vt, 1003);
SvVocalTract_set_lip_radiation(pin_vt, 1004);
SvVocalTract_set_interaction_strength(pin_vt, 1005);
SvVocalTract_set_interaction_feedback(pin_vt, 1006);
SvVocalTract_set_subglottal_coupling(pin_vt, 1007);
SvVocalTract_set_subglottal_filter(pin_vt, 1008);
SvVocalTract_set_gain(pin_vt, 1009);
SvVocalTract_set_quality(pin_vt, 1010);
SvVocalTract_set_sample_rate(pin_vt, 1011);
SvVocalTract_set_formants(pin_vt, 1012);
SvVocalTract_set_nasal_place(pin_vt, 1013);
SvVocalTract_set_target_scratch(pin_vt, 1014);
SvVocalTract_set_qflags(pin_vt, 1015);
var pin_vt_bad = 0;
if (load64(pin_vt + SV_VT_FILTER) != 1000) { pin_vt_bad = pin_vt_bad + 1; }
if (load64(pin_vt + SV_VT_NASAL_COUPLING) != 1001) { pin_vt_bad = pin_vt_bad + 1; }
if (load64(pin_vt + SV_VT_NASAL_ANTIFORMANT) != 1002) { pin_vt_bad = pin_vt_bad + 1; }
if (load64(pin_vt + SV_VT_LIP_PREV) != 1003) { pin_vt_bad = pin_vt_bad + 1; }
if (load64(pin_vt + SV_VT_LIP_RADIATION) != 1004) { pin_vt_bad = pin_vt_bad + 1; }
if (load64(pin_vt + SV_VT_INTERACTION_STRENGTH) != 1005) { pin_vt_bad = pin_vt_bad + 1; }
if (load64(pin_vt + SV_VT_INTERACTION_FEEDBACK) != 1006) { pin_vt_bad = pin_vt_bad + 1; }
if (load64(pin_vt + SV_VT_SUBGLOTTAL_COUPLING) != 1007) { pin_vt_bad = pin_vt_bad + 1; }
if (load64(pin_vt + SV_VT_SUBGLOTTAL_FILTER) != 1008) { pin_vt_bad = pin_vt_bad + 1; }
if (load64(pin_vt + SV_VT_GAIN) != 1009) { pin_vt_bad = pin_vt_bad + 1; }
if (load64(pin_vt + SV_VT_QFLAGS) != 1015) { pin_vt_bad = pin_vt_bad + 1; }
assert_eq(pin_vt_bad, 0, "the 11 offsets read the fields their accessors write");
assert_eq(load64(pin_vt + SV_VT_FILTER + 8) != 1000, 1, "control: the next word holds another field");

# ================================================================
test_group("3.12.0: a retarget keeps the resonators' state (ADR-0015)");
# ================================================================
# Two tracts on /a/, each driven by its own identical glottal source. Retargeting one
# to the /a/ it already holds must change nothing, bit for bit; the resetting setter
# must. Then a retarget to /i/ must give each slot fresh coefficients while the
# resonators keep ringing.
#must_use
fn rt_tract(target) {
    var t = svara_tract_new(SR);
    var e = svara_tract_set_formants_from_target(t, target);
    return t;
}
# Samples of two tracts, each fed its own glottal source, that differ in any bit over n.
#must_use
fn rt_pair(ta, ga, tb, gb, n) {
    var bad = 0;
    var i = 0;
    while (i < n) {
        var a = svara_tract_process_sample(ta, svara_glottal_next_sample(ga));
        var b = svara_tract_process_sample(tb, svara_glottal_next_sample(gb));
        if (a != b) { bad = bad + 1; }
        i = i + 1;
    }
    return bad;
}
var rt_a = svara_vowel_target_from_vowel(SVARA_VOWEL_A);
var rt_i = svara_vowel_target_from_vowel(SVARA_VOWEL_I);
var rta = rt_tract(rt_a);
var rtb = rt_tract(rt_a);
var rga = svara_glottal_new(f64_from(120), SR);
var rgb = svara_glottal_new(f64_from(120), SR);
var rt_warm = rt_pair(rta, rga, rtb, rgb, 500);
assert_eq(svara_tract_retarget(rtb, rt_a), SVARA_ERR_NONE, "control: the retarget is accepted");
assert_eq(rt_pair(rta, rga, rtb, rgb, 500), 0, "retargeting to the same /a/ changes nothing, bit for bit");
var rtc = rt_tract(rt_a);
var rtd = rt_tract(rt_a);
var rgc = svara_glottal_new(f64_from(120), SR);
var rgd = svara_glottal_new(f64_from(120), SR);
rt_warm = rt_pair(rtc, rgc, rtd, rgd, 500);
var rt_rs = svara_tract_set_formants_from_target(rtd, rt_a);
assert_eq(rt_pair(rtc, rgc, rtd, rgd, 500) > 0, 1, "control: the resetting setter, to the same /a/, does change it");

var rt_bank = SvFormantFilter_bank(SvVocalTract_filter(rta));
var rt_y1_before = load64(svara_formant_bank_slot(rt_bank, 0) + SV_FSLOT_Y1);
assert_eq(svara_tract_retarget(rta, rt_i), SVARA_ERR_NONE, "a retarget to /i/ is accepted");
var rt_cbuf = alloc(32);
var rt_cbad = 0;
var rt_fi = svara_vowel_target_to_formants(rt_i);
var rk = 0;
while (rk < 5) {
    var rf = vec_get(rt_fi, rk);
    svara_formant_biquad_coeffs(SvFormant_frequency(rf), SvFormant_bandwidth(rf), SR, rt_cbuf);
    var rslot = svara_formant_bank_slot(rt_bank, rk);
    if (load64(rslot + SV_FSLOT_B0) != load64(rt_cbuf)) { rt_cbad = rt_cbad + 1; }
    if (load64(rslot + SV_FSLOT_A1) != load64(rt_cbuf + 16)) { rt_cbad = rt_cbad + 1; }
    if (load64(rslot + SV_FSLOT_A2) != load64(rt_cbuf + 24)) { rt_cbad = rt_cbad + 1; }
    rk = rk + 1;
}
assert_eq(rt_cbad, 0, "each of the five slots holds /i/'s fresh coefficients");
assert_eq(load64(svara_formant_bank_slot(rt_bank, 0) + SV_FSLOT_Y1), rt_y1_before, "and slot 0's state is kept");
assert_eq(rt_y1_before != 0, 1, "control: that state is not zero");

var rt_bad = svara_vowel_target_new(f64_div(0, 0), f64_from(1000), f64_from(2500), f64_from(3500), f64_from(4500));
var rt_b0 = load64(svara_formant_bank_slot(rt_bank, 1) + SV_FSLOT_B0);
assert_eq(svara_is_err(svara_tract_retarget(rta, rt_bad)), 1, "a target with a NaN formant is refused");
assert_eq(load64(svara_formant_bank_slot(rt_bank, 1) + SV_FSLOT_B0), rt_b0, "and leaves the coefficients alone");

var rt_fresh = svara_tract_new(SR);
var rt_set = svara_tract_new(SR);
assert_eq(svara_tract_retarget(rt_fresh, rt_a), SVARA_ERR_NONE, "a fresh tract accepts a retarget");
var rt_se = svara_tract_set_formants_from_target(rt_set, rt_a);
var rgf = svara_glottal_new(f64_from(120), SR);
var rgs = svara_glottal_new(f64_from(120), SR);
assert_eq(rt_pair(rt_fresh, rgf, rt_set, rgs, 500), 0, "on a fresh tract a retarget builds, as the setter does");

var rc = assert_summary();
syscall(60, rc);
