# glottal.tcyr -- tests for src/glottal.cyr (naad-backend path).
# Ports the #[test] blocks from rust-old/src/glottal.rs (serde-roundtrip dropped).
# Golden values: from_rd (pure arithmetic) and the first-period Rosenberg output
# (breathiness=0 -> aspiration noise vanishes -> voiced output is pure pulse).
# Noise/whisper/energy tests are property-based (as in Rust). Include order:
# hisab -> goonj -> naad (bundle deps) -> error -> rng -> glottal.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"
include "src/error.cyr"
include "src/rng.cyr"
include "src/glottal.cyr"
include "tests/approx.cyr"

var TOL_1EM9 = 0x3E112E0BE826D695;   # 1e-9

# sum of squared samples over n draws (energy)
#must_use
fn glottal_energy(gs, n) {
    var e = 0;
    var i = 0;
    while (i < n) {
        var s = svara_glottal_next_sample(gs);
        e = f64_add(e, f64_mul(s, s));
        i = i + 1;
    }
    return e;
}

# out[0] = any |s| > thresh, out[1] = all finite
fn glottal_scan(gs, n, thresh, out) {
    var any = 0;
    var fin = 1;
    var i = 0;
    while (i < n) {
        var s = svara_glottal_next_sample(gs);
        if (f64_gt(f64_abs(s), thresh) == 1) { any = 1; }
        if (svara_is_finite(s) == 0) { fin = 0; }
        i = i + 1;
    }
    store64(out, any);
    store64(out + 8, fin);
}

alloc_init();
var SR = f64_from(44100);
var scan = alloc(16);

# ================================================================
test_group("LfParams from_rd (golden)");
var lp = alloc(24);
svara_lf_params_from_rd(F64_ONE, lp);
assert_eq(approx(load64(lp),      0x3F7A9FBE76C8B43A, TOL_1EM9), 1, "rd=1.0 ta");
assert_eq(approx(load64(lp + 8),  0x3FDD555555555556, TOL_1EM9), 1, "rd=1.0 te");
assert_eq(approx(load64(lp + 16), 0x3FED333333333333, TOL_1EM9), 1, "rd=1.0 ee");
svara_lf_params_from_rd(SV_G_0_3, lp);
assert_eq(approx(load64(lp + 8), 0x3FD999999999999A, TOL_1EM9), 1, "rd=0.3 te=0.4");
assert_eq(approx(load64(lp + 16), F64_ONE, TOL_1EM9), 1, "rd=0.3 ee=1.0 (pressed, strongest)");
svara_lf_params_from_rd(SV_G_2_7, lp);
assert_eq(approx(load64(lp + 16), 0x3FE6666666666666, TOL_1EM9), 1, "rd=2.7 ee=0.7 (breathy, weakest)");

# ================================================================
test_group("creation + f0 validation");
var gs = svara_glottal_new(f64_from(120), SR);
assert_eq(svara_is_err(gs), 0, "120 Hz @ 44100 valid");
assert_eq(approx(svara_glottal_f0(gs), f64_from(120), SV_EPSILON), 1, "f0 == 120");
assert_eq(svara_glottal_model(gs), SVARA_GLOTTAL_ROSENBERG, "default model is Rosenberg");
assert_eq(svara_is_err(svara_glottal_new(f64_from(5), SR)), 1, "f0=5 rejected");
assert_eq(svara_is_err(svara_glottal_new(f64_from(3000), SR)), 1, "f0=3000 rejected");

# ================================================================
test_group("Rosenberg first-period output (golden, breathiness=0)");
# Since 3.11.0 (ADR-0014) the full Rosenberg B: opening 3x^2 - 2x^3 over Tp = OQ*SQ/(1+SQ),
# closing 1 - y^2 over Tn = OQ - Tp, at a peak of 7.13033049099316. Values computed from
# that definition in Python (OQ 0.6, SQ 2, period 44100/120), not from svara. Through
# 3.10.0 the pulse was the Rust's: the opening polynomial over all of OQ, then 0.
var gr = svara_glottal_new(f64_from(120), SR);
var buf = alloc(251 * 8);
var i = 0;
while (i < 251) { store64(buf + i * 8, svara_glottal_next_sample(gr)); i = i + 1; }
assert_eq(load64(buf), 0, "sample[0] = 0 (t=0)");
assert_eq(approx(load64(buf + 1 * 8),   0x3F502528A02BA5CF, TOL_1EM9), 1, "sample[1], opening");
assert_eq(approx(load64(buf + 50 * 8),  0x3FFE9E1F1AA0678D, TOL_1EM9), 1, "sample[50], opening");
assert_eq(approx(load64(buf + 110 * 8), 0x4018029AB42DAF59, TOL_1EM9), 1, "sample[110], opening");
assert_eq(approx(load64(buf + 147 * 8), 0x401C85755B31F2F0, TOL_1EM9), 1, "sample[147] (t = Tp), the peak");
assert_eq(approx(load64(buf + 200 * 8), 0x400B61DC0FC8D096, TOL_1EM9), 1, "sample[200], closing");
assert_eq(approx(load64(buf + 220 * 8), 0x3FB8C01B894B5DAD, TOL_1EM9), 1, "sample[220], closing, near 0");
assert_eq(load64(buf + 250 * 8), 0, "sample[250] = 0 (closed phase, t>0.6)");

# ================================================================
test_group("generates samples (Rosenberg)");
var g1 = svara_glottal_new(f64_from(120), SR);
glottal_scan(g1, 1024, SV_G_0_01, scan);
assert_eq(load64(scan), 1, "some |s| > 0.01");
assert_eq(load64(scan + 8), 1, "all finite");

# ================================================================
test_group("LF model produces output");
var g2 = svara_glottal_new(f64_from(120), SR);
svara_glottal_set_model(g2, SVARA_GLOTTAL_LF);
glottal_scan(g2, 1024, SV_G_0_01, scan);
assert_eq(load64(scan), 1, "LF some |s| > 0.01");
assert_eq(load64(scan + 8), 1, "LF all finite");

# ================================================================
test_group("Rd parameterization: pressed louder than breathy");
var pressed = svara_glottal_new(f64_from(120), SR);
svara_glottal_set_rd(pressed, SV_G_0_3);
svara_glottal_set_jitter(pressed, 0);
svara_glottal_set_shimmer(pressed, 0);
var pressed_e = glottal_energy(pressed, 4410);
var breathy = svara_glottal_new(f64_from(120), SR);
svara_glottal_set_rd(breathy, SV_G_2_7);
svara_glottal_set_jitter(breathy, 0);
svara_glottal_set_shimmer(breathy, 0);
var breathy_e = glottal_energy(breathy, 4410);
assert_eq(f64_gt(pressed_e, breathy_e), 1, "pressed (Rd=0.3) energy > breathy (Rd=2.7)");

# ================================================================
test_group("set_rd auto-switches to LF");
var g3 = svara_glottal_new(f64_from(120), SR);
assert_eq(svara_glottal_model(g3), SVARA_GLOTTAL_ROSENBERG, "starts Rosenberg");
svara_glottal_set_rd(g3, F64_ONE);
assert_eq(svara_glottal_model(g3), SVARA_GLOTTAL_LF, "set_rd -> LF");

# ================================================================
test_group("whisper");
var whis = svara_glottal_new(f64_from(120), SR);
svara_glottal_set_whisper(whis);
assert_eq(svara_glottal_model(whis), SVARA_GLOTTAL_WHISPER, "model is Whisper");
glottal_scan(whis, 4410, 0x3EB0C6F7A0B5ED8D, scan);   # 1e-6
assert_eq(load64(scan + 8), 1, "whisper all finite");
assert_eq(load64(scan), 1, "whisper some |s| > 1e-6");
# whisper RMS < voiced RMS
var whis2 = svara_glottal_new(f64_from(120), SR);
svara_glottal_set_whisper(whis2);
var w_e = glottal_energy(whis2, 4410);
var voiced = svara_glottal_new(f64_from(120), SR);
var v_e = glottal_energy(voiced, 4410);
assert_eq(f64_lt(w_e, v_e), 1, "whisper energy < voiced energy");

# ================================================================
test_group("creaky");
var cr = svara_glottal_new(f64_from(120), SR);
svara_glottal_set_creaky(cr, F64_HALF);
assert_eq(svara_glottal_model(cr), SVARA_GLOTTAL_CREAKY, "model is Creaky");
assert_eq(approx(svara_glottal_rd(cr), F64_HALF, SV_EPSILON), 1, "rd == 0.5");
glottal_scan(cr, 4410, SV_G_0_01, scan);
assert_eq(load64(scan + 8), 1, "creaky all finite");
assert_eq(load64(scan), 1, "creaky some |s| > 0.01");

# ================================================================
test_group("creaky Rd clamped to [0.3, 0.8]");
var cc = svara_glottal_new(f64_from(120), SR);
svara_glottal_set_creaky(cc, F64_TWO);
assert_eq(approx(svara_glottal_rd(cc), SV_G_0_8, SV_EPSILON), 1, "creaky(2.0) -> 0.8");
svara_glottal_set_creaky(cc, SV_G_0_1);
assert_eq(approx(svara_glottal_rd(cc), SV_G_0_3, SV_EPSILON), 1, "creaky(0.1) -> 0.3");

# ================================================================
test_group("period approximately correct (jitter off)");
var gp = svara_glottal_new(f64_from(120), SR);
svara_glottal_set_jitter(gp, 0);
var exp_period = f64_div(f64_from(44100), f64_from(120));
assert_eq(approx(svara_glottal_period_samples(gp), exp_period, F64_ONE), 1, "period ~ 367.5");

# ================================================================
test_group("jitter moves only the period, shimmer only the amplitude");
# ================================================================
# Rust's new_period (glottal.rs at tag 3.6.5): jitter scales the period's offset,
# shimmer the amplitude's. Each source first runs past the period new() drew with
# the default jitter and shimmer, then is read at every sample of ten more.
var gjit = svara_glottal_new(f64_from(120), SR);
svara_glottal_set_jitter(gjit, SV_G_0_05);
svara_glottal_set_shimmer(gjit, 0);
var gshim = svara_glottal_new(f64_from(120), SR);
svara_glottal_set_jitter(gshim, 0);
svara_glottal_set_shimmer(gshim, SV_G_0_1);
var gk = 0;
var gdump = 0;
while (gk < 400) {
    gdump = svara_glottal_next_sample(gjit);
    gdump = svara_glottal_next_sample(gshim);
    gk = gk + 1;
}
var jit_amp_moved = 0;
var jit_period_moved = 0;
var shim_amp_moved = 0;
var shim_period_moved = 0;
gk = 0;
while (gk < 3700) {
    gdump = svara_glottal_next_sample(gjit);
    gdump = svara_glottal_next_sample(gshim);
    if (SvGlottalSource_current_amplitude(gjit) != F64_ONE) { jit_amp_moved = jit_amp_moved + 1; }
    if (svara_glottal_period_samples(gjit) != exp_period) { jit_period_moved = jit_period_moved + 1; }
    if (SvGlottalSource_current_amplitude(gshim) != F64_ONE) { shim_amp_moved = shim_amp_moved + 1; }
    if (svara_glottal_period_samples(gshim) != exp_period) { shim_period_moved = shim_period_moved + 1; }
    gk = gk + 1;
}
assert_eq(jit_amp_moved, 0, "with shimmer 0, jitter leaves the amplitude at exactly 1.0");
assert_eq(shim_period_moved, 0, "with jitter 0, shimmer leaves the period at exactly sr / f0");
assert_eq(jit_period_moved > 0, 1, "control: jitter 0.05 moves the period");
assert_eq(shim_amp_moved > 0, 1, "control: shimmer 0.1 moves the amplitude");

# ================================================================
test_group("3.8.5: each SV_GS_* offset is the SvGlottalSource field its accessor names");
# ================================================================
# Every field gets a distinct value through its derived setter; each offset the
# per-sample code uses must then read its own field's value.
var pin_gs = alloc(sizeof(SvGlottalSource));
SvGlottalSource_set_model(pin_gs, 1000);
SvGlottalSource_set_rd(pin_gs, 1001);
SvGlottalSource_set_lf_ta(pin_gs, 1002);
SvGlottalSource_set_lf_te(pin_gs, 1003);
SvGlottalSource_set_lf_ee(pin_gs, 1004);
SvGlottalSource_set_f0(pin_gs, 1005);
SvGlottalSource_set_sample_rate(pin_gs, 1006);
SvGlottalSource_set_open_quotient(pin_gs, 1007);
SvGlottalSource_set_speed_quotient(pin_gs, 1008);
SvGlottalSource_set_spectral_tilt(pin_gs, 1009);
SvGlottalSource_set_jitter(pin_gs, 1010);
SvGlottalSource_set_shimmer(pin_gs, 1011);
SvGlottalSource_set_breathiness(pin_gs, 1012);
SvGlottalSource_set_diplophonia(pin_gs, 1013);
SvGlottalSource_set_diplo_phase(pin_gs, 1014);
SvGlottalSource_set_vibrato_rate(pin_gs, 1015);
SvGlottalSource_set_vibrato_depth(pin_gs, 1016);
SvGlottalSource_set_tilt_state(pin_gs, 1017);
SvGlottalSource_set_phase(pin_gs, 1018);
SvGlottalSource_set_current_period(pin_gs, 1019);
SvGlottalSource_set_current_amplitude(pin_gs, 1020);
SvGlottalSource_set_rng(pin_gs, 1021);
SvGlottalSource_set_aspiration_noise(pin_gs, 1022);
SvGlottalSource_set_vibrato_lfo(pin_gs, 1023);
SvGlottalSource_set_tilt_alpha(pin_gs, 1024);
SvGlottalSource_set_tilt_alpha_tilt(pin_gs, 1025);
SvGlottalSource_set_tilt_alpha_rate(pin_gs, 1026);
SvGlottalSource_set_tone_n(pin_gs, 1027);
SvGlottalSource_set_tone_base(pin_gs, 1028);
SvGlottalSource_set_tone_span(pin_gs, 1029);
SvGlottalSource_set_tone_pos(pin_gs, 1030);
SvGlottalSource_set_tone_xs(pin_gs, 1031);
SvGlottalSource_set_tone_ys(pin_gs, 1032);
var pin_gs_bad = 0;
if (load64(pin_gs + SV_GS_MODEL) != 1000) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_SPEED_QUOTIENT) != 1008) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_TILT_ALPHA) != 1024) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_TONE_N) != 1027) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_TONE_BASE) != 1028) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_TONE_SPAN) != 1029) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_TONE_POS) != 1030) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_TONE_XS) != 1031) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_TONE_YS) != 1032) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_TILT_ALPHA_TILT) != 1025) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_TILT_ALPHA_RATE) != 1026) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_LF_TA) != 1002) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_LF_TE) != 1003) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_LF_EE) != 1004) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_F0) != 1005) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_SAMPLE_RATE) != 1006) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_OPEN_QUOTIENT) != 1007) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_SPECTRAL_TILT) != 1009) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_JITTER) != 1010) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_SHIMMER) != 1011) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_BREATHINESS) != 1012) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_DIPLOPHONIA) != 1013) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_DIPLO_PHASE) != 1014) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_VIBRATO_RATE) != 1015) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_VIBRATO_DEPTH) != 1016) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_TILT_STATE) != 1017) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_PHASE) != 1018) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_CURRENT_PERIOD) != 1019) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_CURRENT_AMPLITUDE) != 1020) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_RNG) != 1021) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_ASPIRATION_NOISE) != 1022) { pin_gs_bad = pin_gs_bad + 1; }
if (load64(pin_gs + SV_GS_VIBRATO_LFO) != 1023) { pin_gs_bad = pin_gs_bad + 1; }
assert_eq(pin_gs_bad, 0, "the 32 offsets read the fields their accessors write");
assert_eq(load64(pin_gs + SV_GS_MODEL + 8) != 1000, 1, "control: the next word holds another field");

# 10*log10 of the power gain at 3 kHz of y = (1-a)x + a*y[n-1], from its transfer
# function (1-a) / (1 - a z^-1): ADR-0012's definition of TL, computed here, not by svara.
#must_use
fn tl_gain_db(a, sr) {
    var c = f64_cos(f64_div(f64_mul(F64_TAU, f64_from(3000)), sr));
    var num = f64_mul(f64_sub(F64_ONE, a), f64_sub(F64_ONE, a));
    var den = f64_add(f64_sub(F64_ONE, f64_mul(f64_mul(F64_TWO, a), c)), f64_mul(a, a));
    return f64_div(f64_mul(f64_from(10), f64_log2(f64_div(num, den))), f64_log2(f64_from(10)));
}

# Samples of two glottal sources over n samples that differ in any bit.
#must_use
fn tl_pair(ga, gb, n) {
    var bad = 0;
    var i = 0;
    while (i < n) {
        if (svara_glottal_next_sample(ga) != svara_glottal_next_sample(gb)) { bad = bad + 1; }
        i = i + 1;
    }
    return bad;
}

# A Rosenberg source at 120 Hz with no jitter, shimmer or breathiness, at tilt t.
#must_use
fn tl_source(t, sr) {
    var g = svara_glottal_new(f64_from(120), sr);
    svara_glottal_set_jitter(g, 0);
    svara_glottal_set_shimmer(g, 0);
    svara_glottal_set_breathiness(g, 0);
    svara_glottal_set_spectral_tilt(g, t);
    return g;
}

# ================================================================
test_group("3.9.0: the voiced tilt is Klatt's TL, dB down at 3 kHz (ADR-0012)");
# ================================================================
# Through 3.8.8 the coefficient was exp(-2*pi*tilt/sr), the Rust's: a one-pole low-pass
# with its corner at `tilt` hertz, so a tilt of 2 was a 2 Hz low-pass in front of the voice.
var tl_bad = 0;
var tl_rates = vec_new();
vec_push(tl_rates, f64_from(16000)); vec_push(tl_rates, SR); vec_push(tl_rates, f64_from(96000));
var tl_vals = vec_new();
vec_push(tl_vals, 0x3FB999999999999A); vec_push(tl_vals, F64_ONE); vec_push(tl_vals, F64_TWO);
vec_push(tl_vals, f64_from(6)); vec_push(tl_vals, f64_from(12)); vec_push(tl_vals, f64_from(40));
var tri = 0;
while (tri < vec_len(tl_rates)) {
    var tvi = 0;
    while (tvi < vec_len(tl_vals)) {
        var tlv = vec_get(tl_vals, tvi);
        var ta = svara_glottal_tilt_alpha(tlv, vec_get(tl_rates, tri));
        if (approx(tl_gain_db(ta, vec_get(tl_rates, tri)), f64_neg(tlv), TOL_1EM9) == 0) { tl_bad = tl_bad + 1; }
        tvi = tvi + 1;
    }
    tri = tri + 1;
}
assert_eq(tl_bad, 0, "each coefficient's gain at 3 kHz is TL dB down, TL 0.1 to 40, at 16, 44.1 and 96 kHz");
assert_eq(svara_glottal_tilt_alpha(0, SR), 0, "TL 0 is no filter: alpha exactly 0");
assert_eq(svara_glottal_tilt_alpha(0x7FF0000000000000, SR), F64_ONE, "TL +inf is alpha exactly 1");

var tl_flat = tl_source(0, SR);
var tl_neg = tl_source(f64_neg(F64_TWO), SR);
var tl_nan = tl_source(f64_div(0, 0), SR);
var tl_flat2 = tl_source(0, SR);
assert_eq(tl_pair(tl_flat, tl_neg, 2000), 0, "a negative tilt leaves the pulse unfiltered, bit for bit");
assert_eq(tl_pair(tl_flat2, tl_nan, 2000), 0, "so does a NaN tilt");

# The coefficient is memoized on the tilt's bits: a tilt written through the derived
# accessor, which skips the setter, must still be solved, and a change re-solves it.
var tl_set = tl_source(f64_from(6), SR);
var tl_acc = tl_source(0, SR);
SvGlottalSource_set_spectral_tilt(tl_acc, f64_from(6));
var tl_memo = tl_pair(tl_set, tl_acc, 1000);
svara_glottal_set_spectral_tilt(tl_set, F64_TWO);
SvGlottalSource_set_spectral_tilt(tl_acc, F64_TWO);
tl_memo = tl_memo + tl_pair(tl_set, tl_acc, 1000);
assert_eq(tl_memo, 0, "a tilt set through the accessor, and changed mid-stream, gives the setter's bits");
# Both sources above run the same memo, so they agree even if it never re-solved. Hold
# the memo's coefficient to a fresh solve after each change.
assert_eq(load64(tl_set + SV_GS_TILT_ALPHA), svara_glottal_tilt_alpha(F64_TWO, SR),
  "after a change through the setter the memo holds tilt 2's coefficient");
assert_eq(load64(tl_acc + SV_GS_TILT_ALPHA), svara_glottal_tilt_alpha(F64_TWO, SR),
  "after a change through the accessor it does too");
var tl_small = tl_source(F64_HALF, SR);
var tl_none = tl_source(0, SR);
assert_eq(tl_pair(tl_small, tl_none, 1000) > 0, 1, "a tilt of 0.5, below 1, still filters the pulse");
var tl_two = tl_source(F64_TWO, SR);
var tl_six = tl_source(f64_from(6), SR);
assert_eq(tl_pair(tl_two, tl_six, 1000) > 0, 1, "control: tilts 2 and 6 give different pulses");

# ================================================================
test_group("3.9.0: whisper keeps the Rust's noise integrator (ADR-0012)");
# ================================================================
# rust-old/src/glottal.rs:440-443 at tag 3.6.5: a one-pole whose corner is the tilt
# in hertz, at least 12, on the aspiration noise scaled by 0.15. Rebuilt here from a
# second white-noise generator on the source's seed, 42, and held to the source bit
# for bit, at tilt 0 (the 12 Hz floor) and at tilt 30.
#must_use
fn wh_pair(tilt, sr, n) {
    var g = svara_glottal_new(f64_from(120), sr);
    svara_glottal_set_whisper(g);
    svara_glottal_set_spectral_tilt(g, tilt);
    var nz = noise_new(NOISE_WHITE, 42);
    var corner = f64_max(tilt, f64_from(12));
    var a = f64_exp(f64_div(f64_neg(f64_mul(F64_TAU, corner)), sr));
    var st = 0;
    var bad = 0;
    var i = 0;
    while (i < n) {
        st = f64_add(f64_mul(f64_mul(f64_sub(F64_ONE, a), noise_next_sample(nz)), 0x3FC3333333333333),
          f64_mul(a, st));
        if (svara_glottal_next_sample(g) != st) { bad = bad + 1; }
        i = i + 1;
    }
    return bad;
}
assert_eq(wh_pair(0, SR, 2000), 0, "whisper at tilt 0 is the 12 Hz integrator, bit for bit");
assert_eq(wh_pair(f64_from(30), SR, 2000), 0, "whisper at tilt 30 is a 30 Hz integrator, bit for bit");

# ================================================================
test_group("3.11.0: the speed quotient shapes the Rosenberg pulse (ADR-0014)");
# ================================================================
# Sources at speed quotient 1 and 4: the peak sits at Tp = OQ*SQ/(1+SQ) of the period,
# sample 110.25 and 176.4 of 367.5, and the two pulses differ.
var sq1 = svara_glottal_new(f64_from(120), SR);
svara_glottal_set_speed_quotient(sq1, F64_ONE);
var sq4 = svara_glottal_new(f64_from(120), SR);
svara_glottal_set_speed_quotient(sq4, f64_from(4));
var sq_i = 0;
var sq1_at = 0;
var sq1_pk = 0;
var sq4_at = 0;
var sq4_pk = 0;
var sq_diff = 0;
while (sq_i < 360) {
    var s1 = svara_glottal_next_sample(sq1);
    var s4 = svara_glottal_next_sample(sq4);
    if (f64_gt(s1, sq1_pk) == 1) { sq1_pk = s1; sq1_at = sq_i; }
    if (f64_gt(s4, sq4_pk) == 1) { sq4_pk = s4; sq4_at = sq_i; }
    if (s1 != s4) { sq_diff = sq_diff + 1; }
    sq_i = sq_i + 1;
}
assert_eq((sq1_at >= 109) & (sq1_at <= 111), 1, "at SQ 1 the peak is at sample 110 of 367.5, Tp = OQ/2");
assert_eq((sq4_at >= 175) & (sq4_at <= 177), 1, "at SQ 4 it is at sample 176, Tp = 0.8 OQ");
assert_eq(sq_diff > 200, 1, "control: SQ 1 and SQ 4 give different pulses");

var sqn = svara_glottal_new(f64_from(120), SR);
svara_glottal_set_speed_quotient(sqn, f64_from(3));
svara_glottal_set_speed_quotient(sqn, f64_div(0, 0));
assert_eq(SvGlottalSource_speed_quotient(sqn), f64_from(3), "a NaN speed quotient leaves the current one");
svara_glottal_set_speed_quotient(sqn, 0x7FF0000000000000);
assert_eq(SvGlottalSource_speed_quotient(sqn), SV_G_5_0, "+inf clamps to 5");
svara_glottal_set_speed_quotient(sqn, 0xFFF0000000000000);
assert_eq(SvGlottalSource_speed_quotient(sqn), F64_HALF, "-inf clamps to 0.5");
var sq_st = svara_glottal_save(svara_glottal_new(f64_from(120), SR));
SvGlottalState_set_speed_quotient(sq_st, f64_div(0, 0));
var sq_back = svara_glottal_restore(sq_st);
assert_eq(SvGlottalSource_speed_quotient(sq_back), F64_TWO, "a restored NaN speed quotient becomes the default 2");

var rc = assert_summary();
syscall(60, rc);
