# oracle.tcyr -- scenarios the Rust asserted that the Cyrius port did not.
#
# Found by an audit of `rust-old/`'s 213 tests against the port's suites, as the
# pre-removal gate for retiring the oracle: these must be closed
# WHILE the oracle is still readable, because after deletion the expectations
# could only be transcribed from svara's own output -- which would freeze any
# existing bug in as "correct". That is naad 2.2.1's lesson, learned there the
# hard way while closing 182 untested public functions.
#
# ⚠ EVERY expected value below is re-derived from the Rust source, cited by
# line, and NOT taken from running svara. Where the Rust asserted a relation
# (finite, non-silent, differs) rather than a number, the relation is asserted.
#
# The five gaps, and why each mattered:
#   1. Quality levels    -- `svara_tract_set_quality` appeared in NO suite or
#                           bench, so every quality-conditional branch in
#                           svara_tract_process_sample ran Full-only under test.
#   2. Jitter / shimmer  -- the glottal suite sets both to 0 to keep its goldens
#                           deterministic, so nothing asserted that non-zero
#                           perturbation perturbs.
#   3. Breathiness       -- svara_glottal_set_breathiness was in no suite at all.
#   4. Spectral energy   -- tests/spectral.tcyr analyses synthetic sines only;
#                           nothing fed SYNTHESIZED SPEECH to the analyzer, so
#                           the one cross-module acoustic check was absent.
#   5. Seven bridge maps -- tested on neither side of the port.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"
include "src/error.cyr"
include "src/logging.cyr"
include "src/rng.cyr"
include "src/smooth.cyr"
include "src/lod.cyr"
include "src/formant.cyr"
include "src/spectral.cyr"
include "src/glottal.cyr"
include "src/tract.cyr"
include "src/voice.cyr"
include "src/phoneme.cyr"
include "src/prosody.cyr"
include "src/trajectory.cyr"
include "src/sequence.cyr"
include "src/pool.cyr"
include "src/bridge.cyr"

var SR = 0x40E5888000000000;   # 44100.0
var TOL_1EM6 = 0x3EB0C6F7A0B5ED8D;   # 1e-6
var TOL_1EM3 = 0x3F50624DD2F1A9FC;   # 1e-3

# 1 if |a - b| < eps.
#must_use
fn or_approx(a, b, eps) { return f64_lt(f64_abs(f64_sub(a, b)), eps); }

# Goertzel magnitude at `target_freq`, ported from the Rust test helper
# (rust-old/tests/integration.rs:655-677) so the acoustic check below uses the
# oracle's own estimator rather than a different one that might disagree.
#   k     = (0.5 + n*f/sr) truncated      omega = 2*pi*k/n      coeff = 2*cos(omega)
#   s0    = sample + coeff*s1 - s2        (s2 <- s1, s1 <- s0 each step)
#   power = s0^2 + s1^2 - coeff*s0*s1     -> sqrt(|power|)/n
#must_use
fn or_goertzel(buf, n, target_freq, sample_rate) {
    if (n == 0) { return 0; }
    var k = svara_count_from_f64(f64_add(F64_HALF,
        f64_div(f64_mul(f64_from(n), target_freq), sample_rate)));
    var omega = f64_div(f64_mul(F64_TAU, f64_from(k)), f64_from(n));
    var coeff = f64_mul(F64_TWO, f64_cos(omega));
    var s0 = 0;
    var s1 = 0;
    var i = 0;
    while (i < n) {
        var s2 = s1;
        s1 = s0;
        s0 = f64_sub(f64_add(vec_get(buf, i), f64_mul(coeff, s1)), s2);
        i = i + 1;
    }
    var power = f64_sub(f64_add(f64_mul(s0, s0), f64_mul(s1, s1)), f64_mul(f64_mul(coeff, s0), s1));
    return f64_div(f64_sqrt(f64_abs(power)), f64_from(n));
}

# sum of |a[i] - b[i]| over n slots of two raw f64 buffers
#must_use
fn or_bufdiff(a, b, n) {
    var acc = 0;
    var i = 0;
    while (i < n) {
        acc = f64_add(acc, f64_abs(f64_sub(load64(a + i * 8), load64(b + i * 8))));
        i = i + 1;
    }
    return acc;
}

# ---- 3.6.5 helpers ---------------------------------------------------------

# 1 if every slot of a vec<f64> is finite.
#must_use
fn or_vec_finite(v) {
    var i = 0;
    while (i < vec_len(v)) {
        if (svara_is_finite(vec_get(v, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Largest |s| in a vec<f64>.
#must_use
fn or_vec_peak(v) {
    var pk = 0;
    var i = 0;
    while (i < vec_len(v)) { pk = f64_max(pk, f64_abs(vec_get(v, i))); i = i + 1; }
    return pk;
}

# Sum of |a[i] - b[i]| over the shorter of two vec<f64>.
#must_use
fn or_vec_diffsum(a, b) {
    var n = vec_len(a);
    if (vec_len(b) < n) { n = vec_len(b); }
    var acc = 0;
    var i = 0;
    while (i < n) { acc = f64_add(acc, f64_abs(f64_sub(vec_get(a, i), vec_get(b, i)))); i = i + 1; }
    return acc;
}

# Largest |s[i+1] - s[i]| in a vec<f64>.
#must_use
fn or_vec_max_jump(v) {
    var j = 0;
    var i = 1;
    while (i < vec_len(v)) {
        j = f64_max(j, f64_abs(f64_sub(vec_get(v, i), vec_get(v, i - 1))));
        i = i + 1;
    }
    return j;
}

# 1 if all of the first n f64s of a raw buffer are finite.
#must_use
fn or_buf_finite(b, n) {
    var i = 0;
    while (i < n) {
        if (svara_is_finite(load64(b + i * 8)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Largest |s| over the first n f64s of a raw buffer.
#must_use
fn or_buf_peak(b, n) {
    var pk = 0;
    var i = 0;
    while (i < n) { pk = f64_max(pk, f64_abs(load64(b + i * 8))); i = i + 1; }
    return pk;
}

# Synthesize each phoneme in `ps` (a vec of ids) at `dur` seconds, or at its own
# phoneme_duration when dur is 0. Returns how many came back as an error, a
# non-finite sample, or (when need_sound is 1) silence at 1e-6.
#must_use
fn or_synth_all(ps, voice, dur, need_sound) {
    var bad = 0;
    var i = 0;
    while (i < vec_len(ps)) {
        var p = vec_get(ps, i);
        var d = dur;
        if (d == 0) { d = svara_phoneme_duration(p); }
        var v = svara_phoneme_synthesize(p, voice, SR, d);
        if (svara_is_err(v) == 1) { bad = bad + 1; }
        else {
            if (or_vec_finite(v) == 0) { bad = bad + 1; }
            elif (need_sound == 1) {
                if (f64_gt(or_vec_peak(v), TOL_1EM6) == 0) { bad = bad + 1; }
            }
        }
        i = i + 1;
    }
    return bad;
}

# Render each phoneme in `ps` through one context at `dur` seconds. Returns how
# many came back as an error or with a non-finite sample.
#must_use
fn or_ctx_all(ctx, ps, voice, dur) {
    var bad = 0;
    var i = 0;
    while (i < vec_len(ps)) {
        var n = svara_synthctx_synthesize(ctx, vec_get(ps, i), voice, dur, 0);
        if (svara_is_err(n) == 1) { bad = bad + 1; }
        elif (or_buf_finite(svara_synthctx_buffer(ctx), n) == 0) { bad = bad + 1; }
        i = i + 1;
    }
    return bad;
}

# A vec of phoneme ids from a raw list of `n` i64s.
#must_use
fn or_ids(list, n) {
    var v = vec_new();
    var i = 0;
    while (i < n) { vec_push(v, load64(list + i * 8)); i = i + 1; }
    return v;
}

# A sequence of up to four (phoneme, duration, stress) events; phoneme -1 ends it.
#must_use
fn or_seq(p0, d0, s0, p1, d1, s1, p2, d2, s2, p3, d3, s3) {
    var q = svara_sequence_new();
    svara_sequence_push(q, svara_phoneme_event_new(p0, d0, s0));
    if (p1 >= 0) { svara_sequence_push(q, svara_phoneme_event_new(p1, d1, s1)); }
    if (p2 >= 0) { svara_sequence_push(q, svara_phoneme_event_new(p2, d2, s2)); }
    if (p3 >= 0) { svara_sequence_push(q, svara_phoneme_event_new(p3, d3, s3)); }
    return q;
}

# GAPS 6-9, closed in 3.6.5 before rust-old/ is retired: every Rust #[test] was
# mapped onto the Cyrius suites, and these are the ones with no assertion (4) or a
# weaker one (the rest). Each cites `git show 3.6.4:rust-old/...`, the last tag
# that will carry the Rust. Where a control goes beyond what the Rust asserted,
# its expectation was read from the compiled oracle, never from svara.
fn or_sweep_365(voice) {
    var U = SVARA_STRESS_UNSTRESSED;
    var P = SVARA_STRESS_PRIMARY;
    var S = SVARA_STRESS_SECONDARY;
    var nas_n = svara_nasalization_for_nasal(SVARA_PH_NASAL_N);

    # ================================================================
    test_group("GAP 6: four Rust tests no Cyrius suite asserted");
    # sequence.rs:698-740 -- V-CC-V renders shorter than V-C-V plus a full consonant.
    # The oracle renders V-C-V at 6701 samples and V-CC-V at 5765: compression
    # makes the cluster version shorter outright, so no "longer" control applies.
    var out_no = svara_sequence_render(or_seq(SVARA_PH_VOWEL_A, 0.1, U, SVARA_PH_FRIC_S, 0.08, U,
        SVARA_PH_VOWEL_I, 0.1, U, 0 - 1, 0, 0), voice, SR);
    var out_cl = svara_sequence_render(or_seq(SVARA_PH_VOWEL_A, 0.1, U, SVARA_PH_FRIC_S, 0.08, U,
        SVARA_PH_PLOSIVE_T, 0.08, U, SVARA_PH_VOWEL_I, 0.1, U), voice, SR);
    assert_eq(svara_is_err(out_no) | svara_is_err(out_cl), 0, "both sequences render");
    assert_eq(or_vec_finite(out_cl), 1, "the cluster render is finite");
    var naive_extra = svara_count_from_f64(f64_mul(f64_mul(0.08, 0.9), SR));   # 3175
    assert_eq(naive_extra, 3175, "control: (0.08 * 0.9 * 44100) as usize is 3175, as in Rust");
    assert_eq(vec_len(out_cl) < vec_len(out_no) + naive_extra, 1,
      "the cluster is compressed below V-C-V plus a full consonant");
    # The oracle renders 6701 and 5765. Each unstressed 0.1 s vowel is 3969 samples
    # here and 3968 there: f32 computes 0.1 * 0.9 * 44100 as 3968.9998 and truncates
    # down, f64 as 3969.0000000000005 (ADR-0009, SQ-LEN). So svara is one longer per
    # vowel, and the consonants agree (3175, and 2222 each in the cluster).
    assert_eq(vec_len(out_no), 6701 + 2, "V-C-V is the oracle's 6701 plus one sample per vowel");
    assert_eq(vec_len(out_cl), 5765 + 2, "V-CC-V is the oracle's 5765 plus one sample per vowel");

    # voice.rs:479-482 -- a new male voice has no bandwidth widening.
    assert_eq(or_approx(SvVoiceProfile_bandwidth_widening(svara_voice_new_male()), 0, SV_EPSILON), 1,
      "male bandwidth_widening defaults to 0");

    # voice.rs:524-544 -- widening grows with f0. Rust asserts B1(800) > B1(400),
    # which sqrt(f0/120) alone would satisfy, so the factor itself is asserted too:
    # voice.rs:355-358 gives 1 + w * 0.3 * (f0 - 300) / 500, so 1.06 at 400 Hz and
    # 1.30 at 800 Hz with w = 1.
    var tgt = svara_vowel_target_from_vowel(SVARA_VOWEL_A);
    var w400 = svara_voice_with_bandwidth_widening(
      svara_voice_with_f0(svara_voice_new_female(), f64_from(400)), F64_ONE);
    var w800 = svara_voice_with_bandwidth_widening(
      svara_voice_with_f0(svara_voice_new_female(), f64_from(800)), F64_ONE);
    var n400 = svara_voice_with_f0(svara_voice_new_female(), f64_from(400));
    var n800 = svara_voice_with_f0(svara_voice_new_female(), f64_from(800));
    var b_w400 = SvVowelTarget_b1(svara_voice_apply_formant_scale(w400, tgt));
    var b_w800 = SvVowelTarget_b1(svara_voice_apply_formant_scale(w800, tgt));
    var b_n400 = SvVowelTarget_b1(svara_voice_apply_formant_scale(n400, tgt));
    var b_n800 = SvVowelTarget_b1(svara_voice_apply_formant_scale(n800, tgt));
    assert_eq(f64_gt(b_w800, b_w400), 1, "widened B1 at 800 Hz exceeds widened B1 at 400 Hz");
    assert_eq(or_approx(f64_div(b_w400, b_n400), 1.06, TOL_1EM6), 1, "widening factor at 400 Hz is 1.06");
    assert_eq(or_approx(f64_div(b_w800, b_n800), 1.3, TOL_1EM6), 1, "widening factor at 800 Hz is 1.30");

    # phoneme.rs:2285-2300 -- a nasalized diphthong renders. phoneme.rs:1510-1517
    # nasalizes diphthongs as well as vowels, and the oracle's nasalized /ai/
    # differs from its oral /ai/ (sum |diff| 0.0051), so that is asserted too.
    var nd = svara_phoneme_synthesize_nasalized(SVARA_PH_DIPH_AI, voice, SR, 0.15, nas_n);
    assert_eq(svara_is_err(nd), 0, "nasalized /ai/ synthesizes");
    assert_eq(or_vec_finite(nd), 1, "nasalized /ai/ is finite");
    assert_eq(f64_gt(or_vec_peak(nd), TOL_1EM6), 1, "nasalized /ai/ is not silent");
    var od = svara_phoneme_synthesize(SVARA_PH_DIPH_AI, voice, SR, 0.15);
    assert_eq(vec_len(nd), vec_len(od), "control: same length as the oral /ai/");
    assert_eq(f64_gt(or_vec_diffsum(od, nd), TOL_1EM6), 1, "nasalization changes the diphthong");

    # ================================================================
    test_group("GAP 7: whole phoneme sets, not one member each");
    var lst = alloc(34 * 8);
    # phoneme.rs:2350-2367 -- every click, 0.04 s, ok and finite.
    store64(lst, SVARA_PH_CLICK_BILABIAL); store64(lst + 8, SVARA_PH_CLICK_DENTAL);
    store64(lst + 16, SVARA_PH_CLICK_ALVEOLAR); store64(lst + 24, SVARA_PH_CLICK_PALATAL);
    store64(lst + 32, SVARA_PH_CLICK_LATERAL);
    assert_eq(or_synth_all(or_ids(lst, 5), voice, 0.04, 0), 0, "all five clicks render finite");
    # phoneme.rs:2370-2387 -- every ejective, 0.1 s.
    store64(lst, SVARA_PH_EJECTIVE_P); store64(lst + 8, SVARA_PH_EJECTIVE_T);
    store64(lst + 16, SVARA_PH_EJECTIVE_K); store64(lst + 24, SVARA_PH_EJECTIVE_S);
    store64(lst + 32, SVARA_PH_EJECTIVE_CH);
    assert_eq(or_synth_all(or_ids(lst, 5), voice, 0.1, 0), 0, "all five ejectives render finite");
    # phoneme.rs:2390-2409 -- every implosive, 0.08 s, finite and not silent.
    store64(lst, SVARA_PH_IMPLOSIVE_B); store64(lst + 8, SVARA_PH_IMPLOSIVE_D);
    store64(lst + 16, SVARA_PH_IMPLOSIVE_G);
    assert_eq(or_synth_all(or_ids(lst, 3), voice, 0.08, 1), 0, "all three implosives render and sound");
    # phoneme.rs:2447-2470 -- the seven IPA vowels, 0.08 s, finite and not silent.
    var k = 0;
    while (k < 7) { store64(lst + k * 8, SVARA_PH_VOWEL_Y + k); k = k + 1; }
    assert_eq(load64(lst + 48), SVARA_PH_VOWEL_CLOSE_CENTRAL_ROUNDED, "control: ids 46-52 are the seven IPA vowels");
    assert_eq(or_synth_all(or_ids(lst, 7), voice, 0.08, 1), 0, "all seven IPA vowels render and sound");
    # phoneme.rs:2473-2521 -- the 34 IPA consonants, each at its own duration.
    k = 0;
    while (k < 34) { store64(lst + k * 8, SVARA_PH_PLOSIVE_UVULAR_Q + k); k = k + 1; }
    assert_eq(load64(lst + 33 * 8), SVARA_PH_AFFR_LATERAL, "control: ids 53-86 are the 34 IPA consonants");
    assert_eq(or_synth_all(or_ids(lst, 34), voice, 0, 0), 0, "all 34 IPA consonants render finite");

    # ================================================================
    test_group("GAP 8: the synthesis context, every class and in sequence");
    # phoneme.rs:2223-2244 -- nine classes through one context, 0.08 s each.
    var ctx = svara_synthctx_new(voice, SR);
    store64(lst, SVARA_PH_VOWEL_A); store64(lst + 8, SVARA_PH_DIPH_AI);
    store64(lst + 16, SVARA_PH_PLOSIVE_P); store64(lst + 24, SVARA_PH_FRIC_S);
    store64(lst + 32, SVARA_PH_NASAL_N); store64(lst + 40, SVARA_PH_AFFR_CH);
    store64(lst + 48, SVARA_PH_APPROX_R); store64(lst + 56, SVARA_PH_LATERAL_L);
    store64(lst + 64, SVARA_PH_SILENCE);
    assert_eq(or_ctx_all(ctx, or_ids(lst, 9), voice, 0.08), 0, "all nine classes render finite in one context");
    # phoneme.rs:2412-2426 -- the three non-pulmonic classes in a context.
    store64(lst, SVARA_PH_CLICK_DENTAL); store64(lst + 8, SVARA_PH_EJECTIVE_T);
    store64(lst + 16, SVARA_PH_IMPLOSIVE_D);
    assert_eq(or_ctx_all(ctx, or_ids(lst, 3), voice, 0.08), 0, "click, ejective and implosive render in a context");
    # phoneme.rs:2303-2324 -- state does not leak: a vowel after a fricative sounds.
    var c2 = svara_synthctx_new(voice, SR);
    var n1 = svara_synthctx_synthesize(c2, SVARA_PH_FRIC_S, voice, 0.06, 0);
    assert_eq(or_buf_finite(svara_synthctx_buffer(c2), n1), 1, "/s/ first is finite");
    var n2 = svara_synthctx_synthesize(c2, SVARA_PH_VOWEL_A, voice, 0.08, 0);
    assert_eq(or_buf_finite(svara_synthctx_buffer(c2), n2), 1, "/a/ after /s/ is finite");
    assert_eq(f64_gt(or_buf_peak(svara_synthctx_buffer(c2), n2), TOL_1EM6), 1, "/a/ after /s/ is not silent");
    var n3 = svara_synthctx_synthesize(c2, SVARA_PH_NASAL_M, voice, 0.06, 0);
    assert_eq(or_buf_finite(svara_synthctx_buffer(c2), n3), 1, "/m/ after them is finite");

    # ================================================================
    test_group("GAP 9: the Rust thresholds and inputs, where the port's differed");
    # bridge.rs:329-334 -- the range bounds, besides the ordering.
    assert_eq(f64_le(svara_bridge_breathiness_from_arousal(0), F64_ONE), 1, "calm breathiness <= 1");
    assert_eq(f64_ge(svara_bridge_breathiness_from_arousal(F64_ONE), 0), 1, "excited breathiness >= 0");
    # glottal.rs:676-700 -- whisper RMS below 0.8 x voiced RMS over 4410 samples.
    var gv = svara_glottal_new(f64_from(120), SR);
    var gw = svara_glottal_new(f64_from(120), SR);
    svara_glottal_set_whisper(gw);
    var ev = 0;
    var ew = 0;
    k = 0;
    while (k < 4410) {
        var sv = svara_glottal_next_sample(gv);
        var sw = svara_glottal_next_sample(gw);
        ev = f64_add(ev, f64_mul(sv, sv));
        ew = f64_add(ew, f64_mul(sw, sw));
        k = k + 1;
    }
    assert_eq(f64_lt(f64_sqrt(ew), f64_mul(f64_sqrt(ev), 0.8)), 1, "whisper RMS < 0.8 x voiced RMS");
    # glottal.rs:723-731 -- creaky at 80 Hz, rd 0.4, jitter 0.01, a full second.
    var gc = svara_glottal_new(f64_from(80), SR);
    svara_glottal_set_creaky(gc, 0.4);
    svara_glottal_set_jitter(gc, 0.01);
    var cbad = 0;
    k = 0;
    while (k < 44100) {
        if (svara_is_finite(svara_glottal_next_sample(gc)) == 0) { cbad = cbad + 1; }
        k = k + 1;
    }
    assert_eq(cbad, 0, "a second of creaky voice at 80 Hz stays finite");
    # voice.rs:447-453 -- F2 is scaled by 1.17 too, not only F1.
    var fsc = svara_voice_apply_formant_scale(svara_voice_new_female(), tgt);
    assert_eq(or_approx(SvVowelTarget_f2(fsc), f64_mul(SvVowelTarget_f2(tgt), 1.17), 0.01), 1, "female F2 = F2 x 1.17");
    # voice.rs:608-626 -- every effort gives 1024 finite samples.
    var ebad = 0;
    var ef = SVARA_EFFORT_WHISPER;
    while (ef <= SVARA_EFFORT_SHOUT) {
        var eg = svara_voice_create_glottal_source_with_effort(voice, ef, SR);
        if (svara_is_err(eg) == 1) { ebad = ebad + 1; }
        else {
            k = 0;
            while (k < 1024) {
                if (svara_is_finite(svara_glottal_next_sample(eg)) == 0) { ebad = ebad + 1; k = 1024; }
                k = k + 1;
            }
        }
        ef = ef + 1;
    }
    assert_eq(ebad, 0, "all five efforts give finite output");
    # sequence.rs:766-776 -- render_planned through a nasal.
    var pl = svara_sequence_render_planned(or_seq(SVARA_PH_VOWEL_A, 0.1, P, SVARA_PH_NASAL_N, 0.06, U,
        SVARA_PH_VOWEL_I, 0.1, S, 0 - 1, 0, 0), voice, SR);
    assert_eq(svara_is_err(pl), 0, "planned A-N-I renders");
    assert_eq(vec_len(pl) > 0, 1, "planned A-N-I is not empty");
    assert_eq(or_vec_finite(pl), 1, "planned A-N-I is finite");
    # pool.rs:236-249 -- the batch is finite.
    var pool = svara_pool_new(voice, SR);
    var bp = vec_new();
    var bd = vec_new();
    vec_push(bp, SVARA_PH_VOWEL_A); vec_push(bd, 0.08);
    vec_push(bp, SVARA_PH_NASAL_N); vec_push(bd, 0.05);
    vec_push(bp, SVARA_PH_VOWEL_I); vec_push(bd, 0.08);
    var bo = svara_pool_render_batch(pool, bp, bd, voice);
    assert_eq(svara_is_err(bo), 0, "pool batch renders");
    assert_eq(or_vec_finite(bo), 1, "pool batch is finite");
    assert_eq(svara_pool_render_count(pool), 3, "pool counted three renders");
    # phoneme.rs:2134-2148 -- the place of all six nasals.
    assert_eq(SvNasalization_place(svara_nasalization_for_nasal(SVARA_PH_NASAL_M)), SVARA_NASAL_BILABIAL, "m bilabial");
    assert_eq(SvNasalization_place(nas_n), SVARA_NASAL_ALVEOLAR, "n alveolar");
    assert_eq(SvNasalization_place(svara_nasalization_for_nasal(SVARA_PH_NASAL_NG)), SVARA_NASAL_VELAR, "ng velar");
    assert_eq(SvNasalization_place(svara_nasalization_for_nasal(SVARA_PH_NASAL_RETRO)), SVARA_NASAL_ALVEOLAR,
      "retroflex nasal alveolar");
    assert_eq(SvNasalization_place(svara_nasalization_for_nasal(SVARA_PH_NASAL_PALATAL)), SVARA_NASAL_ALVEOLAR,
      "palatal nasal alveolar");
    assert_eq(SvNasalization_place(svara_nasalization_for_nasal(SVARA_PH_NASAL_UVULAR)), SVARA_NASAL_VELAR,
      "uvular nasal velar");
    # phoneme.rs:2163-2182 -- nasalized /a/ (before /n/) differs from oral by more
    # than 0.01 summed. The oracle measures 0.76.
    var oa = svara_phoneme_synthesize(SVARA_PH_VOWEL_A, voice, SR, 0.1);
    var na = svara_phoneme_synthesize_nasalized(SVARA_PH_VOWEL_A, voice, SR, 0.1, nas_n);
    assert_eq(f64_gt(or_vec_diffsum(oa, na), 0.01), 1, "nasalized /a/ differs from oral by > 0.01");
    # integration.rs:6-15 -- half a second of /a/, finite, peak above 0.001.
    var a5 = svara_phoneme_synthesize(SVARA_PH_VOWEL_A, voice, SR, F64_HALF);
    assert_eq(or_vec_finite(a5), 1, "0.5 s of /a/ is finite");
    assert_eq(f64_gt(or_vec_peak(a5), TOL_1EM3), 1, "0.5 s of /a/ peaks above 0.001");
    # integration.rs:67-90 -- /a/ to /i/ at 0.15 s each, no jump past 2.5 x peak.
    # The Rust guards the check with peak > 0.001, so that is asserted first.
    var ai = svara_sequence_render(or_seq(SVARA_PH_VOWEL_A, 0.15, P, SVARA_PH_VOWEL_I, 0.15, P,
        0 - 1, 0, 0, 0 - 1, 0, 0), voice, SR);
    var ai_pk = or_vec_peak(ai);
    assert_eq(f64_gt(ai_pk, TOL_1EM3), 1, "control: the 0.15 s /a/-/i/ peaks above 0.001");
    assert_eq(f64_lt(or_vec_max_jump(ai), f64_mul(ai_pk, 2.5)), 1, "no click: max jump < 2.5 x peak");
    return 0;
}

# Test entry point — runs this file's suite and returns the assert summary.
fn main() {
    alloc_init();
    var voice = svara_voice_new_male();

    # ================================================================
    test_group("GAP 1: every Quality level synthesizes");
    # ================================================================
    # rust-old/tests/integration.rs:593-616 -- for Full, Reduced and Minimal:
    # 1024 samples must all be finite, and at least one must exceed 1e-6.
    # Until now nothing exercised Reduced or Minimal at all.
    var qi = 0;
    var q_checked = 0;
    while (qi < 3) {
        var tr = svara_tract_new(SR);
        assert_eq(svara_is_err(tr), 0, "control: tract constructs");
        var ve = svara_tract_set_vowel(tr, SVARA_VOWEL_A);
        assert_eq(ve, SVARA_ERR_NONE, "control: vowel set");
        svara_tract_set_quality(tr, qi);
        var gq = svara_glottal_new(f64_from(120), SR);
        var bufq = svara_tract_synthesize(tr, gq, 1024);
        assert_eq(bufq != 0, 1, "quality level synthesizes a buffer");
        var fin = 1;
        var loud = 0;
        var si = 0;
        while (si < 1024) {
            var v = load64(bufq + si * 8);
            if (svara_is_finite(v) == 0) { fin = 0; }
            if (f64_gt(f64_abs(v), TOL_1EM6) == 1) { loud = 1; }
            si = si + 1;
        }
        assert_eq(fin, 1, "all 1024 samples finite at this quality");
        assert_eq(loud, 1, "and the output is not silence at this quality");
        q_checked = q_checked + 1;
        qi = qi + 1;
    }
    assert_eq(q_checked, 3, "control: all three quality levels were exercised");

    # rust-old/tests/integration.rs:617-645 -- Full and Minimal must DIFFER,
    # sum of |difference| over 512 samples > 0.001, because Minimal skips the
    # subglottal and interaction stages.
    var tf = svara_tract_new(SR);
    var tfe = svara_tract_set_vowel(tf, SVARA_VOWEL_A);
    assert_eq(tfe, SVARA_ERR_NONE, "control: full tract configured");
    svara_tract_set_quality(tf, SVARA_QUALITY_FULL);
    var tm = svara_tract_new(SR);
    var tme = svara_tract_set_vowel(tm, SVARA_VOWEL_A);
    assert_eq(tme, SVARA_ERR_NONE, "control: minimal tract configured");
    svara_tract_set_quality(tm, SVARA_QUALITY_MINIMAL);
    var g1 = svara_glottal_new(f64_from(120), SR);
    var g2 = svara_glottal_new(f64_from(120), SR);
    var bf = svara_tract_synthesize(tf, g1, 512);
    var bm = svara_tract_synthesize(tm, g2, 512);
    assert_eq(f64_gt(or_bufdiff(bf, bm, 512), TOL_1EM3), 1,
      "Full and Minimal produce different output -- the stages really are skipped");
    # CONTROL: two tracts at the SAME quality must agree, or the check above
    # would pass for any two independently-driven tracts.
    var tf2 = svara_tract_new(SR);
    var tf2e = svara_tract_set_vowel(tf2, SVARA_VOWEL_A);
    assert_eq(tf2e, SVARA_ERR_NONE, "control: second full tract configured");
    svara_tract_set_quality(tf2, SVARA_QUALITY_FULL);
    var g3 = svara_glottal_new(f64_from(120), SR);
    var tf3 = svara_tract_new(SR);
    var tf3e = svara_tract_set_vowel(tf3, SVARA_VOWEL_A);
    assert_eq(tf3e, SVARA_ERR_NONE, "control: third full tract configured");
    svara_tract_set_quality(tf3, SVARA_QUALITY_FULL);
    var g4 = svara_glottal_new(f64_from(120), SR);
    var b3 = svara_tract_synthesize(tf2, g3, 512);
    var b4 = svara_tract_synthesize(tf3, g4, 512);
    assert_eq(or_bufdiff(b3, b4, 512), 0, "control: two Full tracts agree exactly");

    # ================================================================
    test_group("GAP 2: jitter and shimmer make periods differ");
    # ================================================================
    # rust-old/tests/integration.rs:111-138 -- jitter 0.02, shimmer 0.04 over
    # 44100 samples; consecutive periods (44100/120 = 367 samples) must differ by
    # a summed |difference| > 0.001, and every sample must be finite.
    var gj = svara_glottal_new(f64_from(120), SR);
    svara_glottal_set_jitter(gj, 0.02);
    svara_glottal_set_shimmer(gj, 0.04);
    var jn = 44100;
    var jbuf = svara_alloc_samples(jn);
    assert_eq(jbuf != 0, 1, "control: the sample buffer allocated");
    var jfin = 1;
    var ji = 0;
    while (ji < jn) {
        var jv = svara_glottal_next_sample(gj);
        if (svara_is_finite(jv) == 0) { jfin = 0; }
        store64(jbuf + ji * 8, jv);
        ji = ji + 1;
    }
    assert_eq(jfin, 1, "44100 samples with jitter+shimmer are all finite");
    var period = 367;   # (44100 / 120) truncated, as the Rust computes it
    var pdiff = or_bufdiff(jbuf, jbuf + period * 8, period);
    assert_eq(f64_gt(pdiff, TOL_1EM3), 1,
      "consecutive periods DIFFER with jitter+shimmer on");
    # CONTROL: with both at zero the same comparison must find near-nothing, or
    # the assertion above would pass on any two chunks of a varying signal.
    var gz = svara_glottal_new(f64_from(120), SR);
    svara_glottal_set_jitter(gz, 0);
    svara_glottal_set_shimmer(gz, 0);
    var zbuf = svara_alloc_samples(period * 2);
    var zi = 0;
    while (zi < period * 2) { store64(zbuf + zi * 8, svara_glottal_next_sample(gz)); zi = zi + 1; }
    var zdiff = or_bufdiff(zbuf, zbuf + period * 8, period);
    assert_eq(f64_lt(zdiff, pdiff), 1,
      "control: with jitter+shimmer OFF the same periods differ far less");

    # ================================================================
    test_group("GAP 3: full breathiness stays finite");
    # ================================================================
    # rust-old/src/glottal.rs:609-615 -- set_breathiness(1.0), 1024 samples,
    # all finite. svara_glottal_set_breathiness was referenced in no suite.
    var gb = svara_glottal_new(f64_from(120), SR);
    svara_glottal_set_breathiness(gb, F64_ONE);
    assert_eq(or_approx(SvGlottalSource_breathiness(gb), F64_ONE, TOL_1EM6), 1,
      "control: breathiness really is 1.0");
    var bfin = 1;
    var bloud = 0;
    var bi = 0;
    while (bi < 1024) {
        var bv = svara_glottal_next_sample(gb);
        if (svara_is_finite(bv) == 0) { bfin = 0; }
        if (f64_gt(f64_abs(bv), TOL_1EM6) == 1) { bloud = 1; }
        bi = bi + 1;
    }
    assert_eq(bfin, 1, "1024 samples at full breathiness are all finite");
    assert_eq(bloud, 1, "control: and they are not silence");

    # ================================================================
    test_group("GAP 4: synthesized speech has energy at F1");
    # ================================================================
    # rust-old/tests/integration.rs:40-63 -- the one cross-module acoustic check.
    # A male /a/ should carry energy at F1 (768 Hz, Hillenbrand et al. 1995) that
    # is substantial relative to 200 Hz, well below F1.
    var speech = svara_phoneme_synthesize(SVARA_PH_VOWEL_A, voice, SR, F64_HALF);
    assert_eq(svara_is_err(speech), 0, "control: /a/ synthesizes");
    var sn = vec_len(speech);
    assert_eq(sn > 0, 1, "control: it produced samples");
    var e_f1 = or_goertzel(speech, sn, f64_from(768), SR);
    var e_low = or_goertzel(speech, sn, f64_from(200), SR);
    assert_eq(f64_gt(e_f1, 0), 1, "there is energy at F1 (768 Hz)");
    assert_eq(f64_gt(e_f1, f64_mul(e_low, 0.1)), 1,
      "F1 energy is substantial relative to 200 Hz");
    # CONTROL: the estimator discriminates -- silence must read as no energy.
    var quiet = vec_new();
    var qq = 0;
    while (qq < 1024) { vec_push(quiet, 0); qq = qq + 1; }
    assert_eq(or_goertzel(quiet, 1024, f64_from(768), SR), 0,
      "control: the Goertzel estimator reads 0 on silence");

    # ================================================================
    test_group("GAP 5: the seven bridge maps neither side tested");
    # ================================================================
    # Every expected value below is computed from the Rust formula by hand.

    # vibrato_depth_from_valence (rust-old/src/bridge.rs:44-48)
    #   clamp(0.03 + 0.03*clamp(v,-1,1), 0, 0.06)
    assert_eq(or_approx(svara_bridge_vibrato_depth_from_valence(0), 0.03, TOL_1EM6), 1,
      "valence 0 -> 0.03");
    assert_eq(or_approx(svara_bridge_vibrato_depth_from_valence(F64_ONE), 0.06, TOL_1EM6), 1,
      "valence +1 -> 0.06");
    assert_eq(or_approx(svara_bridge_vibrato_depth_from_valence(f64_neg(F64_ONE)), 0, TOL_1EM6), 1,
      "valence -1 -> 0.0");
    assert_eq(or_approx(svara_bridge_vibrato_depth_from_valence(f64_from(5)), 0.06, TOL_1EM6), 1,
      "valence clamps high");
    assert_eq(or_approx(svara_bridge_vibrato_depth_from_valence(f64_from(0 - 5)), 0, TOL_1EM6), 1,
      "valence clamps low");

    # intonation_from_emotion (rust-old/src/bridge.rs:86-95); None -> -1 here
    assert_eq(svara_bridge_intonation_from_emotion(0), SVARA_INTONATION_DECLARATIVE, "cat 0 -> declarative");
    assert_eq(svara_bridge_intonation_from_emotion(1), SVARA_INTONATION_EXCLAMATORY, "cat 1 -> exclamatory");
    assert_eq(svara_bridge_intonation_from_emotion(2), SVARA_INTONATION_DECLARATIVE, "cat 2 -> declarative");
    assert_eq(svara_bridge_intonation_from_emotion(3), SVARA_INTONATION_EXCLAMATORY,
      "cat 3 -> exclamatory (shares 1)");
    assert_eq(svara_bridge_intonation_from_emotion(4), SVARA_INTONATION_INTERROGATIVE, "cat 4 -> interrogative");
    assert_eq(svara_bridge_intonation_from_emotion(5), SVARA_INTONATION_CONTINUATION, "cat 5 -> continuation");
    assert_eq(svara_bridge_intonation_from_emotion(6), 0 - 1, "cat 6 -> none (Rust None)");
    assert_eq(svara_bridge_intonation_from_emotion(255), 0 - 1, "cat 255 -> none");

    # f0_range_scale_from_arousal (rust-old/src/bridge.rs:103-107): 0.6 + 1.2*a
    assert_eq(or_approx(svara_bridge_f0_range_scale_from_arousal(0), 0.6, TOL_1EM6), 1, "arousal 0 -> 0.6");
    assert_eq(or_approx(svara_bridge_f0_range_scale_from_arousal(F64_ONE), 1.8, TOL_1EM6), 1, "arousal 1 -> 1.8");
    assert_eq(or_approx(svara_bridge_f0_range_scale_from_arousal(F64_HALF), 1.2, TOL_1EM6), 1,
      "arousal 0.5 -> 1.2");
    assert_eq(or_approx(svara_bridge_f0_range_scale_from_arousal(f64_neg(F64_ONE)), 0.6, TOL_1EM6), 1,
      "arousal clamps low");

    # f0_peak_from_prominence (rust-old/src/bridge.rs:147-150): 1.0 + 0.3*p
    assert_eq(or_approx(svara_bridge_f0_peak_from_prominence(0), F64_ONE, TOL_1EM6), 1, "prominence 0 -> 1.0");
    assert_eq(or_approx(svara_bridge_f0_peak_from_prominence(F64_ONE), 1.3, TOL_1EM6), 1, "prominence 1 -> 1.3");
    assert_eq(or_approx(svara_bridge_f0_peak_from_prominence(F64_HALF), 1.15, TOL_1EM6), 1,
      "prominence 0.5 -> 1.15");

    # jitter_from_age (rust-old/src/bridge.rs:185-190): 0.005 + 0.035*|a-0.4|/0.6
    # U-shaped with its minimum at 0.4, so both ends must exceed the middle.
    assert_eq(or_approx(svara_bridge_jitter_from_age(0.4), 0.005, TOL_1EM6), 1, "age 0.4 -> 0.005 (the minimum)");
    assert_eq(or_approx(svara_bridge_jitter_from_age(0), 0.0283333333, TOL_1EM6), 1,
      "age 0 -> 0.005+0.035*0.4/0.6");
    assert_eq(or_approx(svara_bridge_jitter_from_age(F64_ONE), 0.04, TOL_1EM6), 1, "age 1 -> 0.04");
    assert_eq(or_approx(svara_bridge_jitter_from_age(0.7), 0.0225, TOL_1EM6), 1, "age 0.7 -> 0.0225");
    assert_eq(f64_gt(svara_bridge_jitter_from_age(0), svara_bridge_jitter_from_age(0.4)), 1,
      "control: the curve really is U-shaped (young > prime)");
    assert_eq(f64_gt(svara_bridge_jitter_from_age(F64_ONE), svara_bridge_jitter_from_age(0.4)), 1,
      "control: and old > prime");

    # spectral_tilt_from_distance (rust-old/src/bridge.rs:249-253): min(d*0.005, 6)
    assert_eq(or_approx(svara_bridge_spectral_tilt_from_distance(0), 0, TOL_1EM6), 1, "0 m -> 0");
    assert_eq(or_approx(svara_bridge_spectral_tilt_from_distance(f64_from(100)), F64_HALF, TOL_1EM6), 1,
      "100 m -> 0.5");
    assert_eq(or_approx(svara_bridge_spectral_tilt_from_distance(f64_from(1200)), f64_from(6), TOL_1EM6), 1,
      "1200 m -> 6.0 (exactly at the cap)");
    assert_eq(or_approx(svara_bridge_spectral_tilt_from_distance(f64_from(50000)), f64_from(6), TOL_1EM6), 1,
      "50 km -> capped at 6.0");

    # lombard_f0_shift (rust-old/src/bridge.rs:285-290): min(max(db-50,0)*0.75, 30)
    assert_eq(or_approx(svara_bridge_lombard_f0_shift(f64_from(50)), 0, TOL_1EM6), 1, "50 dB -> 0 (threshold)");
    assert_eq(or_approx(svara_bridge_lombard_f0_shift(f64_from(40)), 0, TOL_1EM6), 1, "40 dB -> 0 (below threshold)");
    assert_eq(or_approx(svara_bridge_lombard_f0_shift(f64_from(70)), f64_from(15), TOL_1EM6), 1,
      "70 dB -> 15 Hz");
    assert_eq(or_approx(svara_bridge_lombard_f0_shift(f64_from(90)), f64_from(30), TOL_1EM6), 1,
      "90 dB -> 30 Hz (exactly at the cap)");
    assert_eq(or_approx(svara_bridge_lombard_f0_shift(f64_from(1000)), f64_from(30), TOL_1EM6), 1,
      "1000 dB -> capped");
    or_sweep_365(voice);
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
