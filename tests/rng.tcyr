# rng.tcyr -- tests for src/rng.cyr (PCG32).
# rust-old/src/rng.rs had no #[test] blocks. Golden next_u32 values were
# generated from a faithful replica of the Rust algorithm (exact u64/u32
# integer math) -- these are the real parity oracle. next_f32/unsigned are
# exact in f64 (integer * power-of-two), so their golden bit patterns are
# asserted exactly too; determinism + range round out coverage.

include "src/error.cyr"
include "src/rng.cyr"

alloc_init();

# ================================================================
test_group("next_u32 golden sequence (seed 42)");
var r = svara_rng_new(SVARA_RNG_DEFAULT_SEED);
assert_eq(svara_rng_next_u32(r), 1085446021, "u32[0]");
assert_eq(svara_rng_next_u32(r), 176895750,  "u32[1]");
assert_eq(svara_rng_next_u32(r), 789123591,  "u32[2]");
assert_eq(svara_rng_next_u32(r), 1684778745, "u32[3]");
assert_eq(svara_rng_next_u32(r), 4229066268, "u32[4] (> 2^31, high-bit path)");
assert_eq(svara_rng_next_u32(r), 1793278615, "u32[5]");

# ================================================================
test_group("next_u32 golden sequence (seed 7)");
var r7 = svara_rng_new(7);
assert_eq(svara_rng_next_u32(r7), 4046551126, "seed7 u32[0]");
assert_eq(svara_rng_next_u32(r7), 168348581,  "seed7 u32[1]");
assert_eq(svara_rng_next_u32(r7), 489822171,  "seed7 u32[2]");

# ================================================================
test_group("determinism");
var a = svara_rng_new(SVARA_RNG_DEFAULT_SEED);
var b = svara_rng_new(SVARA_RNG_DEFAULT_SEED);
assert_eq(svara_rng_next_u32(a), svara_rng_next_u32(b), "same seed -> same u32[0]");
assert_eq(svara_rng_next_u32(a), svara_rng_next_u32(b), "same seed -> same u32[1]");
var c = svara_rng_new(99);
assert_neq(svara_rng_next_u32(c), svara_rng_next_u32(a), "different seed -> different stream");

# ================================================================
test_group("next_f32 exact + range (seed 42)");
var rf = svara_rng_new(SVARA_RNG_DEFAULT_SEED);
assert_eq(svara_rng_next_f32(rf), 0x3FD02CA5E1000000, "next_f32[0] == 0.2527250955 (exact f64)");
assert_eq(svara_rng_next_f32(rf), 0x3FA5166E0C000000, "next_f32[1] == 0.0411867513 (exact f64)");
# remaining draws must stay in [0.0, 1.0)
var i = 0;
var in_range = 1;
while (i < 256) {
    var v = svara_rng_next_f32(rf);
    if (f64_lt(v, 0) == 1) { in_range = 0; }
    if (f64_ge(v, F64_ONE) == 1) { in_range = 0; }
    i = i + 1;
}
assert_eq(in_range, 1, "256 next_f32 draws all in [0.0, 1.0)");

# ================================================================
test_group("next_f32_unsigned exact + range (seed 42)");
var ru = svara_rng_new(SVARA_RNG_DEFAULT_SEED);
assert_eq(svara_rng_next_f32_unsigned(ru), 0x3FD02CA5E1400000, "next_f32u[0] == 0.2527250957 (exact f64)");
var j = 0;
var u_in_range = 1;
while (j < 256) {
    var w = svara_rng_next_f32_unsigned(ru);
    if (f64_lt(w, 0) == 1) { u_in_range = 0; }
    if (f64_ge(w, F64_ONE) == 1) { u_in_range = 0; }
    j = j + 1;
}
assert_eq(u_in_range, 1, "256 next_f32_unsigned draws all in [0.0, 1.0)");

var rc = assert_summary();
syscall(60, rc);
