# allocbudget.tcyr -- pins the two properties the 3.1.3 allocation work relies on.
#
# 1. EQUIVALENCE. Each `_into` variant must produce bit-identical values to the
#    allocating function it replaced. These comparisons are exact (assert_eq on
#    raw f64 bit patterns), not tolerance-based, because the two paths run the
#    SAME arithmetic in the same order -- only the destination differs. They hold
#    on every architecture for that reason, unlike a stored golden digest.
#
# 2. BUDGET. Cyrius's bump allocator NEVER frees, so an allocation inside a
#    per-sample loop is not a performance nuisance, it is an unbounded leak:
#    before 3.1.3 the trajectory-planned render spent ~1.1 KB of arena per output
#    sample, so a minute of speech needed gigabytes that were never released.
#    The budget is measured as the MARGINAL cost of doubling the duration, which
#    cancels the fixed setup, and each assertion is paired with a control proving
#    the measurement is not reading zero.
#
# Include order: hisab -> goonj -> naad -> error -> rng -> smooth -> lod ->
# formant -> spectral -> glottal -> tract -> voice -> phoneme -> prosody ->
# trajectory -> sequence -> pool -> render.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"
include "src/error.cyr"
include "src/rng.cyr"
include "src/smooth.cyr"
include "src/lod.cyr"
include "src/formant.cyr"
include "src/spectral.cyr"
include "src/glottal.cyr"
include "src/tract.cyr"
include "src/voice.cyr"
include "src/phoneme.cyr"
include "src/prosody.cyr"
include "src/trajectory.cyr"
include "src/sequence.cyr"
include "src/pool.cyr"
include "src/render.cyr"

var SR = 0x40E5888000000000;   # 44100.0

# 1 iff two VowelTargets agree in all ten components, bit for bit.
#must_use
fn vt_same(a, b) {
    if (SvVowelTarget_f1(a) != SvVowelTarget_f1(b)) { return 0; }
    if (SvVowelTarget_f2(a) != SvVowelTarget_f2(b)) { return 0; }
    if (SvVowelTarget_f3(a) != SvVowelTarget_f3(b)) { return 0; }
    if (SvVowelTarget_f4(a) != SvVowelTarget_f4(b)) { return 0; }
    if (SvVowelTarget_f5(a) != SvVowelTarget_f5(b)) { return 0; }
    if (SvVowelTarget_b1(a) != SvVowelTarget_b1(b)) { return 0; }
    if (SvVowelTarget_b2(a) != SvVowelTarget_b2(b)) { return 0; }
    if (SvVowelTarget_b3(a) != SvVowelTarget_b3(b)) { return 0; }
    if (SvVowelTarget_b4(a) != SvVowelTarget_b4(b)) { return 0; }
    if (SvVowelTarget_b5(a) != SvVowelTarget_b5(b)) { return 0; }
    return 1;
}

# 1 iff two Formant vecs agree in all three components of all five slots.
#must_use
fn fv_same(a, b) {
    if (vec_len(a) != vec_len(b)) { return 0; }
    var i = 0;
    while (i < vec_len(a)) {
        var x = vec_get(a, i);
        var y = vec_get(b, i);
        if (SvFormant_frequency(x) != SvFormant_frequency(y)) { return 0; }
        if (SvFormant_bandwidth(x) != SvFormant_bandwidth(y)) { return 0; }
        if (SvFormant_amplitude(x) != SvFormant_amplitude(y)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# 1 iff two f64 sample vecs are bit-for-bit equal.
#must_use
fn samples_same(a, b) {
    if (vec_len(a) != vec_len(b)) { return 0; }
    var i = 0;
    while (i < vec_len(a)) {
        if (vec_get(a, i) != vec_get(b, i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Two-event sequence, `dur` seconds each, with lexical tones when toned == 1.
#must_use
fn mk_seq(dur, toned) {
    var s = svara_sequence_new();
    if (toned == 1) {
        svara_sequence_push(s, svara_phoneme_event_with_tone(SVARA_PH_VOWEL_A, dur,
            SVARA_STRESS_PRIMARY, SVARA_TONE_RISING));
        svara_sequence_push(s, svara_phoneme_event_with_tone(SVARA_PH_VOWEL_I, dur,
            SVARA_STRESS_SECONDARY, SVARA_TONE_FALLING));
    } else {
        svara_sequence_push(s, svara_phoneme_event_new(SVARA_PH_VOWEL_A, dur, SVARA_STRESS_PRIMARY));
        svara_sequence_push(s, svara_phoneme_event_new(SVARA_PH_VOWEL_I, dur, SVARA_STRESS_SECONDARY));
    }
    return s;
}

# marginal arena bytes per extra output sample, doubling the duration so the
# fixed per-render setup cancels.
#must_use
fn marginal_bytes(toned) {
    var voice = svara_voice_new_male();
    var s1 = mk_seq(f64_div(F64_ONE, f64_from(10)), toned);
    var s2 = mk_seq(f64_div(F64_ONE, f64_from(5)), toned);
    var a = alloc_used();
    var r1 = svara_sequence_render_planned(s1, voice, SR);
    var b = alloc_used();
    var r2 = svara_sequence_render_planned(s2, voice, SR);
    var c = alloc_used();
    return ((c - b) - (b - a)) / (vec_len(r2) - vec_len(r1));
}

# A flat contour of n evenly spaced points.
#must_use
fn flat_contour(n) {
    var pts = vec_new();
    var i = 0;
    while (i < n) {
        vec_push(pts, svara_pt_new(f64_div(f64_from(i), f64_from(n - 1)), F64_ONE));
        i = i + 1;
    }
    return svara_prosody_make(pts, F64_ONE, F64_ONE);
}

# Bytes 100 f0_at calls take, after one call sizes svara's own scratch pair.
#must_use
fn f0_at_bytes(contour) {
    var v = svara_prosody_f0_at(contour, F64_HALF);
    var a = alloc_used();
    var i = 0;
    while (i < 100) { v = svara_prosody_f0_at(contour, F64_HALF); i = i + 1; }
    return alloc_used() - a;
}

# 1 if bank slot i's four coefficients equal, bit for bit, what
# svara_formant_biquad_coeffs computes afresh for (freq, bw, sr).
#must_use
fn ab_slot_fresh(bank, i, freq, bw, sr, buf) {
    svara_formant_biquad_coeffs(freq, bw, sr, buf);
    var r = svara_formant_bank_slot(bank, i);
    if (load64(r + SV_FSLOT_B0) != load64(buf)) { return 0; }
    if (load64(r + SV_FSLOT_B2) != load64(buf + 8)) { return 0; }
    if (load64(r + SV_FSLOT_A1) != load64(buf + 16)) { return 0; }
    if (load64(r + SV_FSLOT_A2) != load64(buf + 24)) { return 0; }
    return 1;
}

# 1 if validate_target and validate over the five formants to_formants builds give
# the same code for `target` at `sr`.
#must_use
fn ab_same_verdict(target, sr) {
    var a = svara_formant_validate_target(target, sr);
    var b = svara_formant_validate(svara_vowel_target_to_formants(target), sr);
    if (a == b) { return 1; }
    return 0;
}

# svara_smooth_next as 3.8.1 wrote it, before the converged fast path: the
# reference the fast path is held to.
#must_use
fn ab_smooth_ref(sp) {
    var current = SvSmoothedParam_current(sp);
    var target = SvSmoothedParam_target(sp);
    if (f64_lt(f64_abs(f64_sub(current, target)), SVARA_SMOOTH_CONVERGED) == 1) {
        SvSmoothedParam_set_current(sp, target);
    } else {
        var alpha = SvSmoothedParam_alpha(sp);
        SvSmoothedParam_set_current(sp, f64_add(f64_mul(alpha, current), f64_mul(f64_sub(F64_ONE, alpha), target)));
    }
    return SvSmoothedParam_current(sp);
}

# Feed `count` copies of `x` to two banks and return how many outputs differ in
# their bits.
#must_use
fn ab_bank_pair(a, b, x, count) {
    var bad = 0;
    var k = 0;
    while (k < count) {
        if (svara_formant_bank_process(a, x) != svara_formant_bank_process(b, x)) { bad = bad + 1; }
        k = k + 1;
    }
    return bad;
}

# A sink for svara_sequence_render_into that keeps nothing.
fn ab_sink(user, samples, count) { return 0; }

# Bytes one pass over every phoneme class keeps, through context `ctx`: each
# class the context renders differently, nasalized vowels and diphthongs, both
# ejective releases, and silence, at 0.1 s each.
#must_use
fn ctx_pass_bytes(ctx, voice) {
    var nas = svara_nasalization_for_nasal(SVARA_PH_NASAL_N);
    var ps = vec_new();
    vec_push(ps, SVARA_PH_VOWEL_A); vec_push(ps, SVARA_PH_DIPH_AI); vec_push(ps, SVARA_PH_NASAL_M);
    vec_push(ps, SVARA_PH_LATERAL_L); vec_push(ps, SVARA_PH_APPROX_R); vec_push(ps, SVARA_PH_TRILL_ALVEOLAR);
    vec_push(ps, SVARA_PH_FRIC_S); vec_push(ps, SVARA_PH_FRIC_Z); vec_push(ps, SVARA_PH_FRIC_H);
    vec_push(ps, SVARA_PH_PLOSIVE_P); vec_push(ps, SVARA_PH_PLOSIVE_D); vec_push(ps, SVARA_PH_AFFR_CH);
    vec_push(ps, SVARA_PH_AFFR_J); vec_push(ps, SVARA_PH_CLICK_DENTAL); vec_push(ps, SVARA_PH_EJECTIVE_T);
    vec_push(ps, SVARA_PH_EJECTIVE_S); vec_push(ps, SVARA_PH_IMPLOSIVE_B); vec_push(ps, SVARA_PH_SILENCE);
    var a = alloc_used();
    var i = 0;
    var bad = 0;
    while (i < vec_len(ps)) {
        var n = svara_synthctx_synthesize(ctx, vec_get(ps, i), voice, 0.1, 0);
        if (n <= 0) { bad = bad + 1; }
        i = i + 1;
    }
    var nv = svara_synthctx_synthesize(ctx, SVARA_PH_VOWEL_A, voice, 0.1, nas);
    var nd = svara_synthctx_synthesize(ctx, SVARA_PH_DIPH_AI, voice, 0.1, nas);
    var used = alloc_used() - a;
    if ((nv <= 0) | (nd <= 0)) { bad = bad + 1; }
    if (bad > 0) { return 0 - 1; }
    return used;
}

# 3.8.2's svara_sequence_render, from the pieces it was made of: a voice clone per
# event, svara_phoneme_synthesize_nasalized's vecs, then svara_seq_crossfade.
#must_use
fn ref_sequence_render(seq, voice) {
    var events = SvPhonemeSequence_events(seq);
    var n = vec_len(events);
    var durs = svara_seq_durations(seq, svara_seq_detect_clusters(events));
    var nasals = svara_detect_nasalization(svara_seq_phoneme_list(seq));
    var segments = vec_new();
    var i = 0;
    while (i < n) {
        var e = vec_get(events, i);
        var ev = svara_seq_voice_clone(voice);
        SvVoiceProfile_set_base_f0(ev, svara_seq_stress_f0(SvVoiceProfile_base_f0(ev), SvPhonemeEvent_stress(e)));
        vec_push(segments, svara_phoneme_synthesize_nasalized(SvPhonemeEvent_phoneme(e), ev, SR, vec_get(durs, i),
            vec_get(nasals, i)));
        i = i + 1;
    }
    var cfs = vec_new();
    var min_cf = svara_seq_min_crossfade(seq, SR);
    i = 0;
    while (i < n - 1) {
        vec_push(cfs, svara_seq_crossfade_len(events, i, vec_len(vec_get(segments, i)),
            vec_len(vec_get(segments, i + 1)), min_cf));
        i = i + 1;
    }
    return svara_seq_crossfade(segments, cfs);
}

# 3.8.2's batch render loop on a fresh context: a voice clone per event, its own
# stress table, and every sample pushed onto a vec from empty.
#must_use
fn ref_batch(voice, events) {
    var ctx = svara_synthctx_new(voice, SR);
    var pl = vec_new();
    var i = 0;
    while (i < vec_len(events)) { vec_push(pl, SvPhonemeEvent_phoneme(vec_get(events, i))); i = i + 1; }
    var nasals = svara_detect_nasalization(pl);
    var out = vec_new();
    i = 0;
    while (i < vec_len(events)) {
        var e = vec_get(events, i);
        var ev = svara_seq_voice_clone(voice);
        var ss = 0.9;
        var st = SvPhonemeEvent_stress(e);
        if (st == SVARA_STRESS_PRIMARY) {
            SvVoiceProfile_set_base_f0(ev, f64_mul(SvVoiceProfile_base_f0(ev), 1.10));
            ss = 1.15;
        } elif (st == SVARA_STRESS_SECONDARY) {
            SvVoiceProfile_set_base_f0(ev, f64_mul(SvVoiceProfile_base_f0(ev), 1.05));
            ss = 1.05;
        }
        var n = svara_synthctx_synthesize(ctx, SvPhonemeEvent_phoneme(e), ev, f64_mul(SvPhonemeEvent_duration(e), ss),
          vec_get(nasals, i));
        var buf = svara_synthctx_buffer(ctx);
        var j = 0;
        while (j < n) { vec_push(out, load64(buf + j * 8)); j = j + 1; }
        i = i + 1;
    }
    return out;
}

# 3.8.2's pool batch on a fresh context: every sample pushed onto a vec from empty.
#must_use
fn ref_pool(voice, phs, durs) {
    var ctx = svara_synthctx_new(voice, SR);
    var out = vec_new();
    var i = 0;
    while (i < vec_len(phs)) {
        var n = svara_synthctx_synthesize(ctx, vec_get(phs, i), voice, vec_get(durs, i), 0);
        var buf = svara_synthctx_buffer(ctx);
        var j = 0;
        while (j < n) { vec_push(out, load64(buf + j * 8)); j = j + 1; }
        i = i + 1;
    }
    return out;
}

# A sequence that reaches every branch of the crossfade: stress, a nasal ahead of a
# vowel, a consonant cluster, a plosive, silence, a diphthong, segments shorter than
# their fades and one of no samples at all.
#must_use
fn mixed_seq() {
    var s = svara_sequence_new();
    svara_sequence_push(s, svara_phoneme_event_new(SVARA_PH_VOWEL_A, 0.1, SVARA_STRESS_PRIMARY));
    svara_sequence_push(s, svara_phoneme_event_new(SVARA_PH_NASAL_N, 0.06, SVARA_STRESS_UNSTRESSED));
    svara_sequence_push(s, svara_phoneme_event_new(SVARA_PH_FRIC_S, 0.08, SVARA_STRESS_UNSTRESSED));
    svara_sequence_push(s, svara_phoneme_event_new(SVARA_PH_PLOSIVE_T, 0.05, SVARA_STRESS_UNSTRESSED));
    svara_sequence_push(s, svara_phoneme_event_new(SVARA_PH_VOWEL_I, 0.1, SVARA_STRESS_SECONDARY));
    svara_sequence_push(s, svara_phoneme_event_new(SVARA_PH_NASAL_M, 0.0005, SVARA_STRESS_UNSTRESSED));
    svara_sequence_push(s, svara_phoneme_event_new(SVARA_PH_VOWEL_E, 0.00001, SVARA_STRESS_UNSTRESSED));
    svara_sequence_push(s, svara_phoneme_event_new(SVARA_PH_SILENCE, 0.05, SVARA_STRESS_UNSTRESSED));
    svara_sequence_push(s, svara_phoneme_event_new(SVARA_PH_DIPH_AI, 0.12, SVARA_STRESS_PRIMARY));
    return s;
}

# Arena bytes a call to svara_vec_adopt keeps, for n samples in `bytes` of room.
#must_use
fn adopt_bytes(n, bytes) {
    var b = alloc(bytes);
    var i = 0;
    while (i < n) { store64(b + i * 8, i * 3 + 1); i = i + 1; }
    var a = alloc_used();
    var v = svara_vec_adopt(b, n, bytes);
    var used = alloc_used() - a;
    if (vec_len(v) != n) { return 0 - 1; }
    i = 0;
    while (i < n) {
        if (vec_get(v, i) != i * 3 + 1) { return 0 - 1; }
        i = i + 1;
    }
    return used;
}

# Test entry point — runs this file's suite and returns the assert summary.
fn main() {
    alloc_init();
    var voice = svara_voice_new_male();

    # ================================================================
    test_group("interpolate_into matches interpolate exactly");
    # ================================================================
    var va = svara_vowel_target_from_vowel(SVARA_VOWEL_A);
    var vi = svara_vowel_target_from_vowel(SVARA_VOWEL_I);
    var third = f64_div(F64_ONE, f64_from(3));
    var scratch = svara_vowel_target_new(0, 0, 0, 0, 0);
    svara_vowel_target_interpolate_into(va, vi, third, scratch);
    assert_eq(vt_same(scratch, svara_vowel_target_interpolate(va, vi, third)), 1, "t = 1/3");
    svara_vowel_target_interpolate_into(va, vi, 0, scratch);
    assert_eq(vt_same(scratch, svara_vowel_target_interpolate(va, vi, 0)), 1, "t = 0");
    svara_vowel_target_interpolate_into(va, vi, F64_ONE, scratch);
    assert_eq(vt_same(scratch, svara_vowel_target_interpolate(va, vi, F64_ONE)), 1, "t = 1");
    # CONTROL: vt_same is not a tautology -- two different targets must differ.
    assert_eq(vt_same(va, vi), 0, "control: /a/ and /i/ are not the same target");

    # ================================================================
    test_group("copy_into and to_formants_into match their originals");
    # ================================================================
    svara_vowel_target_copy_into(vi, scratch);
    assert_eq(vt_same(scratch, vi), 1, "copy_into reproduces the source");
    var fscratch = svara_formant_scratch_vec();
    assert_eq(vec_len(fscratch), 5, "scratch vec holds five slots");
    svara_vowel_target_to_formants_into(va, fscratch);
    assert_eq(fv_same(fscratch, svara_vowel_target_to_formants(va)), 1, "to_formants_into matches /a/");
    svara_vowel_target_to_formants_into(vi, fscratch);
    assert_eq(fv_same(fscratch, svara_vowel_target_to_formants(vi)), 1, "to_formants_into matches /i/");
    # CONTROL: fv_same distinguishes different vowels.
    assert_eq(fv_same(svara_vowel_target_to_formants(va), svara_vowel_target_to_formants(vi)), 0,
      "control: /a/ and /i/ formants differ");

    # ================================================================
    test_group("catmull_rom_into and formants_at_into match their originals");
    # ================================================================
    var pl = vec_new();
    vec_push(pl, SVARA_PH_VOWEL_A);
    vec_push(pl, SVARA_PH_VOWEL_I);
    vec_push(pl, SVARA_PH_VOWEL_U);
    var durs = vec_new();
    var dd = f64_div(F64_ONE, f64_from(10));
    vec_push(durs, dd); vec_push(durs, dd); vec_push(durs, dd);
    var plan = svara_trajectory_plan(pl, durs, voice, SR);

    var vu = svara_vowel_target_from_vowel(SVARA_VOWEL_U);
    var vo = svara_vowel_target_from_vowel(SVARA_VOWEL_O);
    svara_catmull_rom_vowel_into(va, vi, vu, vo, third, scratch);
    assert_eq(vt_same(scratch, svara_catmull_rom_vowel(va, vi, vu, vo, third)), 1, "catmull_rom_into matches");

    # Sweep the whole plan so every branch of formants_at is exercised: the
    # early/late linear-ease arms and the interior Catmull-Rom arm.
    var mismatches = 0;
    var compared = 0;
    var si = 0;
    while (si < 13000) {
        svara_trajectory_formants_at_into(plan, si, scratch);
        if (vt_same(scratch, svara_trajectory_formants_at(plan, si)) == 0) { mismatches = mismatches + 1; }
        compared = compared + 1;
        si = si + 251;
    }
    assert_eq(mismatches, 0, "formants_at_into matches formants_at across the plan");
    # CONTROL: the sweep actually ran, so `mismatches == 0` is not vacuous.
    assert_eq(compared, 52, "control: 52 positions were compared");
    # CONTROL: the sweep saw genuinely different targets, not one repeated value.
    var first = svara_trajectory_formants_at(plan, 0);
    var last = svara_trajectory_formants_at(plan, 12000);
    assert_eq(vt_same(first, last), 0, "control: the trajectory actually moves");

    # ================================================================
    test_group("filter rebuild reproduces a freshly built filter");
    # ================================================================
    # svara_formant_filter_rebuild must leave the filter in exactly the state
    # svara_formant_filter_new would have produced -- Rust's set_formants assigns
    # a brand-new FormantFilter, discarding the delay lines. Compared at the
    # FILTER level, which is what changed; the surrounding tract state
    # (lip_prev, interaction feedback, the two naad biquads, the smoothed
    # params) is deliberately NOT reset by set_formants in Rust either.
    var fa = svara_vowel_target_to_formants(va);
    var fi = svara_vowel_target_to_formants(vi);
    var warm = svara_formant_filter_new(fa, SR);
    assert_eq(svara_is_err(warm), 0, "control: filter constructs");
    var wi = 0;
    while (wi < 500) {
        var junk = svara_formant_filter_process_sample(warm, svara_rng_next_f32(svara_rng_new(wi + 1)));
        wi = wi + 1;
    }
    assert_eq(svara_formant_filter_rebuild(warm, fi), SVARA_ERR_NONE, "rebuild on a warm filter succeeds");
    var fresh = svara_formant_filter_new(fi, SR);
    assert_eq(svara_is_err(fresh), 0, "control: fresh filter constructs");

    var diffs = 0;
    var loud = 0;
    var ci = 0;
    while (ci < 256) {
        var drive = svara_traj_cr(0, F64_ONE, 0, f64_neg(F64_ONE), f64_div(f64_from(ci), f64_from(256)));
        var sw = svara_formant_filter_process_sample(warm, drive);
        var sf = svara_formant_filter_process_sample(fresh, drive);
        if (sw != sf) { diffs = diffs + 1; }
        if (f64_gt(f64_abs(sf), SV_EPSILON) == 1) { loud = loud + 1; }
        ci = ci + 1;
    }
    assert_eq(diffs, 0, "rebuilt filter is bit-identical to a fresh one (state discarded)");
    # CONTROL: the comparison sees real signal, not two silent buffers.
    assert_eq(loud > 0, 1, "control: the filter emits non-silence");
    assert_eq(svara_formant_filter_num_formants(warm), 5, "rebuild sets the active count");

    # A rejected rebuild must leave the filter untouched, as Rust's `?` does.
    var bad = vec_new();
    vec_push(bad, svara_formant_new(f64_neg(f64_from(100)), f64_from(50), F64_ONE));
    assert_eq(svara_formant_filter_rebuild(fresh, bad), SVARA_ERR_INVALID_FORMANT, "invalid formants rejected");
    assert_eq(svara_formant_filter_num_formants(fresh), 5, "a rejected rebuild does not change the count");
    var after = svara_formant_filter_process_sample(fresh, F64_ONE);
    assert_eq(svara_is_finite(after), 1, "filter still usable after a rejected rebuild");

    # And the tract wrapper still reports errors the same way.
    var tk = svara_tract_new(SR);
    assert_eq(svara_is_err(tk), 0, "control: tract constructs");
    assert_eq(svara_tract_set_formants(tk, bad), SVARA_ERR_INVALID_FORMANT, "tract rejects invalid formants");
    assert_eq(svara_is_finite(svara_tract_process_sample(tk, F64_ONE)), 1, "tract usable after rejection");

    # ================================================================
    test_group("render_planned allocates per sample only for its output");
    # ================================================================
    # 3.1.2 measured 1121 (untoned) and 1505 (toned) bytes per sample here, and
    # 3.8.2 35, the output buffer plus the vec it was copied into. Since 3.8.3 the
    # buffer is the vec (svara_vec_adopt), and 13 remain: the buffer's room, rounded
    # up to a vec's capacity. The per-sample synthesis itself allocates nothing.
    var untoned = marginal_bytes(0);
    assert_eq(untoned > 0, 1, "control: the budget measurement reads a real number");
    assert_eq(untoned < 20, 1, "untoned render stays under 20 bytes per sample");
    var toned = marginal_bytes(1);
    assert_eq(toned > 0, 1, "control: the toned budget reads a real number");
    # hisab 3.4.1 holds calc_monotone_cubic_checked's scratch on its stack up to 16
    # points, so a tone costs nothing per sample. 3.6.0 measured 115 here against 35.
    # Within one byte: both are whole-byte averages over the same samples, so a few
    # hundred bytes in total can land them either side of an integer.
    assert_eq(toned - untoned <= 1, 1, "a toned render allocates within a byte per sample of an untoned one");
    assert_eq(untoned - toned <= 1, 1, "control: and not less");

    # ================================================================
    test_group("f0_at allocates nothing up to hisab's 16 points");
    # ================================================================
    assert_eq(f0_at_bytes(svara_tone_to_contour(SVARA_TONE_DIPPING)), 0, "a tone contour allocates nothing");
    assert_eq(f0_at_bytes(flat_contour(16)), 0, "16 points allocate nothing");
    assert_eq(f0_at_bytes(flat_contour(17)) > 0, 1, "control: 17 points allocate, so the measure can see it");

    # ================================================================
    test_group("render output is unchanged by the reuse");
    # ================================================================
    # Same sequence, same seed-free deterministic path, rendered twice.
    var sq = mk_seq(f64_div(F64_ONE, f64_from(10)), 0);
    var o1 = svara_sequence_render_planned(sq, voice, SR);
    var o2 = svara_sequence_render_planned(sq, voice, SR);
    assert_eq(samples_same(o1, o2), 1, "render_planned is deterministic across calls");
    assert_eq(vec_len(o1) > 0, 1, "control: the render produced samples");
    var sqt = mk_seq(f64_div(F64_ONE, f64_from(10)), 1);
    var t1 = svara_sequence_render_planned(sqt, voice, SR);
    var t2 = svara_sequence_render_planned(sqt, voice, SR);
    assert_eq(samples_same(t1, t2), 1, "toned render_planned is deterministic across calls");
    assert_eq(samples_same(o1, t1), 0, "control: the toned render differs from the untoned one");
    # ================================================================
    test_group("spectral queries allocate nothing per call");
    # ================================================================
    # Each used to take fresh scratch: rms_level 8 KB a call on 1024 samples.
    var frame = svara_phoneme_synthesize(SVARA_PH_VOWEL_A, voice, SR, f64_div(f64_from(1024), SR));
    var spec = svara_spectral_analyze(frame, SR);
    var w = svara_spectral_rms_level(frame);
    w = svara_spectrum_total_energy(spec);
    w = svara_spectrum_band_energy(spec, f64_from(100), f64_from(4000));
    var wf = svara_spectrum_estimate_formants(spec, 5);
    var before = alloc_used();
    var q = 0;
    while (q < 50) {
        w = svara_spectral_rms_level(frame);
        w = svara_spectrum_total_energy(spec);
        w = svara_spectrum_band_energy(spec, f64_from(100), f64_from(4000));
        q = q + 1;
    }
    assert_eq(alloc_used() - before, 0, "rms_level, total_energy and band_energy allocate nothing");
    var fb = alloc_used();
    wf = svara_spectrum_estimate_formants(spec, 5);
    assert_eq(alloc_used() - fb < 256, 1, "estimate_formants allocates only its result");
    var ab = alloc_used();
    var spec2 = svara_spectral_analyze(frame, SR);
    assert_eq(alloc_used() - ab < 32688, 1, "analyze allocates less than its old 32,688 bytes");
    assert_eq(svara_is_err(spec2), 0, "control: the second analyze succeeds");

    # ================================================================
    test_group("a warmed synthesis context allocates nothing per phoneme");
    # ================================================================
    # Filed by hoosh against 3.6.3: a server renders on every request and the bump
    # allocator never frees, and a warmed context kept 160 to 1,048 bytes a
    # phoneme -- its targets, and a new filter per fricative and burst. 3.6.5 keeps
    # them in the context and re-initializes the filters in place.
    var wctx = svara_synthctx_new(voice, SR);
    var warm_bytes = ctx_pass_bytes(wctx, voice);
    assert_eq(warm_bytes > 0, 1, "control: the first pass builds the context's filters, so the measure can see it");
    assert_eq(ctx_pass_bytes(wctx, voice), 0, "a second pass over every class keeps no bytes");
    assert_eq(ctx_pass_bytes(wctx, voice), 0, "and a third");

    # ================================================================
    test_group("3.8.1's shortcuts give what the long way gives");
    # ================================================================
    # The trig memo: a slot fed repeats, changes of one key at a time, a sample
    # rate change with frequency and bandwidth held, and a revisit, must hold
    # exactly the coefficients a fresh computation gives each time.
    var mf = vec_new();
    vec_push(mf, svara_formant_new(f64_from(700), f64_from(90), F64_ONE));
    var mfilt = svara_formant_filter_new(mf, SR);
    var mbank = SvFormantFilter_bank(mfilt);
    var mbuf = alloc(32);
    var mbad = 0;
    var steps = alloc(8 * 24);
    store64(steps, f64_from(700)); store64(steps + 8, f64_from(90)); store64(steps + 16, SR);
    store64(steps + 24, f64_from(700)); store64(steps + 32, f64_from(90)); store64(steps + 40, SR);
    store64(steps + 48, f64_from(710)); store64(steps + 56, f64_from(90)); store64(steps + 64, SR);
    store64(steps + 72, f64_from(710)); store64(steps + 80, f64_from(95)); store64(steps + 88, SR);
    store64(steps + 96, f64_from(710)); store64(steps + 104, f64_from(95)); store64(steps + 112, f64_from(48000));
    store64(steps + 120, f64_from(700)); store64(steps + 128, f64_from(90)); store64(steps + 136, SR);
    store64(steps + 144, f64_from(700)); store64(steps + 152, f64_from(95)); store64(steps + 160, SR);
    store64(steps + 168, f64_from(710)); store64(steps + 176, f64_from(90)); store64(steps + 184, f64_from(48000));
    var ms = 0;
    while (ms < 8) {
        var fq = load64(steps + ms * 24);
        var bw = load64(steps + ms * 24 + 8);
        var rate = load64(steps + ms * 24 + 16);
        var ue = svara_formant_bank_update(mbank, 3, fq, bw, F64_ONE, rate);
        mbad = mbad + 1 - ab_slot_fresh(mbank, 3, fq, bw, rate, mbuf);
        ms = ms + 1;
    }
    assert_eq(mbad, 0, "the memo's coefficients equal fresh ones across eight changes of key");
    # The record written in place: validate_target refuses exactly what validate
    # refuses over the five formants built from the target.
    var vbad = 0;
    var hostile = alloc(8 * 9);
    store64(hostile, f64_div(0, 0)); store64(hostile + 8, 0x7FF0000000000000); store64(hostile + 16, 0);
    store64(hostile + 24, f64_from(0 - 5)); store64(hostile + 32, f64_from(22050));
    store64(hostile + 40, f64_from(30000)); store64(hostile + 48, f64_from(10000000));
    store64(hostile + 56, 0x7FEFFFFFFFFFFFFF); store64(hostile + 64, f64_from(500));
    var comp = 0;
    while (comp < 10) {
        var hv = 0;
        while (hv < 9) {
            var vt = svara_vowel_target_from_vowel(SVARA_VOWEL_A);
            var val = load64(hostile + hv * 8);
            if (comp == 0) { SvVowelTarget_set_f1(vt, val); }
            if (comp == 1) { SvVowelTarget_set_f2(vt, val); }
            if (comp == 2) { SvVowelTarget_set_f3(vt, val); }
            if (comp == 3) { SvVowelTarget_set_f4(vt, val); }
            if (comp == 4) { SvVowelTarget_set_f5(vt, val); }
            if (comp == 5) { SvVowelTarget_set_b1(vt, val); }
            if (comp == 6) { SvVowelTarget_set_b2(vt, val); }
            if (comp == 7) { SvVowelTarget_set_b3(vt, val); }
            if (comp == 8) { SvVowelTarget_set_b4(vt, val); }
            if (comp == 9) { SvVowelTarget_set_b5(vt, val); }
            vbad = vbad + 1 - ab_same_verdict(vt, SR);
            hv = hv + 1;
        }
        comp = comp + 1;
    }
    var vt_ok = svara_vowel_target_from_vowel(SVARA_VOWEL_I);
    vbad = vbad + 1 - ab_same_verdict(vt_ok, f64_from(0 - 1));
    vbad = vbad + 1 - ab_same_verdict(vt_ok, f64_div(0, 0));
    vbad = vbad + 1 - ab_same_verdict(vt_ok, f64_from(8000));
    assert_eq(vbad, 0, "validate_target and validate agree on 93 hostile targets and rates");
    assert_eq(svara_formant_validate_target(vt_ok, SR), SVARA_ERR_NONE, "control: a real vowel passes");
    # A rejected target leaves the record alone on the in-place path too.
    var rt = svara_tract_new(SR);
    var rok = svara_tract_set_vowel(rt, SVARA_VOWEL_I);
    var rec_f1 = SvFormant_frequency(vec_get(SvVocalTract_formants(rt), 0));
    var bad_t = svara_vowel_target_from_vowel(SVARA_VOWEL_A);
    SvVowelTarget_set_b3(bad_t, f64_div(0, 0));
    assert_eq(svara_tract_set_formants_from_target(rt, bad_t), SVARA_ERR_INVALID_FORMANT, "a NaN B3 is refused");
    assert_eq(SvFormant_frequency(vec_get(SvVocalTract_formants(rt), 0)), rec_f1, "and the record keeps /i/'s F1");
    # The contour read from filled buffers: f0_at_filled matches f0_at.
    var fbad = 0;
    var fx = alloc(64 * 8);
    var fy = alloc(64 * 8);
    var tone = 0;
    while (tone < 9) {
        var ct = svara_tone_to_contour(tone);
        var cp = SvProsodyContour_f0_points(ct);
        var fill = svara_prosody_fill(cp, vec_len(cp), fx, fy);
        var tq = 0 - 4;
        while (tq < 25) {
            var tt = f64_div(f64_from(tq), f64_from(20));
            if (svara_prosody_f0_at_filled(fx, fy, vec_len(cp), tt) != svara_prosody_f0_at(ct, tt)) { fbad = fbad + 1; }
            tq = tq + 1;
        }
        if (svara_prosody_f0_at_filled(fx, fy, vec_len(cp), f64_div(0, 0)) != svara_prosody_f0_at(ct, f64_div(0, 0))) {
            fbad = fbad + 1;
        }
        tone = tone + 1;
    }
    var one_pt = vec_new();
    vec_push(one_pt, svara_pt_new(F64_HALF, 1.3));
    var c1 = svara_prosody_make(one_pt, F64_ONE, F64_ONE);
    var fill1 = svara_prosody_fill(SvProsodyContour_f0_points(c1), 1, fx, fy);
    if (svara_prosody_f0_at_filled(fx, fy, 1, 0.7) != svara_prosody_f0_at(c1, 0.7)) { fbad = fbad + 1; }
    var c0 = svara_prosody_make(vec_new(), F64_ONE, F64_ONE);
    if (svara_prosody_f0_at_filled(fx, fy, 0, 0.7) != svara_prosody_f0_at(c0, 0.7)) { fbad = fbad + 1; }
    assert_eq(fbad, 0, "f0_at_filled matches f0_at: nine tones, 1 and 0 points, t outside [0, 1], NaN t");
    # The notch: a retune to the recorded place changes nothing, another place retunes.
    var nt = svara_tract_new(SR);
    var notch = SvVocalTract_nasal_antiformant(nt);
    var nb0 = BiquadFilter_b0(notch);
    svara_tract_set_nasal_place(nt, SVARA_NASAL_NEUTRAL);
    assert_eq(BiquadFilter_b0(notch), nb0, "a retune to the recorded place keeps the coefficients");
    svara_tract_set_nasal_place(nt, SVARA_NASAL_VELAR);
    assert_eq(BiquadFilter_b0(notch) != nb0, 1, "control: another place retunes");
    assert_eq(svara_tract_nasal_place(nt), SVARA_NASAL_VELAR, "and is recorded");
    var nb0v = BiquadFilter_b0(notch);
    svara_tract_set_nasal_place(nt, SVARA_NASAL_NEUTRAL);
    var new_t = svara_tract_new(SR);
    assert_eq(BiquadFilter_b0(notch), nb0, "back to neutral, the coefficients a new tract has");
    assert_eq(BiquadFilter_a1(notch), BiquadFilter_a1(SvVocalTract_nasal_antiformant(new_t)), "a1 too");

    # ================================================================
    test_group("3.8.2's shortcuts give what the long way gives");
    # ================================================================
    # The bank's unused-slot skip, against a bank made to run all eight slots,
    # as every bank did through 3.8.1. Finite input, then +inf, which runs NaN
    # into the unused slots' delay lines for good, a reset, NaN, -inf, a
    # coefficient set past `count`, and a rebuild.
    var bv = svara_vowel_target_to_formants(svara_vowel_target_from_vowel(SVARA_VOWEL_A));
    var filt_a = svara_formant_filter_new(bv, SR);
    var filt_b = svara_formant_filter_new(bv, SR);
    var ba = SvFormantFilter_bank(filt_a);
    var bb = SvFormantFilter_bank(filt_b);
    SvFormantBank_set_out_coef(bb, 1);
    var pinf = 0x7FF0000000000000;
    var bbad = ab_bank_pair(ba, bb, F64_HALF, 200);
    bbad = bbad + ab_bank_pair(ba, bb, pinf, 1);
    bbad = bbad + ab_bank_pair(ba, bb, F64_HALF, 50);
    assert_eq(svara_is_finite(svara_formant_bank_process(ba, F64_HALF)), 0,
      "control: after +inf the bank stays NaN, as Rust's does");
    var dump = svara_formant_bank_process(bb, F64_HALF);
    svara_formant_bank_reset(ba);
    svara_formant_bank_reset(bb);
    bbad = bbad + ab_bank_pair(ba, bb, F64_HALF, 100);
    bbad = bbad + ab_bank_pair(ba, bb, f64_div(0, 0), 1);
    bbad = bbad + ab_bank_pair(ba, bb, F64_HALF, 20);
    svara_formant_bank_reset(ba);
    svara_formant_bank_reset(bb);
    bbad = bbad + ab_bank_pair(ba, bb, 0xFFF0000000000000, 1);
    bbad = bbad + ab_bank_pair(ba, bb, f64_from(0 - 3), 20);
    svara_formant_bank_reset(ba);
    svara_formant_bank_reset(bb);
    var ua = svara_formant_bank_update(ba, 6, f64_from(4100), f64_from(200), F64_HALF, SR);
    var ub = svara_formant_bank_update(bb, 6, f64_from(4100), f64_from(200), F64_HALF, SR);
    bbad = bbad + ab_bank_pair(ba, bb, F64_HALF, 100);
    var ra = svara_formant_filter_rebuild(filt_a, bv);
    var rb = svara_formant_filter_rebuild(filt_b, bv);
    SvFormantBank_set_out_coef(bb, 1);
    bbad = bbad + ab_bank_pair(ba, bb, F64_HALF, 100);
    assert_eq(bbad, 0, "the skip matches all eight slots through inf, NaN, -inf, resets and a slot past count");
    assert_eq(SvFormantBank_out_coef(ba) | SvFormantBank_out_dirty(ba), 0, "control: a rebuild clears both flags");
    # The quality flags, against lod.cyr's predicates, after set_quality and restore.
    var qbad = 0;
    var qv = SVARA_QUALITY_FULL;
    while (qv <= SVARA_QUALITY_MINIMAL) {
        var qt = svara_tract_new(SR);
        svara_tract_set_quality(qt, qv);
        var qr = svara_tract_restore(svara_tract_save(qt));
        var rep = 0;
        while (rep < 2) {
            var tq = qt;
            if (rep == 1) { tq = qr; }
            var f = SvVocalTract_qflags(tq);
            if (((f & SV_T_Q_INTERACTION) != 0) != (svara_quality_use_interaction(qv) == 1)) { qbad = qbad + 1; }
            if (((f & SV_T_Q_NASAL) != 0) != (svara_quality_use_nasal_coupling(qv) == 1)) { qbad = qbad + 1; }
            if (((f & SV_T_Q_SUBGLOTTAL) != 0) != (svara_quality_use_subglottal(qv) == 1)) { qbad = qbad + 1; }
            if (((f & SV_T_Q_LIP) != 0) != (svara_quality_use_lip_radiation(qv) == 1)) { qbad = qbad + 1; }
            rep = rep + 1;
        }
        qv = qv + 1;
    }
    assert_eq(qbad, 0, "the tract's quality flags are the predicates' answers, set and restored");
    # The smoother's converged fast path, against 3.8.1's code: converging, held,
    # retargeted, +0 and -0, inf with a zero-time smoother, and NaN.
    var sbad = 0;
    var sa = svara_smooth_new(0, SR);
    var sb = svara_smooth_new(0, SR);
    var targets = alloc(8 * 7);
    store64(targets, F64_ONE); store64(targets + 8, F64_ONE); store64(targets + 16, 0x8000000000000000);
    store64(targets + 24, 0); store64(targets + 32, 0x3FD3333333333333); store64(targets + 40, f64_div(0, 0));
    store64(targets + 48, F64_HALF);
    var st0 = 0;
    while (st0 < 7) {
        svara_smooth_set_target(sa, load64(targets + st0 * 8));
        svara_smooth_set_target(sb, load64(targets + st0 * 8));
        var sk = 0;
        while (sk < 3000) {
            if (svara_smooth_next(sa) != ab_smooth_ref(sb)) { sbad = sbad + 1; }
            sk = sk + 1;
        }
        st0 = st0 + 1;
    }
    var za = svara_smooth_with_time(pinf, 0, SR);
    var zb = svara_smooth_with_time(pinf, 0, SR);
    var zk = 0;
    while (zk < 5) {
        if (svara_smooth_next(za) != ab_smooth_ref(zb)) { sbad = sbad + 1; }
        zk = zk + 1;
    }
    assert_eq(sbad, 0, "smooth_next matches 3.8.1's over 21,000 steps and a zero-time smoother at inf");
    assert_eq(svara_is_finite(ab_smooth_ref(svara_smooth_with_time(pinf, 0, SR))), 0,
      "control: a zero-time smoother at inf goes to NaN, which the fast path must not skip");

    # ================================================================
    test_group("a warmed context streams a sequence with no allocation");
    # ================================================================
    # svara_sequence_render keeps about 127 bytes per output sample (hoosh's
    # filing). svara_sequence_render_into renders on the caller's context and
    # computes its plan per event, so once the context has streamed a sequence as
    # long, it keeps nothing.
    var st_sq = mk_seq(f64_div(F64_ONE, f64_from(10)), 0);
    var sctx = svara_synthctx_new(voice, SR);
    var s0 = alloc_used();
    var n1 = svara_sequence_render_into(st_sq, voice, sctx, &ab_sink, 0);
    var s1 = alloc_used();
    assert_eq(n1 > 0, 1, "control: the stream rendered");
    assert_eq(s1 - s0 > 0, 1, "control: the first stream builds the context's buffers, so the measure can see it");
    var n2 = svara_sequence_render_into(st_sq, voice, sctx, &ab_sink, 0);
    assert_eq(alloc_used() - s1, 0, "a second stream keeps no bytes");
    assert_eq(n2, n1, "control: and streamed as many samples");
    var r0 = alloc_used();
    var rr = svara_sequence_render(st_sq, voice, SR);
    # Each phoneme's samples, then the output: at least 16 bytes a sample.
    assert_eq((alloc_used() - r0) / vec_len(rr) >= 16, 1,
      "control: svara_sequence_render keeps its samples twice on the same sequence");

    # ================================================================
    test_group("3.8.3: a sample vec keeps the buffer it was rendered into");
    # ================================================================
    # lib/vec.cyr cannot size a vec up front, and vec_push doubles from 16 and copies
    # into a bump arena that never frees: a vec of n samples kept about twice its
    # capacity, beside the buffer the samples were rendered into. svara_vec_adopt
    # hands vec_new_a an Allocator that answers with that buffer.
    var ad = adopt_bytes(100, svara_vec_room_bytes(100));
    assert_eq(ad >= 0, 1, "control: an adopted vec holds the buffer's 100 samples, in order");
    assert_eq(ad <= 128, 1, "adopting a vec's room keeps only the vec header and its Allocator");
    var ad_short = adopt_bytes(100, 800);
    assert_eq(ad_short >= 0, 1, "control: an adopted short buffer gives the same 100 samples");
    assert_eq(ad_short >= 1024, 1,
      "control: a buffer short of a vec's capacity is copied out of, so the measure sees it");
    # A buffer shorter than the vec's capacity must never be grown into: the vec
    # would take the bytes past it for its own.
    var short = alloc(800);
    var guard = alloc(256);   # room for the 28 pushes a mutant would write into it
    assert_eq(guard - short, 800, "control: the guard sits right after the 800-byte buffer");
    store64(guard, 0x5A5A5A5A5A5A5A5A);
    var gi = 0;
    while (gi < 100) { store64(short + gi * 8, (gi * 3 + 1)); gi = gi + 1; }
    var sv = svara_vec_adopt(short, 100, 800);
    while (gi < 128) { vec_push(sv, (gi * 3 + 1)); gi = gi + 1; }
    assert_eq(load64(guard), 0x5A5A5A5A5A5A5A5A, "pushing up to the vec's capacity never writes past a short buffer");
    var gbad = 0;
    gi = 0;
    while (gi < 128) { if (vec_get(sv, gi) != (gi * 3 + 1)) { gbad = gbad + 1; } gi = gi + 1; }
    assert_eq(gbad, 0, "and the vec holds all 128 values");
    # An adopted vec grows like any other once it is full.
    var room = svara_alloc_vec_room(100);
    gi = 0;
    while (gi < 100) { store64(room + gi * 8, (gi * 3 + 1)); gi = gi + 1; }
    var gv = svara_vec_adopt(room, 100, svara_vec_room_bytes(100));
    while (gi < 300) { vec_push(gv, (gi * 3 + 1)); gi = gi + 1; }
    gbad = 0;
    gi = 0;
    while (gi < 300) { if (vec_get(gv, gi) != (gi * 3 + 1)) { gbad = gbad + 1; } gi = gi + 1; }
    assert_eq(vec_len(gv), 300, "an adopted vec pushed past its room grows");
    assert_eq(gbad, 0, "and keeps every value");

    # The accumulator the batch renders fill: sized to an expectation, grown past it.
    var src = alloc(40 * 8);
    gi = 0;
    while (gi < 40) { store64(src + gi * 8, (gi * 3 + 1)); gi = gi + 1; }
    var acc[24];
    assert_eq(svara_samples_acc_init(&acc, 10), 0, "an accumulator takes an expectation");
    assert_eq(svara_samples_acc_append(&acc, src, 7), 0, "an append inside the expectation");
    assert_eq(svara_samples_acc_append(&acc, src + 56, 7), 0, "an append past the expectation grows it");
    assert_eq(svara_samples_acc_append(&acc, src + 112, 0), 0, "an empty append");
    assert_eq(svara_samples_acc_append(&acc, src + 112, 26), 0, "a second growth");
    assert_eq(svara_samples_acc_append(&acc, src, SV_MAX_SAMPLES), SVARA_ERR_COMPUTATION,
      "an append past SV_MAX_SAMPLES is refused");
    assert_eq(svara_samples_acc_len(&acc), 40, "and appends nothing");
    var av = svara_samples_acc_vec(&acc);
    gbad = 0;
    gi = 0;
    while (gi < 40) { if (vec_get(av, gi) != (gi * 3 + 1)) { gbad = gbad + 1; } gi = gi + 1; }
    assert_eq(vec_len(av), 40, "the vec holds all 40 samples");
    assert_eq(gbad, 0, "in order, across both growths");
    assert_eq(svara_samples_acc_init(&acc, 0), 0, "an accumulator with no expectation");
    assert_eq(vec_len(svara_samples_acc_vec(&acc)), 0, "gives an empty vec");

    # ================================================================
    test_group("3.8.3: each render keeps its samples about once");
    # ================================================================
    # Bytes kept per output sample, against 3.8.2 on the same inputs. A vec room is
    # at most twice its samples, so 16 bytes a sample is the most one copy can keep.
    var pa = alloc_used();
    var pv = svara_phoneme_synthesize(SVARA_PH_VOWEL_A, voice, SR, 0.1);
    var pb = (alloc_used() - pa) / vec_len(pv);
    assert_eq(pb >= 8, 1, "control: a phoneme keeps at least its samples");
    assert_eq(pb < 20, 1, "phoneme_synthesize keeps under 20 bytes a sample (3.8.2: 38)");
    var sr_a = alloc_used();
    var sv2 = svara_sequence_render(st_sq, voice, SR);
    var sr_b = (alloc_used() - sr_a) / vec_len(sv2);
    assert_eq(sr_b < 24, 1, "sequence_render keeps under 24 bytes a sample (3.8.2: 63)");
    var br = svara_batch_new(voice, SR);
    svara_batch_push(br, SVARA_PH_VOWEL_A, 0.1, SVARA_STRESS_PRIMARY);
    svara_batch_push(br, SVARA_PH_NASAL_N, 0.06, SVARA_STRESS_UNSTRESSED);
    svara_batch_push(br, SVARA_PH_VOWEL_I, 0.1, SVARA_STRESS_SECONDARY);
    var bo1 = svara_batch_render_all(br);
    var bt_a = alloc_used();
    var bo2 = svara_batch_render_all(br);
    var bn = vec_len(SvRenderOutput_samples(bo2));
    var bt_b = (alloc_used() - bt_a) / bn;
    assert_eq(bt_b >= 8, 1, "control: a warmed batch render keeps at least its samples");
    assert_eq(bt_b < 16, 1, "a warmed batch render keeps under 16 bytes a sample (3.8.2: 21)");
    var pool = svara_pool_new(voice, SR);
    var pph = vec_new();
    vec_push(pph, SVARA_PH_VOWEL_A); vec_push(pph, SVARA_PH_FRIC_S); vec_push(pph, SVARA_PH_VOWEL_I);
    var pdu = vec_new();
    vec_push(pdu, 0.1); vec_push(pdu, 0.08); vec_push(pdu, 0.1);
    var q1 = svara_pool_render_batch(pool, pph, pdu, voice);
    var qa = alloc_used();
    var q2 = svara_pool_render_batch(pool, pph, pdu, voice);
    var qb = (alloc_used() - qa) / vec_len(q2);
    assert_eq(qb >= 8, 1, "control: a warmed pool batch keeps at least its samples");
    assert_eq(qb < 16, 1, "a warmed pool batch keeps under 16 bytes a sample (3.8.2: 21)");
    # A render that fails at its first event sizes nothing for the events after it.
    var pbad = vec_new();
    vec_push(pbad, 0 - F64_ONE); vec_push(pbad, F64_ONE); vec_push(pbad, F64_ONE);
    var fl_a = alloc_used();
    assert_eq(svara_pool_render_batch(pool, pph, pbad, voice), SVARA_ERR_INVALID_DURATION,
      "control: a pool batch with a negative first duration is refused");
    assert_eq(alloc_used() - fl_a < 1024, 1, "and keeps no room for the 2 s after it");
    var hv = svara_voice_new_male();
    SvVoiceProfile_set_base_f0(hv, f64_from(1900));
    var hb = svara_batch_new(hv, SR);
    # The context sizes its own buffer before it sets the pitch, so warm it past the
    # refused event's 1.15 s first: what is left to see is the output's room.
    svara_batch_push(hb, SVARA_PH_VOWEL_A, 1.3, SVARA_STRESS_UNSTRESSED);
    assert_eq(svara_is_err(svara_batch_render_all(hb)), 0, "control: the batch renders at 1900 Hz unstressed");
    svara_batch_clear(hb);
    svara_batch_push(hb, SVARA_PH_VOWEL_A, F64_ONE, SVARA_STRESS_PRIMARY);
    svara_batch_push(hb, SVARA_PH_VOWEL_A, F64_ONE, SVARA_STRESS_UNSTRESSED);
    var ha = alloc_used();
    assert_eq(svara_batch_render_all(hb), SVARA_ERR_INVALID_PITCH,
      "control: a batch whose first event stresses 1900 Hz past 2000 is refused");
    assert_eq(alloc_used() - ha < 1024, 1, "and keeps no room for the second event");

    # ================================================================
    test_group("3.8.3: the renders give 3.8.2's samples");
    # ================================================================
    # Each against the 3.8.2 code, rebuilt above from public pieces, bit for bit.
    var mx = mixed_seq();
    var mr = svara_sequence_render(mx, voice, SR);
    assert_eq(vec_len(mr) > 0, 1, "control: the mixed sequence renders");
    assert_eq(samples_same(mr, ref_sequence_render(mx, voice)), 1,
      "sequence_render is svara_seq_crossfade over the phonemes' vecs, on a sequence through every crossfade branch");
    var one = svara_sequence_new();
    svara_sequence_push(one, svara_phoneme_event_new(SVARA_PH_FRIC_S, 0.05, SVARA_STRESS_PRIMARY));
    assert_eq(samples_same(svara_sequence_render(one, voice, SR), ref_sequence_render(one, voice)), 1,
      "and on one event");
    var fem = svara_voice_new_female();
    assert_eq(samples_same(svara_sequence_render(mx, fem, SR), ref_sequence_render(mx, fem)), 1,
      "and with another voice");
    assert_eq(samples_same(mr, svara_sequence_render(mx, fem, SR)), 0, "control: the voice changes the samples");
    var mb = svara_batch_new(voice, SR);
    svara_batch_extend(mb, SvPhonemeSequence_events(mx));
    var mbo = svara_batch_render_all(mb);
    assert_eq(samples_same(SvRenderOutput_samples(mbo), ref_batch(voice, SvPhonemeSequence_events(mx))), 1,
      "a batch render is 3.8.2's, over the same nine events");
    var fph = vec_new();
    var fdu = vec_new();
    var px = 0;
    while (px < vec_len(SvPhonemeSequence_events(mx))) {
        var fe = vec_get(SvPhonemeSequence_events(mx), px);
        vec_push(fph, SvPhonemeEvent_phoneme(fe));
        vec_push(fdu, SvPhonemeEvent_duration(fe));
        px = px + 1;
    }
    var fpool = svara_pool_new(voice, SR);
    assert_eq(samples_same(svara_pool_render_batch(fpool, fph, fdu, voice), ref_pool(voice, fph, fdu)), 1,
      "a pool batch is 3.8.2's, over the same nine pairs");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
