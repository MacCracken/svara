# prosody.tcyr -- tests for src/prosody.cyr. Ports rust-old/src/prosody.rs
# #[test] blocks (serde: tests/serde.tcyr). Include: hisab (calc_monotone_cubic_checked) +
# prosody.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"
include "src/error.cyr"
include "src/rng.cyr"
include "src/glottal.cyr"   # the tone ids, points and lookup, since 3.13.0
include "src/prosody.cyr"
include "tests/approx.cyr"

var TOL_1EM6 = 0x3EB0C6F7A0B5ED8D;   # 1e-6

alloc_init();

# ================================================================
test_group("flat contour");
var flat = svara_prosody_flat();
assert_eq(approx(svara_prosody_f0_at(flat, 0), F64_ONE, TOL_1EM6), 1, "flat @0 = 1.0");
assert_eq(approx(svara_prosody_f0_at(flat, F64_HALF), F64_ONE, TOL_1EM6), 1, "flat @0.5 = 1.0");
assert_eq(approx(svara_prosody_f0_at(flat, F64_ONE), F64_ONE, TOL_1EM6), 1, "flat @1.0 = 1.0");

# ================================================================
test_group("intonation direction");
var decl = svara_prosody_from_pattern(SVARA_INTONATION_DECLARATIVE, f64_from(120));
assert_eq(f64_gt(svara_prosody_f0_at(decl, 0), svara_prosody_f0_at(decl, F64_ONE)), 1, "declarative falls");
var inter = svara_prosody_from_pattern(SVARA_INTONATION_INTERROGATIVE, f64_from(120));
assert_eq(f64_gt(svara_prosody_f0_at(inter, F64_ONE), svara_prosody_f0_at(inter, 0)), 1, "interrogative rises");

# ================================================================
test_group("stress application");
var sc = svara_prosody_flat();
var before_dur = SvProsodyContour_duration_scale(sc);
svara_prosody_apply_stress(sc, SVARA_STRESS_PRIMARY, F64_HALF);
assert_eq(f64_gt(SvProsodyContour_duration_scale(sc), before_dur), 1, "primary stress lengthens");
assert_eq(f64_gt(SvProsodyContour_amplitude_scale(sc), F64_ONE), 1, "primary stress boosts amplitude");
# f0 still finite + positive after stress (exercises insert_f0_boost path)
var stress_ok = 1;
var si = 0;
while (si < 20) {
    var v = svara_prosody_f0_at(sc, f64_div(f64_from(si), f64_from(20)));
    if (svara_is_finite(v) == 0) { stress_ok = 0; }
    if (f64_le(v, 0) == 1) { stress_ok = 0; }
    si = si + 1;
}
assert_eq(stress_ok, 1, "stressed contour stays finite + positive");

# ================================================================
test_group("interpolation finite + positive (100 pts)");
var mono_ok = 1;
var mi = 0;
while (mi < 100) {
    var v = svara_prosody_f0_at(decl, f64_div(f64_from(mi), f64_from(100)));
    if (svara_is_finite(v) == 0) { mono_ok = 0; }
    if (f64_le(v, 0) == 1) { mono_ok = 0; }
    mi = mi + 1;
}
assert_eq(mono_ok, 1, "declarative f0 finite + positive throughout");

# ================================================================
test_group("tones");
var hi = svara_tone_to_contour(SVARA_TONE_HIGH);
var hi_span = f64_abs(f64_sub(svara_prosody_f0_at(hi, 0), svara_prosody_f0_at(hi, F64_ONE)));
assert_eq(f64_lt(hi_span, 0.05), 1, "high tone flat");
assert_eq(f64_gt(svara_prosody_f0_at(hi, 0), 1.1), 1, "high tone above base");
var ri = svara_tone_to_contour(SVARA_TONE_RISING);
assert_eq(f64_gt(svara_prosody_f0_at(ri, F64_ONE), svara_prosody_f0_at(ri, 0)), 1, "rising tone rises");
var fa = svara_tone_to_contour(SVARA_TONE_FALLING);
assert_eq(f64_gt(svara_prosody_f0_at(fa, 0), svara_prosody_f0_at(fa, F64_ONE)), 1, "falling tone falls");
var di = svara_tone_to_contour(SVARA_TONE_DIPPING);
var di_mid = svara_prosody_f0_at(di, F64_HALF);
assert_eq(f64_lt(di_mid, svara_prosody_f0_at(di, 0)), 1, "dipping dips below start");
assert_eq(f64_gt(svara_prosody_f0_at(di, F64_ONE), di_mid), 1, "dipping rises back");
var ne = svara_tone_to_contour(SVARA_TONE_NEUTRAL);
assert_eq(f64_lt(SvProsodyContour_duration_scale(ne), 0.8), 1, "neutral tone short");

# ================================================================
test_group("all 9 tones valid (finite + positive)");
var tones = vec_new();
vec_push(tones, SVARA_TONE_HIGH);
vec_push(tones, SVARA_TONE_RISING);
vec_push(tones, SVARA_TONE_DIPPING);
vec_push(tones, SVARA_TONE_FALLING);
vec_push(tones, SVARA_TONE_NEUTRAL);
vec_push(tones, SVARA_TONE_LOW);
vec_push(tones, SVARA_TONE_MID);
vec_push(tones, SVARA_TONE_LOW_RISING);
vec_push(tones, SVARA_TONE_HIGH_FALLING);
var ti = 0;
var tones_ok = 1;
while (ti < vec_len(tones)) {
    var c = svara_tone_to_contour(vec_get(tones, ti));
    var k = 0;
    while (k < 11) {
        var v = svara_prosody_f0_at(c, f64_div(f64_from(k), f64_from(10)));
        if (svara_is_finite(v) == 0) { tones_ok = 0; }
        if (f64_le(v, 0) == 1) { tones_ok = 0; }
        k = k + 1;
    }
    ti = ti + 1;
}
assert_eq(tones_ok, 1, "all 9 tones finite + positive across [0,1]");

# Rust's `.unwrap_or(1.0)` keeps Some(0.0). svara read every 0 from hisab as a
# refusal until hisab 3.4.0's checked form split the two.
test_group("a 0.0 multiplier is an answer, not a refusal");
var zp = vec_new();
vec_push(zp, svara_pt_new(0, F64_ONE));
vec_push(zp, svara_pt_new(F64_HALF, 0));
vec_push(zp, svara_pt_new(F64_ONE, F64_ONE));
var zc = svara_prosody_make(zp, F64_ONE, F64_ONE);
assert_eq(svara_prosody_f0_at(zc, F64_HALF), 0, "a contour at 0.0 reads 0.0");
assert_eq(svara_prosody_f0_at(zc, 0), F64_ONE, "control: the first point reads its value");
var zq = svara_prosody_f0_at(zc, 0.25);
assert_eq(f64_gt(zq, 0), 1, "control: between the points is above 0.0");
assert_eq(f64_lt(zq, F64_ONE), 1, "control: between the points is below 1.0");

# The public route to the same value.
var bz = svara_prosody_flat();
svara_prosody_insert_f0_boost(bz, F64_HALF, 0, 0.1);
assert_eq(svara_prosody_f0_at(bz, F64_HALF), 0, "a zero boost reads 0.0 at its peak");

test_group("a refusal still reads as 1.0");
var span_p = vec_new();
vec_push(span_p, svara_pt_new(0.2, f64_from(2)));
vec_push(span_p, svara_pt_new(0.8, f64_from(3)));
var span_c = svara_prosody_make(span_p, F64_ONE, F64_ONE);
assert_eq(svara_prosody_f0_at(span_c, 0.1), F64_ONE, "before the first point");
assert_eq(svara_prosody_f0_at(span_c, 0.9), F64_ONE, "after the last point");
assert_eq(approx(svara_prosody_f0_at(span_c, 0.2), f64_from(2), TOL_1EM6), 1, "control: on the first point");
assert_eq(approx(svara_prosody_f0_at(span_c, 0.8), f64_from(3), TOL_1EM6), 1, "control: on the last point");

var rep_p = vec_new();
vec_push(rep_p, svara_pt_new(F64_HALF, f64_from(2)));
vec_push(rep_p, svara_pt_new(F64_HALF, f64_from(3)));
var rep_c = svara_prosody_make(rep_p, F64_ONE, F64_ONE);
assert_eq(svara_prosody_f0_at(rep_c, F64_HALF), F64_ONE, "a repeated time is refused");

# ================================================================
test_group("3.13.0: the tone table is the Rust's (prosody.rs:231-285 at tag 3.6.5)");
# ================================================================
# Since 3.13.0 svara_tone_to_contour builds from svara_tone_points_into, so the two
# cannot be checked against each other. Each tone's points and scales are transcribed
# here from the Rust's Tone::to_contour, as decimals: svara reads them as f64 (ADR-0008).
var tt_xs = alloc(64);
var tt_ys = alloc(64);
var tt_wx = alloc(64);
var tt_wy = alloc(64);
var tt_tone = 0;
var tt_n = 0;
var tt_dur = 0;
var tt_amp = 0;
var tt_bad = 0;
# Start the expectation for tone t: n points, and the contour's two scales.
fn tt_want(t, n, dur, amp) {
    tt_tone = t;
    tt_n = n;
    tt_dur = dur;
    tt_amp = amp;
    return 0;
}
# Expected point k of the current tone.
fn tt_pt(k, x, y) {
    store64(tt_wx + k * 8, x);
    store64(tt_wy + k * 8, y);
    return 0;
}
# Compare the table and svara_tone_to_contour against the expectation.
fn tt_check() {
    var n = svara_tone_points_into(tt_tone, tt_xs, tt_ys);
    if (n != tt_n) { tt_bad = tt_bad + 1; }
    var c = svara_tone_to_contour(tt_tone);
    var pts = SvProsodyContour_f0_points(c);
    if (vec_len(pts) != tt_n) { tt_bad = tt_bad + 1; }
    var k = 0;
    while (k < tt_n) {
        if (load64(tt_xs + k * 8) != load64(tt_wx + k * 8)) { tt_bad = tt_bad + 1; }
        if (load64(tt_ys + k * 8) != load64(tt_wy + k * 8)) { tt_bad = tt_bad + 1; }
        if (svara_pt_value(vec_get(pts, k)) != load64(tt_wy + k * 8)) { tt_bad = tt_bad + 1; }
        k = k + 1;
    }
    if (SvProsodyContour_duration_scale(c) != tt_dur) { tt_bad = tt_bad + 1; }
    if (SvProsodyContour_amplitude_scale(c) != tt_amp) { tt_bad = tt_bad + 1; }
    return 0;
}
tt_want(0, 3, 1.0, 1.0);
tt_pt(0, 0.0, 1.2);
tt_pt(1, 0.5, 1.2);
tt_pt(2, 1.0, 1.2);
tt_check();
tt_want(1, 4, 1.0, 1.0);
tt_pt(0, 0.0, 0.85);
tt_pt(1, 0.3, 0.85);
tt_pt(2, 0.7, 1.1);
tt_pt(3, 1.0, 1.25);
tt_check();
tt_want(2, 5, 1.15, 0.9);
tt_pt(0, 0.0, 1.0);
tt_pt(1, 0.2, 0.85);
tt_pt(2, 0.5, 0.75);
tt_pt(3, 0.8, 0.9);
tt_pt(4, 1.0, 1.05);
tt_check();
tt_want(3, 4, 0.9, 1.1);
tt_pt(0, 0.0, 1.3);
tt_pt(1, 0.3, 1.15);
tt_pt(2, 0.7, 0.9);
tt_pt(3, 1.0, 0.75);
tt_check();
tt_want(4, 2, 0.7, 0.85);
tt_pt(0, 0.0, 1.0);
tt_pt(1, 1.0, 0.95);
tt_check();
tt_want(5, 3, 1.0, 0.95);
tt_pt(0, 0.0, 0.75);
tt_pt(1, 0.5, 0.75);
tt_pt(2, 1.0, 0.75);
tt_check();
tt_want(6, 3, 1.0, 1.0);
tt_pt(0, 0.0, 1.0);
tt_pt(1, 0.5, 1.0);
tt_pt(2, 1.0, 1.0);
tt_check();
tt_want(7, 4, 1.0, 1.0);
tt_pt(0, 0.0, 0.7);
tt_pt(1, 0.4, 0.75);
tt_pt(2, 0.7, 0.95);
tt_pt(3, 1.0, 1.1);
tt_check();
tt_want(8, 4, 0.95, 1.05);
tt_pt(0, 0.0, 1.35);
tt_pt(1, 0.2, 1.3);
tt_pt(2, 0.6, 1.0);
tt_pt(3, 1.0, 0.7);
tt_check();
assert_eq(tt_bad, 0, "all nine tones' points and scales, in the table and in the contour");
assert_eq(svara_tone_points_into(SVARA_TONE_NONE, tt_xs, tt_ys), 0, "no tone has no points");
assert_eq(svara_tone_points_into(9, tt_xs, tt_ys), 0, "nor does a value that is not a tone");
var tt_hf = SvProsodyContour_f0_points(svara_tone_to_contour(99));
assert_eq((vec_len(tt_hf) == 4) & (svara_pt_value(vec_get(tt_hf, 0)) == 0x3FF599999999999A), 1,
  "a contour for a value that is not a tone is still high falling, as through 3.12.0");

# ================================================================
test_group("3.13.0: a source carrying a tone gives render_planned's pitch track (ADR-0016)");
# ================================================================
# render_planned sets f0 to base * contour(i / span) before every sample, from the contour
# svara_tone_to_contour builds. A source carrying the tone looks it up only at period starts.
# The two must give the same samples, for every tone.
#must_use
fn tt_twin(tone, base, span) {
    var a = svara_glottal_new(f64_from(120), f64_from(44100));
    var b = svara_glottal_new(f64_from(120), f64_from(44100));
    var te = svara_glottal_set_tone(a, tone, base, span);
    var pts = SvProsodyContour_f0_points(svara_tone_to_contour(tone));
    var xs = alloc(64);
    var ys = alloc(64);
    var n = vec_len(pts);
    svara_prosody_fill(pts, n, xs, ys);
    var bad = 0;
    var i = 0;
    while (i < span) {
        var m = svara_prosody_f0_at_filled(xs, ys, n, f64_div(f64_from(i), f64_from(span)));
        var fe = svara_glottal_set_f0(b, f64_mul(base, m));
        if (svara_glottal_next_sample(a) != svara_glottal_next_sample(b)) { bad = bad + 1; }
        i = i + 1;
    }
    return bad;
}
var tw_bad = 0;
var tw_t = 0;
while (tw_t < 9) { tw_bad = tw_bad + tt_twin(tw_t, f64_from(130), 8820); tw_t = tw_t + 1; }
assert_eq(tw_bad, 0, "all nine tones, 0.2 s at 130 Hz: bit for bit");
var tw_a = svara_glottal_new(f64_from(120), f64_from(44100));
var tw_b = svara_glottal_new(f64_from(120), f64_from(44100));
var tw_e = svara_glottal_set_tone(tw_a, SVARA_TONE_RISING, f64_from(120), 8820);
var tw_moved = 0;
var tw_i = 0;
while (tw_i < 8820) {
    if (svara_glottal_next_sample(tw_a) != svara_glottal_next_sample(tw_b)) { tw_moved = tw_moved + 1; }
    tw_i = tw_i + 1;
}
assert_eq(tw_moved > 1000, 1, "control: a rising tone moves the source from an untoned twin");
var tw_c = svara_glottal_new(f64_from(120), f64_from(44100));
var tw_d = svara_glottal_new(f64_from(120), f64_from(44100));
var tw_e2 = svara_glottal_set_tone(tw_c, SVARA_TONE_FALLING, f64_from(120), 8820);
var tw_e3 = svara_glottal_set_tone(tw_c, SVARA_TONE_NONE, f64_from(120), 8820);
var tw_same = 0;
tw_i = 0;
while (tw_i < 8820) {
    if (svara_glottal_next_sample(tw_c) != svara_glottal_next_sample(tw_d)) { tw_same = tw_same + 1; }
    tw_i = tw_i + 1;
}
assert_eq(tw_same, 0, "SVARA_TONE_NONE clears a tone: the source matches an untoned one");

var rc = assert_summary();
syscall(60, rc);
