# sequence.cyr -- phoneme sequencing with coarticulation + crossfading.
# Ports rust-old/src/sequence.rs. Combines phonemes into continuous speech:
# stress-based duration/f0 scaling, consonant-cluster compression, anticipatory
# nasalization, and either resistance-weighted crossfade (render) or continuous
# trajectory-planned synthesis (render_planned). f32 -> f64 throughout.
#
# Requires: stdlib alloc/vec/math, hisab (ease_in_out_smooth), error.cyr, rng.cyr,
# formant.cyr, glottal.cyr, tract.cyr, voice.cyr, phoneme.cyr (synthesize_phoneme_
# nasalized / detect_nasalization / coarticulation_resistance / class), prosody.cyr
# (Stress / Tone / to_contour / f0_at), trajectory.cyr (plan / formants_at /
# apply_speaking_rate).

var SV_SEQ_MIN_CF   = 0.15;   # min crossfade fraction (high-resistance)
var SV_SEQ_MAX_CF   = 0.45;   # max crossfade fraction (low-resistance)
var SV_SEQ_CLUSTER  = 0.7;    # consonant-cluster duration compression
var SVARA_TONE_NONE = (0 - 1); # PhonemeEvent.tone sentinel for "no tone"

# ⚠ v2.0.1 QUIRK, PRESERVED (3 of 3) -- `tone` is honoured ONLY by
# svara_sequence_render_planned. The crossfade path, svara_sequence_render,
# reads stress but ignores tone entirely, so setting a tone and calling
# `render` produces the same audio as setting none. The Rust did the same
# (rust-old/src/sequence.rs); it is preserved for parity until it is decided in
# docs/development/roadmap.md 3.9.x, and any fix gets a minor and its own test.
#
# The other two quirks are annotated at src/glottal.cyr (set_speed_quotient is
# ignored by the Rosenberg pulse) and src/phoneme.cyr (per-vowel spectral tilt
# is computed but not applied). This one had been described only in state.md
# and annotated nowhere in code.

# PhonemeEvent -- a timed phoneme. tone = SVARA_TONE_NONE or a SVARA_TONE_* value.
#derive(accessors)
#derive(Serialize)
struct SvPhonemeEvent { phoneme: i64; duration: f64; stress: i64; tone: i64; }

# phoneme_event_new -- a phoneme, its duration in seconds and its stress. No tone.
#must_use
fn svara_phoneme_event_new(phoneme, duration, stress) {
    var e = alloc(sizeof(SvPhonemeEvent));
    SvPhonemeEvent_set_phoneme(e, phoneme);
    SvPhonemeEvent_set_duration(e, duration);
    SvPhonemeEvent_set_stress(e, stress);
    SvPhonemeEvent_set_tone(e, SVARA_TONE_NONE);
    return e;
}

# phoneme_event_with_tone -- as phoneme_event_new, with a lexical tone.
#must_use
fn svara_phoneme_event_with_tone(phoneme, duration, stress, tone) {
    var e = svara_phoneme_event_new(phoneme, duration, stress);
    SvPhonemeEvent_set_tone(e, tone);
    return e;
}

# phoneme_event_is_valid -- 1 if the event's phoneme, stress and tone are each a
# value of its Rust enum (a tone may also be SVARA_TONE_NONE), else 0. A decoded
# event can carry any integer, and Rust's serde refuses an unknown variant.
#must_use
fn svara_phoneme_event_is_valid(e) {
    if (svara_phoneme_is_valid(SvPhonemeEvent_phoneme(e)) == 0) { return 0; }
    var st = SvPhonemeEvent_stress(e);
    if ((st < SVARA_STRESS_PRIMARY) | (st > SVARA_STRESS_UNSTRESSED)) { return 0; }
    var tn = SvPhonemeEvent_tone(e);
    if ((tn < SVARA_TONE_NONE) | (tn > SVARA_TONE_HIGH_FALLING)) { return 0; }
    return 1;
}

# phoneme_event_copy -- a fresh event with `e`'s fields. Rust's PhonemeEvent is a
# value, so a sequence or renderer keeps its own and a caller's later write to `e`
# changes nothing there.
#must_use
fn svara_phoneme_event_copy(e) {
    var c = alloc(sizeof(SvPhonemeEvent));
    SvPhonemeEvent_set_phoneme(c, SvPhonemeEvent_phoneme(e));
    SvPhonemeEvent_set_duration(c, SvPhonemeEvent_duration(e));
    SvPhonemeEvent_set_stress(c, SvPhonemeEvent_stress(e));
    SvPhonemeEvent_set_tone(c, SvPhonemeEvent_tone(e));
    return c;
}

# phoneme_events_copy -- a fresh vec of copies of every event in `events`.
#must_use
fn svara_phoneme_events_copy(events) {
    var c = vec_new();
    var n = vec_len(events);
    var i = 0;
    while (i < n) { vec_push(c, svara_phoneme_event_copy(vec_get(events, i))); i = i + 1; }
    return c;
}

# PhonemeSequence -- ordered events + coarticulation params.
#derive(accessors)
#derive(Serialize)
struct SvPhonemeSequence {
    events: Vec<SvPhonemeEvent>;
    transition_window: f64; lookahead_onset: f64; speaking_rate: f64;
}

# sequence_new -- empty: 0.05 s transition window, 0.6 lookahead onset, speaking rate 1.0.
#must_use
fn svara_sequence_new() {
    var s = alloc(sizeof(SvPhonemeSequence));
    SvPhonemeSequence_set_events(s, vec_new());
    SvPhonemeSequence_set_transition_window(s, 0.05);
    SvPhonemeSequence_set_lookahead_onset(s, 0.6);
    SvPhonemeSequence_set_speaking_rate(s, F64_ONE);
    return s;
}

# set_transition_window -- coarticulation crossfade seconds, floored at 0.001.
fn svara_sequence_set_transition_window(s, window) {
    SvPhonemeSequence_set_transition_window(s, f64_max(window, 0.001));
}
# set_lookahead_onset -- anticipatory-coarticulation weight, clamped [0,1].
fn svara_sequence_set_lookahead_onset(s, onset) {
    SvPhonemeSequence_set_lookahead_onset(s, f64_clamp(onset, 0, F64_ONE));
}
# set_speaking_rate -- global duration scale, clamped [0.5,3.0].
fn svara_sequence_set_speaking_rate(s, rate) {
    SvPhonemeSequence_set_speaking_rate(s, f64_clamp(rate, 0.5, 3.0));
}
# speaking-rate multiplier.
#must_use
fn svara_sequence_speaking_rate(s) { return SvPhonemeSequence_speaking_rate(s); }
# coarticulation transition window in seconds.
#must_use
fn svara_sequence_transition_window(s) { return SvPhonemeSequence_transition_window(s); }
# push -- append a copy of a phoneme event to the sequence.
fn svara_sequence_push(s, event) { vec_push(SvPhonemeSequence_events(s), svara_phoneme_event_copy(event)); }
# number of events.
#must_use
fn svara_sequence_len(s) { return vec_len(SvPhonemeSequence_events(s)); }
# 1 if the sequence has no events, 0 otherwise.
#must_use
fn svara_sequence_is_empty(s) {
    if (vec_len(SvPhonemeSequence_events(s)) == 0) { return 1; }
    return 0;
}
# the sequence's event vec. Borrowed, not a copy.
#must_use
fn svara_sequence_events(s) { return SvPhonemeSequence_events(s); }
# sum of the event durations in seconds, as stored.
#must_use
fn svara_sequence_total_duration(s) {
    var events = SvPhonemeSequence_events(s);
    var total = 0;
    var i = 0;
    while (i < vec_len(events)) {
        total = f64_add(total, SvPhonemeEvent_duration(vec_get(events, i)));
        i = i + 1;
    }
    return total;
}

# clone a VoiceProfile (for per-event f0 modification without mutating caller's).
#must_use
fn svara_seq_voice_clone(v) {
    return svara_voice_copy_into(v, alloc(sizeof(SvVoiceProfile)));
}

# stress_f0 -- the base f0 an event renders at: x1.10 under primary stress, x1.05
# under secondary, unchanged otherwise.
#must_use
fn svara_seq_stress_f0(f0, stress) {
    if (stress == SVARA_STRESS_PRIMARY) { return f64_mul(f0, 1.10); }
    if (stress == SVARA_STRESS_SECONDARY) { return f64_mul(f0, 1.05); }
    return f0;
}

# is_consonant -- 1 if event `e` counts toward a consonant cluster: its phoneme is
# not a vowel, a diphthong or silence.
#must_use
fn svara_seq_is_consonant(e) {
    var c = svara_phoneme_class(SvPhonemeEvent_phoneme(e));
    if ((c != SVARA_CLASS_VOWEL) & (c != SVARA_CLASS_DIPHTHONG) & (c != SVARA_CLASS_SILENCE)) { return 1; }
    return 0;
}

# in_cluster -- svara_seq_detect_clusters' flag for event i alone, with no vec: 1 if
# it is a consonant next to another consonant. A run of two or more is exactly the
# set of consonants with a consonant neighbour.
#must_use
fn svara_seq_in_cluster(events, i) {
    if (svara_seq_is_consonant(vec_get(events, i)) == 0) { return 0; }
    if (i > 0) {
        if (svara_seq_is_consonant(vec_get(events, i - 1)) == 1) { return 1; }
    }
    if ((i + 1) < vec_len(events)) {
        if (svara_seq_is_consonant(vec_get(events, i + 1)) == 1) { return 1; }
    }
    return 0;
}

# detect_consonant_clusters -- vec<0/1>: 1 where the phoneme is in a run of 2+
# adjacent consonants (non vowel/diphthong/silence).
#must_use
fn svara_seq_detect_clusters(events) {
    var n = vec_len(events);
    var flags = vec_new();
    var i = 0;
    while (i < n) { vec_push(flags, 0); i = i + 1; }
    var run_start = (0 - 1);
    i = 0;
    while (i <= n) {
        var is_cons = 0;
        if (i < n) { is_cons = svara_seq_is_consonant(vec_get(events, i)); }
        if ((is_cons == 1) & (run_start < 0)) {
            run_start = i;
        } elif ((is_cons == 0) & (run_start >= 0)) {
            if ((i - run_start) >= 2) {
                var k = run_start;
                while (k < i) { vec_set(flags, k, 1); k = k + 1; }
            }
            run_start = (0 - 1);
        }
        i = i + 1;
    }
    return flags;
}

# effective durations: duration * stress_scale * cluster_scale.
#must_use
fn svara_seq_durations(seq, in_cluster) {
    var events = SvPhonemeSequence_events(seq);
    var n = vec_len(events);
    var durs = vec_new();
    var i = 0;
    while (i < n) {
        vec_push(durs, svara_seq_event_duration(vec_get(events, i), vec_get(in_cluster, i)));
        i = i + 1;
    }
    return durs;
}

# event_duration -- the duration event `e` renders at: its own, x1.15 under primary
# stress, x1.05 under secondary and x0.9 unstressed, then x0.7 when `in_cluster` is 1.
#must_use
fn svara_seq_event_duration(e, in_cluster) {
    var ss = 0.9;
    var st = SvPhonemeEvent_stress(e);
    if (st == SVARA_STRESS_PRIMARY) { ss = 1.15; }
    elif (st == SVARA_STRESS_SECONDARY) { ss = 1.05; }
    var cs = F64_ONE;
    if (in_cluster == 1) { cs = SV_SEQ_CLUSTER; }
    return f64_mul(f64_mul(SvPhonemeEvent_duration(e), ss), cs);
}

# min_crossfade -- the sequence's transition window in samples: the floor under
# every crossfade. The window is caller-set (floored at 0.001 s, not capped), so it
# saturates as Rust's `as usize` does rather than casting bare.
#must_use
fn svara_seq_min_crossfade(seq, sample_rate) {
    return svara_count_from_f64(f64_mul(SvPhonemeSequence_transition_window(seq), sample_rate));
}

# crossfade_len -- samples of crossfade between events i and i+1 of `events`, whose
# segments are len_a and len_b samples: a fraction of the shorter, from 0.45 for
# two low-resistance phonemes down to 0.15 for two high, and at least `min_cf`.
#must_use
fn svara_seq_crossfade_len(events, i, len_a, len_b, min_cf) {
    var rl = svara_phoneme_coarticulation_resistance(SvPhonemeEvent_phoneme(vec_get(events, i)));
    var rr = svara_phoneme_coarticulation_resistance(SvPhonemeEvent_phoneme(vec_get(events, i + 1)));
    var avg = f64_mul(f64_add(rl, rr), F64_HALF);
    var frac = f64_sub(SV_SEQ_MAX_CF, f64_mul(avg, f64_sub(SV_SEQ_MAX_CF, SV_SEQ_MIN_CF)));
    var sl = len_a;
    if (len_b < sl) { sl = len_b; }
    # `frac` is built from in-tree coarticulation constants and `sl` is a length,
    # so this cast is bounded on both sides -- no saturation needed.
    var cf_len = f64_to(f64_mul(frac, f64_from(sl)));
    if (cf_len < min_cf) { cf_len = min_cf; }
    return cf_len;
}

# seq_phoneme_list -- a fresh vec of each event's phoneme, in order.
#must_use
fn svara_seq_phoneme_list(seq) {
    var events = SvPhonemeSequence_events(seq);
    var pl = vec_new();
    var i = 0;
    while (i < vec_len(events)) { vec_push(pl, SvPhonemeEvent_phoneme(vec_get(events, i))); i = i + 1; }
    return pl;
}

# sigmoid crossfade easing (hisab smootherstep), clamped.
#must_use
fn svara_seq_sigmoid_fade(t) {
    return ease_in_out_smooth(f64_clamp(t, 0, F64_ONE));
}

# crossfade_segments_variable -- blend adjacent sample vecs with per-boundary
# crossfade lengths (sigmoid). Returns the concatenated/blended sample vec, or
# SVARA_ERR_COMPUTATION if it would pass SV_MAX_SAMPLES.
#must_use
fn svara_seq_crossfade(segments, cf_lengths) {
    var ns = vec_len(segments);
    if (ns == 0) { return vec_new(); }
    if (ns == 1) { return vec_get(segments, 0); }
    var output = vec_new();
    var i = 0;
    while (i < ns) {
        var seg = vec_get(segments, i);
        var seglen = vec_len(seg);
        # A vec holds at most SV_MAX_SAMPLES; past it vec_push ends the process.
        if (seglen > SV_MAX_SAMPLES - vec_len(output)) { return SVARA_ERR_COMPUTATION; }
        var cf_next = 0;
        if (i < vec_len(cf_lengths)) { cf_next = vec_get(cf_lengths, i); }
        var cf_prev = 0;
        if (i > 0) { cf_prev = vec_get(cf_lengths, i - 1); }
        var cfn1 = cf_next;
        if (cfn1 < 1) { cfn1 = 1; }

        if (i == 0) {
            if (seglen > cf_next) {
                var j = 0;
                var stop = seglen - cf_next;
                while (j < stop) { vec_push(output, vec_get(seg, j)); j = j + 1; }
            }
            var fs = seglen - cf_next;
            if (fs < 0) { fs = 0; }
            var k = fs;
            var jj = 0;
            while (k < seglen) {
                var w = f64_sub(F64_ONE, svara_seq_sigmoid_fade(f64_div(f64_from(jj), f64_from(cfn1))));
                vec_push(output, f64_mul(vec_get(seg, k), w));
                jj = jj + 1;
                k = k + 1;
            }
        } else {
            var fade_len = cf_prev;
            if (fade_len > seglen) { fade_len = seglen; }
            var fl1 = fade_len;
            if (fl1 < 1) { fl1 = 1; }
            var output_len = vec_len(output);
            var j = 0;
            while (j < fade_len) {
                var idx = output_len - (fade_len - j);
                if ((idx >= 0) & (idx < output_len)) {
                    var add = f64_mul(vec_get(seg, j), svara_seq_sigmoid_fade(f64_div(f64_from(j), f64_from(fl1))));
                    vec_set(output, idx, f64_add(vec_get(output, idx), add));
                }
                j = j + 1;
            }
            if (seglen > fade_len) {
                if ((i < ns - 1) & (seglen > fade_len + cf_next)) {
                    var m = fade_len;
                    var stop2 = seglen - cf_next;
                    while (m < stop2) { vec_push(output, vec_get(seg, m)); m = m + 1; }
                    var fs2 = seglen - cf_next;
                    var kk = fs2;
                    var j2 = 0;
                    while (kk < seglen) {
                        var w2 = f64_sub(F64_ONE, svara_seq_sigmoid_fade(f64_div(f64_from(j2), f64_from(cfn1))));
                        vec_push(output, f64_mul(vec_get(seg, kk), w2));
                        j2 = j2 + 1;
                        kk = kk + 1;
                    }
                } else {
                    var m2 = fade_len;
                    while (m2 < seglen) { vec_push(output, vec_get(seg, m2)); m2 = m2 + 1; }
                }
            }
        }
        i = i + 1;
    }
    return output;
}

# render -- synthesize each phoneme (stress/cluster/nasalization) and crossfade.
# Returns a vec<f64> of samples, or a negative SVARA_ERR_*.
#must_use
fn svara_sequence_render(seq, voice, sample_rate) {
    #ifdef LOGGING
    var _sp = svara_span_enter("sequence_render");
    #endif
    var events = SvPhonemeSequence_events(seq);
    var n = vec_len(events);
    if (n == 0) {
        #ifdef LOGGING
        svara_span_leave(_sp);
        svara_log_debug("sequence_render: empty sequence");
        #endif
        return vec_new();
    }
    var in_cluster = svara_seq_detect_clusters(events);
    var durs = svara_seq_durations(seq, in_cluster);
    var nasals = svara_detect_nasalization(svara_seq_phoneme_list(seq));

    var segments = vec_new();
    var i = 0;
    while (i < n) {
        var e = vec_get(events, i);
        var ev = svara_seq_voice_clone(voice);
        SvVoiceProfile_set_base_f0(ev, svara_seq_stress_f0(SvVoiceProfile_base_f0(ev), SvPhonemeEvent_stress(e)));
        var seg = svara_phoneme_synthesize_nasalized(SvPhonemeEvent_phoneme(e), ev, sample_rate,
          vec_get(durs, i), vec_get(nasals, i));
        if (svara_is_err(seg) == 1) {
            #ifdef LOGGING
            svara_span_leave(_sp);
            var _e = svara_log_err(seg);
            #endif
            return seg;
        }
        vec_push(segments, seg);
        i = i + 1;
    }

    var cfs = vec_new();
    var min_cf = svara_seq_min_crossfade(seq, sample_rate);
    i = 0;
    while (i < n - 1) {
        vec_push(cfs, svara_seq_crossfade_len(events, i, vec_len(vec_get(segments, i)),
            vec_len(vec_get(segments, i + 1)), min_cf));
        i = i + 1;
    }
    var out = svara_seq_crossfade(segments, cfs);
    #ifdef LOGGING
    svara_span_leave(_sp);
    #endif
    return out;
}

# ================================================================
# render_into -- svara_sequence_render as a stream, on a context the caller keeps.
#
# The plan is svara_sequence_render's: the same stress f0 (x1.10 primary, x1.05
# secondary), the same durations (stress and consonant cluster), the same
# anticipatory nasalization and the same crossfade lengths and sigmoid crossfade,
# sample for sample. What differs is the synthesis of each phoneme: it runs on
# `ctx`, as svara_synthctx_synthesize does, instead of on a new glottal source and
# tract per phoneme. A context carries glottal and noise state from phoneme to
# phoneme and times plosives and affricates its own way (roadmap 3.9.x), so the
# samples are those of svara_seq_crossfade over the segments `ctx` renders, not
# svara_sequence_render's. The length is svara_sequence_render's.
#
# Samples reach `sink` as `callptr(sink, user, samples, count)`, `samples` being
# `count` f64s valid only during the call; the sink's return value is ignored.
# A sample is passed on once no later fade-in can reach it: a fade-in reaches back
# at most its own length, so everything older than the longest fade-in in the plan
# is final. That is at most one phoneme's samples held back.
#
# Allocates nothing on a context that has rendered a sequence as long before; the
# plan is computed per event, never into a vec. Built for hoosh, which streamed a
# copy of this logic (filed 2026-11-11, docs/development/issues/).
#
# Returns the number of samples passed to the sink, or a negative SVARA_ERR_*:
# - before any sample is passed on, what a later event would refuse:
#   SVARA_ERR_INVALID_PHONEME, SVARA_ERR_INVALID_DURATION, SVARA_ERR_INVALID_PITCH
#   for a stressed f0 outside [20, 2000] Hz, and SVARA_ERR_COMPUTATION for a null
#   sink or a phoneme longer than SV_MAX_SAMPLES / 2 samples;
# - mid-stream, what svara_synthctx_synthesize returns for a phoneme it cannot
#   render, or SVARA_ERR_COMPUTATION for a refused allocation. The samples already
#   passed on stand.
# ================================================================
#must_use
fn svara_sequence_render_into(seq, voice, ctx, sink, user) {
    if (sink == 0) { return SVARA_ERR_COMPUTATION; }
    if (svara_sequence_len(seq) == 0) { return 0; }
    #ifdef LOGGING
    var _sp = svara_span_enter("sequence_render_into");
    #endif
    var r = svara_seq_stream(seq, voice, ctx, sink, user);
    #ifdef LOGGING
    svara_span_leave(_sp);
    if (svara_is_err(r) == 1) { var _e = svara_log_err(r); }
    #endif
    return r;
}

# seq_stream -- the body of svara_sequence_render_into, for a non-empty sequence
# and a sink.
#must_use
fn svara_seq_stream(seq, voice, ctx, sink, user) {
    var events = SvPhonemeSequence_events(seq);
    var n = vec_len(events);
    var sr = SvSynthCtx_sample_rate(ctx);
    var min_cf = svara_seq_min_crossfade(seq, sr);
    var f0 = SvVoiceProfile_base_f0(voice);

    # Pass 1: refuse now what a later event would refuse mid-stream, and find the
    # longest fade-in, the furthest any segment reaches back into the output.
    var hold = 0;
    var prev_len = 0;
    var i = 0;
    while (i < n) {
        var e = vec_get(events, i);
        if (svara_phoneme_is_valid(SvPhonemeEvent_phoneme(e)) == 0) { return SVARA_ERR_INVALID_PHONEME; }
        var d = svara_seq_event_duration(e, svara_seq_in_cluster(events, i));
        if (f64_gt(d, 0) == 0) { return SVARA_ERR_INVALID_DURATION; }
        if (svara_is_finite(d) == 0) { return SVARA_ERR_INVALID_DURATION; }
        if (svara_f0_in_range(svara_seq_stress_f0(f0, SvPhonemeEvent_stress(e))) == 0) {
            return SVARA_ERR_INVALID_PITCH;
        }
        var len = svara_count_from_f64(f64_mul(d, sr));
        if (len > SV_MAX_SAMPLES / 2) { return SVARA_ERR_COMPUTATION; }
        if (i > 0) {
            var fl = svara_seq_crossfade_len(events, i - 1, prev_len, len, min_cf);
            if (fl > len) { fl = len; }
            if (fl > hold) { hold = fl; }
        }
        prev_len = len;
        i = i + 1;
    }

    var sv = SvSynthCtx_seq_voice(ctx);
    if (sv == 0) {
        sv = alloc(sizeof(SvVoiceProfile));
        if (sv == 0) { return SVARA_ERR_COMPUTATION; }
        SvSynthCtx_set_seq_voice(ctx, sv);
    }
    var snas = SvSynthCtx_seq_nasal(ctx);
    if (snas == 0) {
        snas = alloc(sizeof(SvNasalization));
        if (snas == 0) { return SVARA_ERR_COMPUTATION; }
        SvSynthCtx_set_seq_nasal(ctx, snas);
    }

    # Pass 2: render each event and crossfade it into the pending output, which
    # holds output[emitted .. emitted + p).
    var p = 0;
    var emitted = 0;
    var cf_prev = 0;
    i = 0;
    while (i < n) {
        var e2 = vec_get(events, i);
        var ph = SvPhonemeEvent_phoneme(e2);
        var ev = svara_voice_copy_into(voice, sv);
        SvVoiceProfile_set_base_f0(ev, svara_seq_stress_f0(f0, SvPhonemeEvent_stress(e2)));
        var nas = 0;
        var c = svara_phoneme_class(ph);
        if (((c == SVARA_CLASS_VOWEL) | (c == SVARA_CLASS_DIPHTHONG)) & ((i + 1) < n)) {
            nas = svara_nasalization_for_nasal_into(SvPhonemeEvent_phoneme(vec_get(events, i + 1)), snas);
        }
        var cnt = svara_synthctx_synthesize(ctx, ph, ev, svara_seq_event_duration(e2, svara_seq_in_cluster(events, i)),
          nas);
        if (svara_is_err(cnt) == 1) { return cnt; }
        var cf_next = 0;
        if (i < n - 1) {
            var dn = svara_seq_event_duration(vec_get(events, i + 1), svara_seq_in_cluster(events, i + 1));
            cf_next = svara_seq_crossfade_len(events, i, cnt, svara_count_from_f64(f64_mul(dn, sr)), min_cf);
        }
        var xf = svara_seq_xf_room(ctx, p, p + cnt);
        if (xf == 0) { return SVARA_ERR_COMPUTATION; }
        p = svara_seq_xf_segment(xf, p, emitted, svara_synthctx_buffer(ctx), cnt, i, n, cf_prev, cf_next);
        var final_end = emitted + p - hold;
        if (i == n - 1) { final_end = emitted + p; }
        if (final_end > emitted) {
            var k = final_end - emitted;
            var sr2 = callptr(sink, user, xf, k);
            var m = k;
            while (m < p) { store64(xf + (m - k) * 8, load64(xf + m * 8)); m = m + 1; }
            p = p - k;
            emitted = final_end;
        }
        cf_prev = cf_next;
        i = i + 1;
    }
    return emitted;
}

# seq_xf_room -- the context's pending buffer with room for `need` samples, its
# first `p` kept across a growth. Grow-only; 0 when the growth is refused.
#must_use
fn svara_seq_xf_room(ctx, p, need) {
    var xf = SvSynthCtx_xf_buf(ctx);
    if (SvSynthCtx_xf_cap(ctx) >= need) { return xf; }
    var grown = svara_alloc_samples(need);
    if (grown == 0) { return 0; }
    var i = 0;
    while (i < p) { store64(grown + i * 8, load64(xf + i * 8)); i = i + 1; }
    SvSynthCtx_set_xf_buf(ctx, grown);
    SvSynthCtx_set_xf_cap(ctx, need);
    return grown;
}

# seq_xf_segment -- crossfade segment i of n (cnt samples at seg) into the pending
# output at xf, which holds the p samples after the `emitted` already passed on.
# It is svara_seq_crossfade's step for one segment, line for line and in the same
# arithmetic, so the two produce the same bits. Returns the new pending count.
# svara_sequence_render_into keeps enough pending that a fade-in never reaches an
# emitted sample.
#must_use
fn svara_seq_xf_segment(xf, p, emitted, seg, cnt, i, n, cf_prev, cf_next) {
    var cfn1 = cf_next;
    if (cfn1 < 1) { cfn1 = 1; }
    if (i == 0) {
        if (cnt > cf_next) {
            var j = 0;
            var stop = cnt - cf_next;
            while (j < stop) { store64(xf + p * 8, load64(seg + j * 8)); p = p + 1; j = j + 1; }
        }
        var fs = cnt - cf_next;
        if (fs < 0) { fs = 0; }
        var k = fs;
        var jj = 0;
        while (k < cnt) {
            var w = f64_sub(F64_ONE, svara_seq_sigmoid_fade(f64_div(f64_from(jj), f64_from(cfn1))));
            store64(xf + p * 8, f64_mul(load64(seg + k * 8), w));
            p = p + 1;
            jj = jj + 1;
            k = k + 1;
        }
        return p;
    }
    var fade_len = cf_prev;
    if (fade_len > cnt) { fade_len = cnt; }
    var fl1 = fade_len;
    if (fl1 < 1) { fl1 = 1; }
    var out_len = emitted + p;
    var j1 = 0;
    while (j1 < fade_len) {
        var idx = out_len - (fade_len - j1);
        if (idx >= 0) {
            var add = f64_mul(load64(seg + j1 * 8), svara_seq_sigmoid_fade(f64_div(f64_from(j1), f64_from(fl1))));
            var at = xf + (idx - emitted) * 8;
            store64(at, f64_add(load64(at), add));
        }
        j1 = j1 + 1;
    }
    if (cnt > fade_len) {
        if ((i < n - 1) & (cnt > fade_len + cf_next)) {
            var m = fade_len;
            var stop2 = cnt - cf_next;
            while (m < stop2) { store64(xf + p * 8, load64(seg + m * 8)); p = p + 1; m = m + 1; }
            var kk = cnt - cf_next;
            var j2 = 0;
            while (kk < cnt) {
                var w2 = f64_sub(F64_ONE, svara_seq_sigmoid_fade(f64_div(f64_from(j2), f64_from(cfn1))));
                store64(xf + p * 8, f64_mul(load64(seg + kk * 8), w2));
                p = p + 1;
                j2 = j2 + 1;
                kk = kk + 1;
            }
        } else {
            var m2 = fade_len;
            while (m2 < cnt) { store64(xf + p * 8, load64(seg + m2 * 8)); p = p + 1; m2 = m2 + 1; }
        }
    }
    return p;
}

# render_planned -- continuous trajectory-planned synthesis (per-sample formant
# updates). Returns a vec<f64>, or a negative SVARA_ERR_*.
#must_use
fn svara_sequence_render_planned(seq, voice, sample_rate) {
    var events = SvPhonemeSequence_events(seq);
    var n = vec_len(events);
    if (n == 0) { return vec_new(); }
    var in_cluster = svara_seq_detect_clusters(events);
    var durs = svara_seq_durations(seq, in_cluster);
    var pl = svara_seq_phoneme_list(seq);
    var pv = 0;
    while (pv < vec_len(pl)) {
        if (svara_phoneme_is_valid(vec_get(pl, pv)) == 0) { return SVARA_ERR_INVALID_PHONEME; }
        pv = pv + 1;
    }
    var nasals = svara_detect_nasalization(pl);

    var plan = svara_trajectory_plan(pl, durs, voice, sample_rate);
    svara_trajectory_apply_speaking_rate(plan, SvPhonemeSequence_speaking_rate(seq));
    var total = svara_trajectory_total_samples(plan);
    if (total == 0) { return vec_new(); }

    # phoneme boundaries in samples
    var boundaries = vec_new();
    vec_push(boundaries, 0);
    var offset = 0;
    var bi = 0;
    while (bi < n) {
        offset = offset + svara_count_from_f64(f64_mul(vec_get(durs, bi), sample_rate));
        vec_push(boundaries, offset);
        bi = bi + 1;
    }

    var glottal = svara_voice_create_glottal_source(voice, sample_rate);
    if (svara_is_err(glottal) == 1) { return SVARA_ERR_ARTICULATION; }
    var tract = svara_tract_new(sample_rate);
    if (svara_is_err(tract) == 1) { return tract; }
    var noise = svara_rng_new(17);
    var out = svara_alloc_samples(total);
    if (out == 0) { return SVARA_ERR_COMPUTATION; }

    # One contour per event, built once. This used to be rebuilt inside the
    # per-sample loop from a value (the event's tone) that only changes at a
    # phoneme boundary -- 240 bytes of never-freed arena per output sample.
    # one reusable interpolated target for the whole render
    var target = svara_vowel_target_new(0, 0, 0, 0, 0);

    var contours = vec_new();
    var ci = 0;
    while (ci < n) {
        var tv = SvPhonemeEvent_tone(vec_get(events, ci));
        if (tv == SVARA_TONE_NONE) { vec_push(contours, 0); }
        else { vec_push(contours, svara_tone_to_contour(tv)); }
        ci = ci + 1;
    }

    var idx = 0;
    var s = 0;
    while (s < total) {
        while (((idx + 1) < n) & (s >= vec_get(boundaries, idx + 1))) { idx = idx + 1; }
        var phoneme = SvPhonemeEvent_phoneme(vec_get(events, idx));
        svara_trajectory_formants_at_into(plan, s, target);

        var nasal = vec_get(nasals, idx);
        if (nasal != 0) {
            var seg_span = vec_get(boundaries, idx + 1) - vec_get(boundaries, idx);
            var onset_off = svara_count_from_f64(f64_mul(f64_from(seg_span), SvNasalization_onset(nasal)));
            var nasal_onset = vec_get(boundaries, idx) + onset_off;
            if (s >= nasal_onset) {
                var nasal_len = vec_get(boundaries, idx + 1) - nasal_onset;
                if (nasal_len < 1) { nasal_len = 1; }
                var nt = f64_div(f64_from(s - nasal_onset), f64_from(nasal_len));
                var nc = f64_mul(SvNasalization_peak_coupling(nasal), ease_in_out_smooth(nt));
                svara_tract_set_nasal_coupling(tract, nc);
                svara_tract_set_nasal_place(tract, SvNasalization_place(nasal));
            } else {
                svara_tract_set_nasal_coupling(tract, 0);
            }
        } else {
            svara_tract_set_nasal_coupling(tract, 0);
        }

        var sfe = svara_tract_set_formants_from_target(tract, target);
        if (svara_is_err(sfe) == 1) { sfe = 0; }   # ignored, like Rust `let _`

        var ev = vec_get(events, idx);
        var st = SvPhonemeEvent_stress(ev);
        var base_f0 = SvVoiceProfile_base_f0(voice);
        if (st == SVARA_STRESS_PRIMARY) { base_f0 = f64_mul(base_f0, 1.10); }
        elif (st == SVARA_STRESS_SECONDARY) { base_f0 = f64_mul(base_f0, 1.05); }
        var effective_f0 = base_f0;
        var contour = vec_get(contours, idx);
        if (contour != 0) {
            var seg_start = vec_get(boundaries, idx);
            var seg_len = vec_get(boundaries, idx + 1) - seg_start;
            if (seg_len < 1) { seg_len = 1; }
            var tt = f64_div(f64_from(s - seg_start), f64_from(seg_len));
            effective_f0 = f64_mul(base_f0, svara_prosody_f0_at(contour, tt));
        }
        var f0e = svara_glottal_set_f0(glottal, effective_f0);
        if (svara_is_err(f0e) == 1) { f0e = 0; }   # ignored, like Rust `let _`

        var c = svara_phoneme_class(phoneme);
        var sample = 0;
        if ((c == SVARA_CLASS_VOWEL) | (c == SVARA_CLASS_DIPHTHONG) | (c == SVARA_CLASS_APPROXIMANT)
          | (c == SVARA_CLASS_LATERAL) | (c == SVARA_CLASS_NASAL) | (c == SVARA_CLASS_IMPLOSIVE)
          | (c == SVARA_CLASS_TRILL)) {
            sample = svara_tract_process_sample(tract, svara_glottal_next_sample(glottal));
        } elif (c == SVARA_CLASS_FRICATIVE) {
            var nz = f64_mul(svara_rng_next_f32(noise), F64_HALF);
            if (svara_phoneme_is_voiced(phoneme) == 1) {
                var voicing = f64_mul(svara_tract_process_sample(tract, svara_glottal_next_sample(glottal)), SV_PH_R04);
                sample = f64_add(f64_mul(nz, SV_PH_R06), voicing);
            } else {
                sample = f64_mul(nz, SV_PH_R06);
            }
        } elif ((c == SVARA_CLASS_PLOSIVE) | (c == SVARA_CLASS_AFFRICATE)
          | (c == SVARA_CLASS_CLICK) | (c == SVARA_CLASS_EJECTIVE)) {
            var span = vec_get(boundaries, idx + 1) - vec_get(boundaries, idx);
            if (span < 1) { span = 1; }
            var bf = f64_div(f64_from(s - vec_get(boundaries, idx)), f64_from(span));
            if (f64_lt(bf, SV_PH_R04) == 1) {
                sample = 0;
            } else {
                sample = f64_mul(f64_mul(svara_rng_next_f32(noise), f64_sub(F64_ONE, bf)), F64_HALF);
            }
        }
        store64(out + s * 8, sample);
        s = s + 1;
    }

    # global attack/release envelope: ramp = clamp(total/20, 1, 256)
    var ramp = total / 20;
    if (ramp < 1) { ramp = 1; }
    if (ramp > 256) { ramp = 256; }
    var a = 0;
    while (a < ramp) {
        var e1 = ease_in_out_smooth(f64_div(f64_from(a), f64_from(ramp)));
        store64(out + a * 8, f64_mul(load64(out + a * 8), e1));
        a = a + 1;
    }
    var b = 0;
    while (b < ramp) {
        var ridx = total - 1 - b;
        var e2 = ease_in_out_smooth(f64_div(f64_from(b), f64_from(ramp)));
        store64(out + ridx * 8, f64_mul(load64(out + ridx * 8), e2));
        b = b + 1;
    }
    return svara_ph_buf_to_vec(out, total);
}
