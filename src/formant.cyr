# formant.cyr -- formant filtering + vowel target definitions.
# Ports rust-old/src/formant.rs. Formants are vocal-tract resonances; this is
# a parallel bank of bandpass biquad resonators (Peterson&Barney / Hillenbrand
# 1995 vowel data). f32 -> f64 throughout (Rust computed coeffs in f64 then
# truncated to f32; the port keeps f64 end-to-end -- strictly more precise,
# within tolerance parity). Self-contained: NO naad dependency (the SOA bank is
# svara's own topology, not naad's BiquadFilter). Requires stdlib math/ganita
# (F64_*, f64_cos/sin builtins, f64_sinh, f64_clamp/lerp) + error.cyr.
#
# Cyrius structs have no array fields, so BiquadBankSoa's nine [f32; 8] arrays
# become nine raw f64 buffers (SVARA_MAX_FORMANTS slots each) held as struct
# fields; the hot loop indexes them with load64/store64. Formant and VowelTarget
# derive Serialize; a FormantFilter is rebuilt from its formants (ADR-0002).

var SVARA_MAX_FORMANTS = 8;   # fixed bank width (unused slots zeroed)
# A vowel target carries exactly five formants (F1-F5). Any destination vec
# handed to svara_vowel_target_to_formants_into MUST hold at least this many
# slots -- that function writes five unconditionally.
var SVARA_VOWEL_FORMANT_COUNT = 5;

# Default formant amplitudes F1..F5 (linear) for the parallel bank.
var SVARA_AMP_0 = 0x3FF0000000000000;   # 1.0
var SVARA_AMP_1 = 0x3FE999999999999A;   # 0.8
var SVARA_AMP_2 = 0x3FE0000000000000;   # 0.5
var SVARA_AMP_3 = 0x3FD3333333333333;   # 0.3
var SVARA_AMP_4 = 0x3FC999999999999A;   # 0.2

# ================================================================
# Formant -- a single resonance spec (frequency, bandwidth, amplitude in Hz/Hz/linear).
# ================================================================
#derive(accessors)
#derive(Serialize)
struct SvFormant { frequency: f64; bandwidth: f64; amplitude: f64; }

# formant_new -- center frequency (Hz), bandwidth (Hz), linear amplitude. Stored as given:
# svara_formant_filter_new is what validates them.
#must_use
fn svara_formant_new(frequency, bandwidth, amplitude) {
    var self = alloc(sizeof(SvFormant));
    SvFormant_set_frequency(self, frequency);
    SvFormant_set_bandwidth(self, bandwidth);
    SvFormant_set_amplitude(self, amplitude);
    return self;
}

# ================================================================
# Vowel categories (was `enum Vowel`) -> integer constants.
# ================================================================
var SVARA_VOWEL_A     = 0;   # /a/ open front unrounded
var SVARA_VOWEL_E     = 1;   # /e/ close-mid front unrounded
var SVARA_VOWEL_I     = 2;   # /i/ close front unrounded
var SVARA_VOWEL_O     = 3;   # /o/ close-mid back rounded
var SVARA_VOWEL_U     = 4;   # /u/ close back rounded
var SVARA_VOWEL_SCHWA = 5;   # schwa mid central
var SVARA_VOWEL_OPENO = 6;   # open-O open-mid back rounded
var SVARA_VOWEL_ASH   = 7;   # near-open front
var SVARA_VOWEL_NEARI = 8;   # near-close near-front
var SVARA_VOWEL_NEARU = 9;   # near-close near-back

# ================================================================
# VowelTarget -- F1..F5 frequencies + B1..B5 bandwidths (Hz).
# ================================================================
#derive(accessors)
#derive(Serialize)
struct SvVowelTarget {
    f1: f64; f2: f64; f3: f64; f4: f64; f5: f64;
    b1: f64; b2: f64; b3: f64; b4: f64; b5: f64;
}

# with_bandwidths -- explicit frequencies and bandwidths.
#must_use
fn svara_vowel_target_with_bandwidths(f1, f2, f3, f4, f5, b1, b2, b3, b4, b5) {
    return svara_vowel_target_set(alloc(sizeof(SvVowelTarget)), f1, f2, f3, f4, f5, b1, b2, b3, b4, b5);
}

# set -- overwrite all ten components of `dst` and return it. The one place a
# VowelTarget's fields are written from values, so an allocating constructor and
# its `_into` form produce the same bits by construction.
#must_use
fn svara_vowel_target_set(dst, f1, f2, f3, f4, f5, b1, b2, b3, b4, b5) {
    SvVowelTarget_set_f1(dst, f1);
    SvVowelTarget_set_f2(dst, f2);
    SvVowelTarget_set_f3(dst, f3);
    SvVowelTarget_set_f4(dst, f4);
    SvVowelTarget_set_f5(dst, f5);
    SvVowelTarget_set_b1(dst, b1);
    SvVowelTarget_set_b2(dst, b2);
    SvVowelTarget_set_b3(dst, b3);
    SvVowelTarget_set_b4(dst, b4);
    SvVowelTarget_set_b5(dst, b5);
    return dst;
}

# new -- frequencies with default bandwidths [60, 80, 100, 120, 140] Hz.
#must_use
fn svara_vowel_target_new(f1, f2, f3, f4, f5) {
    return svara_vowel_target_with_bandwidths(f1, f2, f3, f4, f5,
      f64_from(60), f64_from(80), f64_from(100), f64_from(120), f64_from(140));
}

# from_vowel -- Hillenbrand et al. (1995) male averages, per-vowel bandwidths.
#must_use
fn svara_vowel_target_from_vowel(vowel) {
    return svara_vowel_target_from_vowel_into(vowel, alloc(sizeof(SvVowelTarget)));
}

# from_vowel_into -- as from_vowel, written into `dst`, which it returns. For a
# caller that keeps one target and retargets it, such as a synthesis context.
#must_use
fn svara_vowel_target_from_vowel_into(vowel, dst) {
    if (vowel == SVARA_VOWEL_A) {
        return svara_vowel_target_set(dst,
          f64_from(768), f64_from(1333), f64_from(2522), f64_from(3300), f64_from(3750),
          f64_from(90), f64_from(100), f64_from(120), f64_from(140), f64_from(160));
    }
    if (vowel == SVARA_VOWEL_E) {
        return svara_vowel_target_set(dst,
          f64_from(476), f64_from(2089), f64_from(2691), f64_from(3300), f64_from(3750),
          f64_from(55), f64_from(80), f64_from(100), f64_from(120), f64_from(140));
    }
    if (vowel == SVARA_VOWEL_I) {
        return svara_vowel_target_set(dst,
          f64_from(342), f64_from(2322), f64_from(3000), f64_from(3657), f64_from(3750),
          f64_from(40), f64_from(70), f64_from(90), f64_from(120), f64_from(140));
    }
    if (vowel == SVARA_VOWEL_O) {
        return svara_vowel_target_set(dst,
          f64_from(497), f64_from(910), f64_from(2459), f64_from(3300), f64_from(3750),
          f64_from(65), f64_from(70), f64_from(100), f64_from(120), f64_from(140));
    }
    if (vowel == SVARA_VOWEL_U) {
        return svara_vowel_target_set(dst,
          f64_from(378), f64_from(997), f64_from(2343), f64_from(3300), f64_from(3750),
          f64_from(45), f64_from(65), f64_from(90), f64_from(120), f64_from(140));
    }
    if (vowel == SVARA_VOWEL_SCHWA) {
        return svara_vowel_target_set(dst,
          f64_from(523), f64_from(1588), f64_from(2469), f64_from(3300), f64_from(3750),
          f64_from(60), f64_from(80), f64_from(100), f64_from(120), f64_from(140));
    }
    if (vowel == SVARA_VOWEL_OPENO) {
        return svara_vowel_target_set(dst,
          f64_from(652), f64_from(997), f64_from(2538), f64_from(3300), f64_from(3750),
          f64_from(80), f64_from(75), f64_from(110), f64_from(130), f64_from(150));
    }
    if (vowel == SVARA_VOWEL_ASH) {
        return svara_vowel_target_set(dst,
          f64_from(669), f64_from(1880), f64_from(2489), f64_from(3300), f64_from(3750),
          f64_from(80), f64_from(90), f64_from(110), f64_from(130), f64_from(150));
    }
    if (vowel == SVARA_VOWEL_NEARI) {
        return svara_vowel_target_set(dst,
          f64_from(427), f64_from(2034), f64_from(2684), f64_from(3300), f64_from(3750),
          f64_from(50), f64_from(75), f64_from(95), f64_from(120), f64_from(140));
    }
    # SVARA_VOWEL_NEARU (default arm)
    return svara_vowel_target_set(dst,
      f64_from(469), f64_from(1122), f64_from(2434), f64_from(3300), f64_from(3750),
      f64_from(55), f64_from(70), f64_from(95), f64_from(120), f64_from(140));
}

# to_formants -- vec of 5 Formant pointers (F1..F5) with default amplitudes.
#must_use
fn svara_vowel_target_to_formants(self) {
    var out = svara_formant_scratch_vec();
    svara_vowel_target_to_formants_into(self, out);
    return out;
}

# to_formants_into -- overwrite five existing SvFormant structs in `out` from
# this target, instead of allocating a fresh vec of five. Same values as
# svara_vowel_target_to_formants; `out` must already hold >= 5 SvFormant
# pointers (svara_formant_scratch_vec builds one).
fn svara_vowel_target_to_formants_into(self, out) {
    var f1 = vec_get(out, 0);
    SvFormant_set_frequency(f1, SvVowelTarget_f1(self));
    SvFormant_set_bandwidth(f1, SvVowelTarget_b1(self));
    SvFormant_set_amplitude(f1, SVARA_AMP_0);
    var f2 = vec_get(out, 1);
    SvFormant_set_frequency(f2, SvVowelTarget_f2(self));
    SvFormant_set_bandwidth(f2, SvVowelTarget_b2(self));
    SvFormant_set_amplitude(f2, SVARA_AMP_1);
    var f3 = vec_get(out, 2);
    SvFormant_set_frequency(f3, SvVowelTarget_f3(self));
    SvFormant_set_bandwidth(f3, SvVowelTarget_b3(self));
    SvFormant_set_amplitude(f3, SVARA_AMP_2);
    var f4 = vec_get(out, 3);
    SvFormant_set_frequency(f4, SvVowelTarget_f4(self));
    SvFormant_set_bandwidth(f4, SvVowelTarget_b4(self));
    SvFormant_set_amplitude(f4, SVARA_AMP_3);
    var f5 = vec_get(out, 4);
    SvFormant_set_frequency(f5, SvVowelTarget_f5(self));
    SvFormant_set_bandwidth(f5, SvVowelTarget_b5(self));
    SvFormant_set_amplitude(f5, SVARA_AMP_4);
}

# formant_scratch_vec -- a reusable vec of five zeroed SvFormant structs, for
# callers that refresh formants every sample and must not allocate to do it.
#must_use
fn svara_formant_scratch_vec() {
    var v = vec_new();
    var i = 0;
    while (i < SVARA_VOWEL_FORMANT_COUNT) { vec_push(v, svara_formant_new(0, 0, 0)); i = i + 1; }
    return v;
}

# copy_into -- overwrite all ten components of `dst` from `src`.
fn svara_vowel_target_copy_into(src, dst) {
    SvVowelTarget_set_f1(dst, SvVowelTarget_f1(src));
    SvVowelTarget_set_f2(dst, SvVowelTarget_f2(src));
    SvVowelTarget_set_f3(dst, SvVowelTarget_f3(src));
    SvVowelTarget_set_f4(dst, SvVowelTarget_f4(src));
    SvVowelTarget_set_f5(dst, SvVowelTarget_f5(src));
    SvVowelTarget_set_b1(dst, SvVowelTarget_b1(src));
    SvVowelTarget_set_b2(dst, SvVowelTarget_b2(src));
    SvVowelTarget_set_b3(dst, SvVowelTarget_b3(src));
    SvVowelTarget_set_b4(dst, SvVowelTarget_b4(src));
    SvVowelTarget_set_b5(dst, SvVowelTarget_b5(src));
}

# interpolate_into -- svara_vowel_target_interpolate writing into an existing
# target. Identical arithmetic; `out` may alias `from` or `to` only if the
# caller does not need the original afterwards (each component is read before
# it is written, so aliasing is in fact safe component-by-component).
fn svara_vowel_target_interpolate_into(from, to, t, out) {
    var tc = f64_clamp(t, 0, F64_ONE);
    SvVowelTarget_set_f1(out, f64_lerp(SvVowelTarget_f1(from), SvVowelTarget_f1(to), tc));
    SvVowelTarget_set_f2(out, f64_lerp(SvVowelTarget_f2(from), SvVowelTarget_f2(to), tc));
    SvVowelTarget_set_f3(out, f64_lerp(SvVowelTarget_f3(from), SvVowelTarget_f3(to), tc));
    SvVowelTarget_set_f4(out, f64_lerp(SvVowelTarget_f4(from), SvVowelTarget_f4(to), tc));
    SvVowelTarget_set_f5(out, f64_lerp(SvVowelTarget_f5(from), SvVowelTarget_f5(to), tc));
    SvVowelTarget_set_b1(out, f64_lerp(SvVowelTarget_b1(from), SvVowelTarget_b1(to), tc));
    SvVowelTarget_set_b2(out, f64_lerp(SvVowelTarget_b2(from), SvVowelTarget_b2(to), tc));
    SvVowelTarget_set_b3(out, f64_lerp(SvVowelTarget_b3(from), SvVowelTarget_b3(to), tc));
    SvVowelTarget_set_b4(out, f64_lerp(SvVowelTarget_b4(from), SvVowelTarget_b4(to), tc));
    SvVowelTarget_set_b5(out, f64_lerp(SvVowelTarget_b5(from), SvVowelTarget_b5(to), tc));
}

# interpolate -- linear blend of two targets; t clamped to [0, 1].
#must_use
fn svara_vowel_target_interpolate(from, to, t) {
    var r = alloc(sizeof(SvVowelTarget));
    svara_vowel_target_interpolate_into(from, to, t, r);
    return r;
}

# ================================================================
# biquad_coefficients -- bandpass biquad, computed in f64. Writes b0,b2,a1,a2
# into `out` (4 f64 slots). b1 == 0 for bandpass, b2 == -b0.
# ================================================================
fn svara_formant_biquad_coeffs(frequency, bandwidth, sample_rate, out) {
    var omega = f64_div(f64_mul(F64_TAU, frequency), sample_rate);
    var bw_omega = f64_div(f64_mul(F64_TAU, bandwidth), sample_rate);
    svara_formant_biquad_from_trig(f64_cos(omega), f64_sin(omega), f64_sinh(f64_mul(bw_omega, F64_HALF)), out);
}

# biquad_from_trig -- the four coefficients from cos(omega), sin(omega) and
# sinh(bw_omega / 2), the three transcendentals svara_formant_biquad_coeffs
# takes. The one place the coefficient arithmetic is written, so a coefficient
# from memoized trig and one computed afresh are the same bits.
fn svara_formant_biquad_from_trig(cos_omega, sin_omega, sinh_half, out) {
    var alpha = f64_mul(sin_omega, sinh_half);
    var a0 = f64_add(F64_ONE, alpha);
    store64(out,      f64_div(alpha, a0));                                    # b0
    store64(out + 8,  f64_div(f64_neg(alpha), a0));                           # b2
    store64(out + 16, f64_div(f64_mul(f64_neg(F64_TWO), cos_omega), a0));     # a1
    store64(out + 24, f64_div(f64_sub(F64_ONE, alpha), a0));                  # a2
}

# ================================================================
# BiquadBankSoa -- SOA bank of MAX_FORMANTS bandpass biquads. Nine f64 buffers
# (b0/b2/a1/a2/amp = coeffs+weight, x1/x2/y1/y2 = delay lines) + active count.
# ================================================================
#derive(accessors)
# `coeff` is a 4-slot scratch owned by the bank: svara_formant_biquad_coeffs
# writes through a pointer, and allocating those 32 bytes per call leaked into
# a bump arena that never frees (see the note on svara_tract_set_formants).
#
# `xin1`/`xin2` are SCALARS, not per-slot buffers, and that is the point. All
# eight biquads are driven by the SAME input sample, so `x1[i] = input` and
# `x2[i] = previous input` held identical values in every slot -- 16 bytes of
# state doing the work of 2, and 32 memory operations per sample doing the work
# of 3. Measured before changing it: over 4096 samples of real signal, 28,672
# cross-slot comparisons found ZERO divergence in x1 or x2, while y1 (which is
# genuinely per-slot) differed as expected. The y-side delay lines stay per-slot
# because each resonator has its own output history.
#
# ⚠ `SvFormantBank_x1` / `_x2` are gone with them. They were derived accessors
# on an internal delay line; nothing outside this module read them.
# `trig` memoizes each slot's transcendentals (3.8.1). Its 64-byte record per
# slot is frequency, sample rate, cos, sin (keyed on the first two), then
# bandwidth, sample rate, sinh (keyed on those), then a word of flags: bit 0
# when the first group is set, bit 1 when the second is. cos, sin and sinh are
# 1,519 of the 1,533 instructions a coefficient set costs, and render_planned
# rebuilds the bank every sample, while a slot's frequency repeats on about half
# of those samples and its bandwidth on a third to three quarters. The keys are
# compared as raw bits, so a hit gives exactly the value a recomputation would.
struct SvFormantBank { b0; b2; a1; a2; amp; xin1; xin2; y1; y2; count; coeff; trig; }

# zero a buffer of `n` f64 slots (bump alloc is not zeroed).
fn svara_formant_zero_buf(buf, n) {
    var i = 0;
    while (i < n) { store64(buf + i * 8, 0); i = i + 1; }
}

# bank_new -- build from a vec of Formant pointers.
#must_use
fn svara_formant_bank_new(formants, sample_rate) {
    var self = alloc(sizeof(SvFormantBank));
    var nbytes = SVARA_MAX_FORMANTS * 8;
    var b0 = alloc(nbytes); var b2 = alloc(nbytes); var a1 = alloc(nbytes);
    var a2 = alloc(nbytes); var amp = alloc(nbytes);
    var y1 = alloc(nbytes); var y2 = alloc(nbytes);
    svara_formant_zero_buf(b0, SVARA_MAX_FORMANTS); svara_formant_zero_buf(b2, SVARA_MAX_FORMANTS);
    svara_formant_zero_buf(a1, SVARA_MAX_FORMANTS); svara_formant_zero_buf(a2, SVARA_MAX_FORMANTS);
    svara_formant_zero_buf(amp, SVARA_MAX_FORMANTS);
    svara_formant_zero_buf(y1, SVARA_MAX_FORMANTS); svara_formant_zero_buf(y2, SVARA_MAX_FORMANTS);
    SvFormantBank_set_b0(self, b0); SvFormantBank_set_b2(self, b2);
    SvFormantBank_set_a1(self, a1); SvFormantBank_set_a2(self, a2);
    SvFormantBank_set_amp(self, amp);
    SvFormantBank_set_xin1(self, 0); SvFormantBank_set_xin2(self, 0);
    SvFormantBank_set_y1(self, y1); SvFormantBank_set_y2(self, y2);

    var n = vec_len(formants);
    if (n > SVARA_MAX_FORMANTS) { n = SVARA_MAX_FORMANTS; }
    SvFormantBank_set_count(self, n);

    var coeff = alloc(32);
    SvFormantBank_set_coeff(self, coeff);
    var trig = alloc(SVARA_MAX_FORMANTS * 64);
    svara_formant_zero_buf(trig, SVARA_MAX_FORMANTS * 8);
    SvFormantBank_set_trig(self, trig);
    var i = 0;
    while (i < n) {
        var f = vec_get(formants, i);
        svara_formant_bank_coeffs(self, i, SvFormant_frequency(f), SvFormant_bandwidth(f), sample_rate, coeff);
        store64(b0 + i * 8, load64(coeff));
        store64(b2 + i * 8, load64(coeff + 8));
        store64(a1 + i * 8, load64(coeff + 16));
        store64(a2 + i * 8, load64(coeff + 24));
        store64(amp + i * 8, SvFormant_amplitude(f));
        i = i + 1;
    }
    return self;
}

# bank_coeffs -- slot i's four coefficients into `out`, as svara_formant_biquad_coeffs
# computes them, taking cos and sin, and sinh, from the slot's memo when their keys
# match bit for bit (see SvFormantBank's `trig`). `i` must be inside the bank.
fn svara_formant_bank_coeffs(self, i, frequency, bandwidth, sample_rate, out) {
    var t = SvFormantBank_trig(self) + i * 64;
    var flags = load64(t + 56);
    var hit_f = 0;
    if ((flags & 1) == 1) {
        if ((load64(t) == frequency) & (load64(t + 8) == sample_rate)) { hit_f = 1; }
    }
    if (hit_f == 0) {
        var omega = f64_div(f64_mul(F64_TAU, frequency), sample_rate);
        store64(t, frequency);
        store64(t + 8, sample_rate);
        store64(t + 16, f64_cos(omega));
        store64(t + 24, f64_sin(omega));
        flags = flags | 1;
    }
    var hit_b = 0;
    if ((flags & 2) == 2) {
        if ((load64(t + 32) == bandwidth) & (load64(t + 40) == sample_rate)) { hit_b = 1; }
    }
    if (hit_b == 0) {
        var bw_omega = f64_div(f64_mul(F64_TAU, bandwidth), sample_rate);
        store64(t + 32, bandwidth);
        store64(t + 40, sample_rate);
        store64(t + 48, f64_sinh(f64_mul(bw_omega, F64_HALF)));
        flags = flags | 2;
    }
    store64(t + 56, flags);
    svara_formant_biquad_from_trig(load64(t + 16), load64(t + 24), load64(t + 48), out);
}

# bank_update -- recompute coefficients for slot `i` without resetting state.
# Returns SVARA_ERR_INVALID_FORMANT, writing nothing, for a slot outside the bank.
# Rust indexes fixed [f32; 8] arrays here and panics; an unchecked store64 would
# write into the neighbouring buffer instead.
fn svara_formant_bank_update(self, i, frequency, bandwidth, amplitude, sample_rate) {
    if ((i < 0) | (i >= SVARA_MAX_FORMANTS)) { return SVARA_ERR_INVALID_FORMANT; }
    var coeff = SvFormantBank_coeff(self);
    svara_formant_bank_coeffs(self, i, frequency, bandwidth, sample_rate, coeff);
    var off = i * 8;
    store64(SvFormantBank_b0(self) + off, load64(coeff));
    store64(SvFormantBank_b2(self) + off, load64(coeff + 8));
    store64(SvFormantBank_a1(self) + off, load64(coeff + 16));
    store64(SvFormantBank_a2(self) + off, load64(coeff + 24));
    store64(SvFormantBank_amp(self) + off, amplitude);
    return SVARA_ERR_NONE;
}

# bank_process -- one input sample through all MAX_FORMANTS slots -> weighted sum.
# Unused slots (count..MAX) have zeroed coeffs -> contribute nothing.
fn svara_formant_bank_process(self, input) {
    var b0 = SvFormantBank_b0(self); var b2 = SvFormantBank_b2(self);
    var a1 = SvFormantBank_a1(self); var a2 = SvFormantBank_a2(self);
    var amp = SvFormantBank_amp(self);
    var y1 = SvFormantBank_y1(self); var y2 = SvFormantBank_y2(self);
    # The input delay is shared by all eight biquads, so it is read once here
    # rather than re-loaded per slot, and advanced once after the loop. Same
    # arithmetic as the per-slot form -- x2i was identical in every slot.
    var x2v = SvFormantBank_xin2(self);
    var sum = 0;
    var i = 0;
    while (i < SVARA_MAX_FORMANTS) {
        var off = i * 8;
        var y1i = load64(y1 + off); var y2i = load64(y2 + off);
        # y = b0*input + b2*x2 - a1*y1 - a2*y2
        var y = f64_sub(f64_sub(f64_add(f64_mul(load64(b0 + off), input), f64_mul(load64(b2 + off), x2v)),
            f64_mul(load64(a1 + off), y1i)),
          f64_mul(load64(a2 + off), y2i));
        store64(y2 + off, y1i);
        store64(y1 + off, y);
        sum = f64_add(sum, f64_mul(y, load64(amp + off)));
        i = i + 1;
    }
    SvFormantBank_set_xin2(self, SvFormantBank_xin1(self));
    SvFormantBank_set_xin1(self, input);
    return sum;
}

# bank_reset -- clear the delay lines (keep coefficients).
fn svara_formant_bank_reset(self) {
    SvFormantBank_set_xin1(self, 0);
    SvFormantBank_set_xin2(self, 0);
    svara_formant_zero_buf(SvFormantBank_y1(self), SVARA_MAX_FORMANTS);
    svara_formant_zero_buf(SvFormantBank_y2(self), SVARA_MAX_FORMANTS);
}

# ================================================================
# DcBlocker -- one-pole DC-blocking high-pass: y = x - x_prev + alpha*y_prev,
# alpha for ~20 Hz cutoff. Removes DC drift from the parallel biquads.
# ================================================================
#derive(accessors)
struct SvDcBlocker { alpha; x_prev; y_prev; }

# dc_blocker_new -- one-pole DC blocker with its corner near 20 Hz at `sample_rate`.
#must_use
fn svara_dc_blocker_new(sample_rate) {
    var self = alloc(sizeof(SvDcBlocker));
    # alpha = 1 - (TAU * 20 / sample_rate)
    SvDcBlocker_set_alpha(self, f64_sub(F64_ONE, f64_div(f64_mul(F64_TAU, f64_from(20)), sample_rate)));
    SvDcBlocker_set_x_prev(self, 0);
    SvDcBlocker_set_y_prev(self, 0);
    return self;
}

# Process one sample through the DC blocker (removes the 0 Hz offset); returns the filtered sample.
fn svara_dc_blocker_process(self, input) {
    # output = input - x_prev + alpha * y_prev
    var output = f64_add(f64_sub(input, SvDcBlocker_x_prev(self)),
      f64_mul(SvDcBlocker_alpha(self), SvDcBlocker_y_prev(self)));
    SvDcBlocker_set_x_prev(self, input);
    SvDcBlocker_set_y_prev(self, output);
    return output;
}

# dc_blocker_reset -- clear the DC-blocker's one-sample history to silence.
fn svara_dc_blocker_reset(self) {
    SvDcBlocker_set_x_prev(self, 0);
    SvDcBlocker_set_y_prev(self, 0);
}

# ================================================================
# FormantFilter -- parallel biquad bank + DC blocker. new() returns a pointer
# on success or a negative SVARA_ERR_* code (Result -> code/sentinel).
# ================================================================
#derive(accessors)
struct SvFormantFilter { bank; dc; sample_rate; }

# The coefficients take sinh(pi * bw / sr), as svara_formant_biquad_coeffs forms
# it. sinh overflows f64 a little above 710.47, and from there every coefficient is
# NaN. Below 700 it cannot overflow, so a bandwidth up to 222 x the sample rate
# (pi * 222 = 697.4) needs no further test.
var SV_F_BW_SAFE = 0x406BC00000000000;     # 222.0, bandwidth per Hz of sample rate
var SV_F_SINH_SAFE = 0x4085E00000000000;   # 700.0
var SV_F_DBL_MAX = 0x7FEFFFFFFFFFFFFF;     # f64::MAX

# bw_overflows -- 1 if `bandwidth` at `sample_rate` makes the bandpass
# coefficients non-finite, 0 otherwise. It forms the argument exactly as
# svara_formant_biquad_coeffs does and asks the same f64_sinh, so it refuses at
# the bound that function has, not at a constant derived beside it.
# ADR-0010 decides this; Rust has no bound and renders NaN.
#must_use
fn svara_formant_bw_overflows(bandwidth, sample_rate) {
    var bw_omega = f64_div(f64_mul(F64_TAU, bandwidth), sample_rate);
    var half = f64_mul(bw_omega, F64_HALF);
    if (f64_gt(half, SV_F_SINH_SAFE) == 0) { return 0; }
    if (svara_is_finite(f64_sinh(half)) == 1) { return 0; }
    return 1;
}

# validate -- SVARA_ERR_NONE if `formants` can build a bank at `sample_rate`.
# Shared by new() and rebuild() so both accept exactly the same inputs.
#
# DELIBERATE DIVERGENCE from the oracle, decided in
# docs/adr/0007-reject-nan-formant-parameters.md. Rust's
# `f.frequency <= 0.0 || f.frequency >= nyquist` (rust-old/src/formant.rs:479-486)
# is FALSE for NaN, so Rust ACCEPTS a NaN formant frequency and silently
# produces NaN coefficients and NaN audio. svara rejects it: this was the one
# place left that did not follow ADR-0001's own rule -- "reject NaN positively,
# never by negating a range test" -- and silent NaN output is precisely the
# failure mode that ADR exists to prevent.
#must_use
fn svara_formant_validate(formants, sample_rate) {
    if (f64_le(sample_rate, 0) == 1) { return SVARA_ERR_INVALID_FORMANT; }
    if (svara_is_finite(sample_rate) == 0) { return SVARA_ERR_INVALID_FORMANT; }
    var n = vec_len(formants);
    if (n == 0) { return SVARA_ERR_INVALID_FORMANT; }
    if (n > SVARA_MAX_FORMANTS) { return SVARA_ERR_INVALID_FORMANT; }
    var nyquist = f64_mul(sample_rate, F64_HALF);
    # Capped at f64::MAX so that +inf always exceeds it, whatever the sample rate.
    var bw_safe = f64_min(f64_mul(sample_rate, SV_F_BW_SAFE), SV_F_DBL_MAX);
    var i = 0;
    while (i < n) {
        var f = vec_get(formants, i);
        var e = svara_formant_check(SvFormant_frequency(f), SvFormant_bandwidth(f), sample_rate, nyquist, bw_safe);
        if (e != SVARA_ERR_NONE) { return e; }
        i = i + 1;
    }
    return SVARA_ERR_NONE;
}

# check -- svara_formant_validate's test of one formant, given the sample rate's
# nyquist and bw_safe. The one place it is written, so a vec of formants and a
# VowelTarget are validated the same way.
#must_use
fn svara_formant_check(freq, bw, sample_rate, nyquist, bw_safe) {
    # Tested POSITIVELY so NaN falls through to the reject: f64_gt and
    # f64_lt are both false for NaN, so `if (freq <= 0) reject` would let it
    # past. Same shape as svara_f0_in_range.
    var freq_ok = 0;
    if ((f64_gt(freq, 0) == 1) & (f64_lt(freq, nyquist) == 1)) { freq_ok = 1; }
    if (freq_ok == 0) { return SVARA_ERR_INVALID_FORMANT; }
    if (f64_gt(bw, 0) == 0) { return SVARA_ERR_INVALID_FORMANT; }
    # Every bandwidth that can fail from here exceeds bw_safe, so an ordinary
    # one costs this one comparison. ADR-0007 rejects non-finite bandwidths:
    # +inf passed the test above, and every sample came out NaN from a filter
    # that had returned Ok. ADR-0010 rejects a finite bandwidth whose
    # coefficients overflow, which did the same.
    if (f64_gt(bw, bw_safe) == 1) {
        if (svara_is_finite(bw) == 0) { return SVARA_ERR_INVALID_FORMANT; }
        if (svara_formant_bw_overflows(bw, sample_rate) == 1) { return SVARA_ERR_INVALID_FORMANT; }
    }
    return SVARA_ERR_NONE;
}

# validate_target -- svara_formant_validate for the five formants
# svara_vowel_target_to_formants would build from `target`, without building them.
#must_use
fn svara_formant_validate_target(target, sample_rate) {
    if (f64_le(sample_rate, 0) == 1) { return SVARA_ERR_INVALID_FORMANT; }
    if (svara_is_finite(sample_rate) == 0) { return SVARA_ERR_INVALID_FORMANT; }
    var ny = f64_mul(sample_rate, F64_HALF);
    var bs = f64_min(f64_mul(sample_rate, SV_F_BW_SAFE), SV_F_DBL_MAX);
    var e = svara_formant_check(SvVowelTarget_f1(target), SvVowelTarget_b1(target), sample_rate, ny, bs);
    if (e != SVARA_ERR_NONE) { return e; }
    e = svara_formant_check(SvVowelTarget_f2(target), SvVowelTarget_b2(target), sample_rate, ny, bs);
    if (e != SVARA_ERR_NONE) { return e; }
    e = svara_formant_check(SvVowelTarget_f3(target), SvVowelTarget_b3(target), sample_rate, ny, bs);
    if (e != SVARA_ERR_NONE) { return e; }
    e = svara_formant_check(SvVowelTarget_f4(target), SvVowelTarget_b4(target), sample_rate, ny, bs);
    if (e != SVARA_ERR_NONE) { return e; }
    return svara_formant_check(SvVowelTarget_f5(target), SvVowelTarget_b5(target), sample_rate, ny, bs);
}

# new -- validate then build. Errors: SVARA_ERR_INVALID_FORMANT.
#must_use
fn svara_formant_filter_new(formants, sample_rate) {
    var v = svara_formant_validate(formants, sample_rate);
    if (svara_is_err(v) == 1) { return v; }
    var self = alloc(sizeof(SvFormantFilter));
    SvFormantFilter_set_bank(self, svara_formant_bank_new(formants, sample_rate));
    SvFormantFilter_set_dc(self, svara_dc_blocker_new(sample_rate));
    SvFormantFilter_set_sample_rate(self, sample_rate);
    return self;
}

# rebuild -- put this filter into exactly the state svara_formant_filter_new
# would have produced for `formants`, reusing the storage already allocated.
#
# Rust writes `self.filter = FormantFilter::new(formants, self.sample_rate)?`,
# which DISCARDS the delay lines. That is the behaviour being reproduced --
# every slot is zeroed and the DC blocker is reset, so the output is identical
# to a fresh filter; only the allocation is saved. Validation runs BEFORE any
# mutation, so a rejected call leaves the filter untouched, as the Rust `?` does.
#
# Distinct from svara_formant_filter_update, which PRESERVES state and is the
# port of Rust's `update_formants`.
#must_use
fn svara_formant_filter_rebuild(self, formants) {
    var v = svara_formant_validate(formants, SvFormantFilter_sample_rate(self));
    if (svara_is_err(v) == 1) { return v; }
    svara_formant_filter_rebuild_valid(self, formants);
    return SVARA_ERR_NONE;
}

# rebuild_valid -- the body of svara_formant_filter_rebuild, for `formants` the
# caller has already validated at this filter's sample rate. For a caller that
# validated something cheaper first, such as svara_tract_set_formants_from_target.
fn svara_formant_filter_rebuild_valid(self, formants) {
    var sample_rate = SvFormantFilter_sample_rate(self);
    var bank = SvFormantFilter_bank(self);
    var n = vec_len(formants);
    # Zero only the slots the update loop below does not write. It runs once per
    # sample on the trajectory path, and zeroing all eight cost 5n stores for
    # values overwritten straight after.
    var z = n * 8;
    var rest = SVARA_MAX_FORMANTS - n;
    svara_formant_zero_buf(SvFormantBank_b0(bank) + z, rest);
    svara_formant_zero_buf(SvFormantBank_b2(bank) + z, rest);
    svara_formant_zero_buf(SvFormantBank_a1(bank) + z, rest);
    svara_formant_zero_buf(SvFormantBank_a2(bank) + z, rest);
    svara_formant_zero_buf(SvFormantBank_amp(bank) + z, rest);
    svara_formant_bank_reset(bank);
    SvFormantBank_set_count(bank, n);
    var i = 0;
    while (i < n) {
        var f = vec_get(formants, i);
        svara_formant_bank_update(bank, i, SvFormant_frequency(f), SvFormant_bandwidth(f),
          SvFormant_amplitude(f), sample_rate);
        i = i + 1;
    }
    svara_dc_blocker_reset(SvFormantFilter_dc(self));
    return 0;
}

# update_formants -- new targets for smooth transitions; count must match.
# Refuses a non-finite frequency or bandwidth before changing any slot, as
# ADR-0007 decides for every formant parameter, and a bandwidth whose
# coefficients overflow (ADR-0010). Rust's update_formants checks nothing, so
# the range checks that new and rebuild make are not added here.
#must_use
fn svara_formant_filter_update(self, formants) {
    var bank = SvFormantFilter_bank(self);
    var n = vec_len(formants);
    if (n != SvFormantBank_count(bank)) { return SVARA_ERR_INVALID_FORMANT; }
    var sr = SvFormantFilter_sample_rate(self);
    var c = 0;
    while (c < n) {
        var fc = vec_get(formants, c);
        if (svara_is_finite(SvFormant_frequency(fc)) == 0) { return SVARA_ERR_INVALID_FORMANT; }
        if (svara_is_finite(SvFormant_bandwidth(fc)) == 0) { return SVARA_ERR_INVALID_FORMANT; }
        if (svara_formant_bw_overflows(SvFormant_bandwidth(fc), sr) == 1) { return SVARA_ERR_INVALID_FORMANT; }
        c = c + 1;
    }
    var i = 0;
    while (i < n) {
        var f = vec_get(formants, i);
        svara_formant_bank_update(bank, i, SvFormant_frequency(f), SvFormant_bandwidth(f), SvFormant_amplitude(f), sr);
        i = i + 1;
    }
    return SVARA_ERR_NONE;
}

# process_sample -- bank sum through the DC blocker.
fn svara_formant_filter_process_sample(self, input) {
    var raw = svara_formant_bank_process(SvFormantFilter_bank(self), input);
    return svara_dc_blocker_process(SvFormantFilter_dc(self), raw);
}

# process_block -- n samples from input buffer into output buffer (f64 slots).
fn svara_formant_filter_process_block(self, input, output, n) {
    var bank = SvFormantFilter_bank(self);
    var i = 0;
    while (i < n) {
        store64(output + i * 8, svara_formant_bank_process(bank, load64(input + i * 8)));
        i = i + 1;
    }
    var dc = SvFormantFilter_dc(self);
    var j = 0;
    while (j < n) {
        store64(output + j * 8, svara_dc_blocker_process(dc, load64(output + j * 8)));
        j = j + 1;
    }
}

# reset -- clear bank delay lines + DC blocker.
fn svara_formant_filter_reset(self) {
    svara_formant_bank_reset(SvFormantFilter_bank(self));
    svara_dc_blocker_reset(SvFormantFilter_dc(self));
}

# num_formants -- active resonator count.
#must_use
fn svara_formant_filter_num_formants(self) {
    return SvFormantBank_count(SvFormantFilter_bank(self));
}
