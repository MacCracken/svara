# svara — Cyrius port smoke entry.
#
# Builds the ported library modules (in dependency order) into one binary and
# runs a tiny smoke, proving they compile and link as an executable. Grows one
# include per ported module. Library modules are validated per-module via
# tests/*.tcyr; this entry is not what those suites include. Consumers pull the
# `dist/svara.cyr` bundle instead (see cyrius.cyml [lib]).

# sakshi is included ONLY under -D LOGGING. svara does not otherwise use it --
# it reaches the dependency set transitively through hisab, whose own calls to it
# are dead here -- so including it unconditionally would put ~76 unused public
# functions in the flat namespace for nothing.
#ifdef LOGGING
include "lib/sakshi.cyr"
#endif
include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"
include "src/error.cyr"
include "src/logging.cyr"
include "src/rng.cyr"
include "src/smooth.cyr"
include "src/lod.cyr"
include "src/formant.cyr"
include "src/spectral.cyr"
include "src/glottal.cyr"
include "src/tract.cyr"
include "src/voice.cyr"
include "src/phoneme.cyr"
include "src/prosody.cyr"
include "src/trajectory.cyr"
include "src/sequence.cyr"
include "src/pool.cyr"
include "src/render.cyr"
include "src/bridge.cyr"

# main -- smoke entry: exercise the full pipeline; 0 on success, nonzero on any failure.
fn main() {
    #ifdef LOGGING
    svara_log_init();
    svara_log_info("svara smoke starting");
    #endif
    alloc_init();

    # Smoke: a valid sample rate passes, a bad one is rejected.
    if (svara_validate_sample_rate(f64_from(44100)) != SVARA_ERR_NONE) {
        println("svara: sample-rate validator broken");
        return 1;
    }
    if (svara_is_err(svara_validate_duration(0)) == 0) {
        println("svara: duration validator broken");
        return 1;
    }
    # Smoke: PCG32 first draw is deterministic.
    var rng = svara_rng_new(SVARA_RNG_DEFAULT_SEED);
    if (svara_rng_next_u32(rng) != 1085446021) {
        println("svara: PCG32 golden value broken");
        return 1;
    }
    # Smoke: a zero-time smoother jumps straight to its target.
    var sm = svara_smooth_with_time(0, 0, f64_from(44100));
    svara_smooth_set_target(sm, F64_ONE);
    if (f64_lt(f64_abs(f64_sub(svara_smooth_next(sm), F64_ONE)), SV_EPSILON) == 0) {
        println("svara: smoother broken");
        return 1;
    }
    # Smoke: an /a/ formant filter builds and produces a finite impulse response.
    var ff = svara_formant_filter_new(
      svara_vowel_target_to_formants(svara_vowel_target_from_vowel(SVARA_VOWEL_A)), f64_from(44100));
    if (svara_is_err(ff) == 1) {
        println("svara: formant filter init failed");
        return 1;
    }
    if (svara_is_finite(svara_formant_filter_process_sample(ff, F64_ONE)) == 0) {
        println("svara: formant filter output not finite");
        return 1;
    }
    # Smoke: FFT-analyze a short buffer (proves the hisab dep links).
    var buf = vec_new();
    var bi = 0;
    while (bi < 64) { vec_push(buf, 0); bi = bi + 1; }
    vec_set(buf, 0, F64_ONE);   # unit impulse
    var spec = svara_spectral_analyze(buf, f64_from(44100));
    if (svara_is_err(spec) == 1) {
        println("svara: spectral analyze failed");
        return 1;
    }
    # Smoke: a glottal source (naad-backed) produces a finite excitation sample.
    var gs = svara_glottal_new(f64_from(120), f64_from(44100));
    if (svara_is_err(gs) == 1) {
        println("svara: glottal source init failed");
        return 1;
    }
    if (svara_is_finite(svara_glottal_next_sample(gs)) == 0) {
        println("svara: glottal output not finite");
        return 1;
    }
    # Smoke: pipe the glottal source through a vocal tract (/a/).
    var vt = svara_tract_new(f64_from(44100));
    if (svara_is_err(vt) == 1) {
        println("svara: tract construction failed");
        return 1;
    }
    if (svara_is_err(svara_tract_set_vowel(vt, SVARA_VOWEL_A)) == 1) {
        println("svara: tract set_vowel failed");
        return 1;
    }
    if (svara_is_finite(svara_tract_process_sample(vt, svara_glottal_next_sample(gs))) == 0) {
        println("svara: tract output not finite");
        return 1;
    }
    # Smoke: phoneme classification (/a/ is a vowel, /s/ is voiceless).
    if (svara_phoneme_class(SVARA_PH_VOWEL_A) != SVARA_CLASS_VOWEL) {
        println("svara: phoneme class broken");
        return 1;
    }
    if (svara_phoneme_is_voiced(SVARA_PH_FRIC_S) != 0) {
        println("svara: phoneme voicing broken");
        return 1;
    }
    # Smoke: a female voice profile builds a glottal source at its base f0.
    var vp = svara_voice_new_female();
    var vgs = svara_voice_create_glottal_source(vp, f64_from(44100));
    if (svara_is_err(vgs) == 1) {
        println("svara: voice glottal source failed");
        return 1;
    }
    # Smoke: synthesize a full /a/ phoneme (voice → glottal → tract → samples).
    var pcm = svara_phoneme_synthesize(SVARA_PH_VOWEL_A, vp, f64_from(44100), F64_HALF);
    if (svara_is_err(pcm) == 1) {
        println("svara: phoneme synthesis failed");
        return 1;
    }
    if (vec_len(pcm) == 0) {
        println("svara: phoneme synthesis produced no samples");
        return 1;
    }
    # Smoke: reusable SynthesisContext renders a phoneme into its buffer.
    var ctx = svara_synthctx_new(vp, f64_from(44100));
    if (svara_is_err(ctx) == 1) {
        println("svara: synthesis context init failed");
        return 1;
    }
    if (svara_synthctx_synthesize(ctx, SVARA_PH_VOWEL_I, vp, F64_HALF, 0) <= 0) {
        println("svara: context synthesis produced no samples");
        return 1;
    }
    # Smoke: a rising tone contour actually rises.
    var tc = svara_tone_to_contour(SVARA_TONE_RISING);
    if (f64_gt(svara_prosody_f0_at(tc, F64_ONE), svara_prosody_f0_at(tc, 0)) == 0) {
        println("svara: prosody tone broken");
        return 1;
    }
    # Smoke: render a 2-phoneme utterance /a/-/i/ to samples.
    var seq = svara_sequence_new();
    svara_sequence_push(seq, svara_phoneme_event_new(SVARA_PH_VOWEL_A, F64_HALF, SVARA_STRESS_PRIMARY));
    svara_sequence_push(seq, svara_phoneme_event_new(SVARA_PH_VOWEL_I, F64_HALF, SVARA_STRESS_PRIMARY));
    var utt = svara_sequence_render(seq, vp, f64_from(44100));
    if (svara_is_err(utt) == 1) {
        println("svara: sequence render failed");
        return 1;
    }
    if (vec_len(utt) == 0) {
        println("svara: sequence render produced no samples");
        return 1;
    }
    # Smoke: pooled render + batch renderer + a bridge mapping.
    var pool = svara_pool_new(vp, f64_from(44100));
    if (svara_pool_render(pool, SVARA_PH_VOWEL_A, vp, F64_HALF) <= 0) {
        println("svara: pool render produced no samples");
        return 1;
    }
    var br = svara_batch_new(vp, f64_from(44100));
    svara_batch_push(br, SVARA_PH_VOWEL_A, F64_HALF, SVARA_STRESS_PRIMARY);
    if (vec_len(SvRenderOutput_samples(svara_batch_render_all(br))) == 0) {
        println("svara: batch render produced no samples");
        return 1;
    }
    if (f64_le(svara_bridge_rd_from_arousal(0), svara_bridge_rd_from_arousal(F64_ONE)) == 1) {
        println("svara: bridge mapping broken");
        return 1;
    }
    println("svara (Cyrius port) — smoke OK");
    return 0;
}

var r = main();
syscall(60, r);
