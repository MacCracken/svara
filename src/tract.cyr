# tract.cyr -- vocal tract: shapes glottal excitation into speech.
# Ports rust-old/src/tract.rs (naad-backend path — the shipped 2.0.0 default).
# Pipeline: source-filter interaction feedback -> parallel FormantFilter -> nasal
# antiformant (naad Notch biquad, place-dependent) -> subglottal resonance (naad
# ~600 Hz bandpass) -> lip-radiation HPF -> gain. LOD (Quality) gates the stages.
# f32 -> f64 throughout. The fallback NasalAntiformant + sg_state/sg_coeff fields
# are dropped (naad-backend carries both filters). serde on VocalTract dropped
# (tracked in docs/development/roadmap.md).
#
# Requires (from the build/test unit): stdlib alloc/vec/math, hisab, goonj, naad
# (filter_biquad_new/process_sample/set_params/reset, NAAD_FILTER_NOTCH/NAAD_FILTER_BANDPASS),
# error.cyr, smooth.cyr, lod.cyr, formant.cyr, glottal.cyr.

var SV_T_LIP_DEFAULT = 0x3FEF0A3D70A3D70A;   # 0.97 default lip radiation coeff
var SV_T_0_05        = 0x3FA999999999999A;   # 0.05 default interaction + subglottal coupling
var SV_T_0_2         = 0x3FC999999999999A;   # 0.2  subglottal coupling clamp hi
var SV_T_0_3         = 0x3FD3333333333333;   # 0.3  interaction strength clamp hi

# Nasal antiformant defaults (Hz).
var SV_T_NASAL_FREQ_NEUTRAL = 250;   # neutral zero (used via f64_from)
var SV_T_NASAL_BW           = 100;   # nasal zero bandwidth (via f64_from)

# NasalPlace (was `enum NasalPlace`). Rust variant order: Bilabial, Alveolar,
# Velar, Neutral.
var SVARA_NASAL_BILABIAL = 0;   # /m/ ~750 Hz
var SVARA_NASAL_ALVEOLAR = 1;   # /n/ ~1450 Hz
var SVARA_NASAL_VELAR    = 2;   # /ŋ/ ~3000 Hz
var SVARA_NASAL_NEUTRAL  = 3;   # ~250 Hz

# antiformant_frequency -- nasal zero center for a place of articulation.
#must_use
fn svara_nasal_place_antiformant_frequency(place) {
    if (place == SVARA_NASAL_BILABIAL) { return f64_from(750); }
    if (place == SVARA_NASAL_ALVEOLAR) { return f64_from(1450); }
    if (place == SVARA_NASAL_VELAR) { return f64_from(3000); }
    return f64_from(250);   # Neutral
}

# VocalTract -- formant bank + nasal/subglottal biquads + lip radiation + gain.
#derive(accessors)
# `formants` is an SvFormant vec owned by the tract. It serves two purposes at
# once: set_formants_from_target fills it in place so the bank can be refreshed
# without allocating, AND it is the tract's record of its CURRENT formants --
# which is what SvVocalTractState needs, since a built biquad bank holds
# coefficients from which frequency and bandwidth cannot be recovered.
struct SvVocalTract {
    filter; nasal_coupling; nasal_antiformant; lip_prev; lip_radiation;
    interaction_strength; interaction_feedback; subglottal_coupling;
    subglottal_filter; gain; quality; sample_rate; formants; nasal_place;
}

# new -- default neutral vowel (schwa), Full quality. Returns a tract pointer,
# or a negative SVARA_ERR_* if even the fallback filter cannot be built (a
# non-positive or non-finite sample_rate is the only way that happens).
# `0` reads as +0.0.
#
# Rust's `VocalTract::new` returns `Self` and ends the fallback with
# `.expect("fallback formant filter must succeed")` -- it PANICS. The port had
# neither: it stored the negative error code in the `filter` field and handed
# back a tract that looked valid, so the first process_sample dereferenced a
# small negative address. Reporting the error is the code/sentinel equivalent of
# the panic, and every caller checks it.
#must_use
fn svara_tract_new(sample_rate) {
    var target = svara_vowel_target_from_vowel(SVARA_VOWEL_SCHWA);
    # `fvec` is kept, not discarded: it becomes the tract's `formants` record, so
    # the record always describes the filter that was actually built. Setting it
    # to a fresh zeroed scratch instead left a brand-new tract claiming five
    # 0 Hz formants -- which svara_tract_save then captured and
    # svara_tract_restore correctly refused.
    var fvec = svara_vowel_target_to_formants(target);
    var filter = svara_formant_filter_new(fvec, sample_rate);
    if (svara_is_err(filter) == 1) {
        # absolute fallback: single 500 Hz formant
        fvec = vec_new();
        vec_push(fvec, svara_formant_new(f64_from(500), f64_from(100), F64_ONE));
        filter = svara_formant_filter_new(fvec, sample_rate);
    }
    if (svara_is_err(filter) == 1) { return filter; }

    var self = alloc(sizeof(SvVocalTract));
    SvVocalTract_set_filter(self, filter);
    SvVocalTract_set_formants(self, fvec);
    SvVocalTract_set_nasal_coupling(self, svara_smooth_new(0, sample_rate));
    # Both biquads below are fixed-frequency, so each carries its own implied
    # minimum sample rate: naad rejects a centre frequency at or above nyquist
    # (validate_frequency), which makes the 250 Hz notch need > 500 Hz and the
    # 600 Hz subglottal bandpass need > 1200 Hz. Their returns used to be stored
    # UNCHECKED, so below those rates a negative naad error code was written in
    # as the filter pointer and the first render dereferenced it. Report instead:
    # a tract that cannot build its own fixed filters is not a usable tract.
    var nasal_q = f64_div(f64_from(SV_T_NASAL_FREQ_NEUTRAL), f64_from(SV_T_NASAL_BW));   # 2.5
    var nasal_af = filter_biquad_new(NAAD_FILTER_NOTCH, sample_rate, f64_from(SV_T_NASAL_FREQ_NEUTRAL), nasal_q);
    if (naad_is_err(nasal_af) == 1) { return svara_map_naad_error(nasal_af); }
    SvVocalTract_set_nasal_antiformant(self, nasal_af);
    SvVocalTract_set_lip_prev(self, 0);
    SvVocalTract_set_lip_radiation(self, SV_T_LIP_DEFAULT);
    SvVocalTract_set_interaction_strength(self, SV_T_0_05);
    SvVocalTract_set_interaction_feedback(self, 0);
    SvVocalTract_set_subglottal_coupling(self, SV_T_0_05);
    var sg_q = f64_div(f64_from(600), f64_from(80));   # 7.5
    var sg_f = filter_biquad_new(NAAD_FILTER_BANDPASS, sample_rate, f64_from(600), sg_q);
    if (naad_is_err(sg_f) == 1) { return svara_map_naad_error(sg_f); }
    SvVocalTract_set_subglottal_filter(self, sg_f);
    SvVocalTract_set_gain(self, svara_smooth_new(F64_ONE, sample_rate));
    SvVocalTract_set_quality(self, SVARA_QUALITY_FULL);
    SvVocalTract_set_sample_rate(self, sample_rate);
    SvVocalTract_set_nasal_place(self, SVARA_NASAL_NEUTRAL);
    return self;
}

# ================================================================
# VocalTractState -- the flat, serializable form of VocalTract.
#
# VocalTract is NOT derived: it holds a FormantFilter pointer, two SmoothedParam
# pointers and TWO naad BiquadFilter handles, and neither a nested #derive-struct
# field nor a foreign handle can round-trip (ADR-0002). Everything here is either
# a scalar or the formant list, and the rest is rebuilt.
#
# The two SmoothedParams contribute `current` and `target` only: their `alpha` is
# a pure function of the sample rate, so restore re-derives it rather than
# carrying a number that must agree with one.
#
# ⚠ WHAT RESTORE DOES NOT REPRODUCE: the filter bank's delay lines and the two
# naad biquads' internal state. That is deliberate and matches the oracle --
# Rust's `set_formants` is `self.filter = FormantFilter::new(..)?`, which discards
# the delay lines on every call, so there is nothing there a caller could have
# relied on. `lip_prev` and `interaction_feedback`, which ARE one-sample memories
# svara owns, are carried.
# ================================================================
#derive(accessors)
#derive(Serialize)
struct SvVocalTractState {
    formants: Vec<SvFormant>;
    nasal_coupling_current: f64; nasal_coupling_target: f64;
    gain_current: f64; gain_target: f64;
    lip_prev: f64; lip_radiation: f64;
    interaction_strength: f64; interaction_feedback: f64;
    subglottal_coupling: f64;
    nasal_place: i64; quality: i64; sample_rate: f64;
}

# save -- snapshot a VocalTract into its serializable form. The formant list is
# copied into a fresh vec (save is not a hot path) so the state does not alias
# the tract's own working vec.
#must_use
fn svara_tract_save(self) {
    var st = alloc(sizeof(SvVocalTractState));
    var src = SvVocalTract_formants(self);
    var out = vec_new();
    var i = 0;
    while (i < vec_len(src)) {
        var f = vec_get(src, i);
        vec_push(out, svara_formant_new(SvFormant_frequency(f), SvFormant_bandwidth(f),
            SvFormant_amplitude(f)));
        i = i + 1;
    }
    SvVocalTractState_set_formants(st, out);
    var nc = SvVocalTract_nasal_coupling(self);
    SvVocalTractState_set_nasal_coupling_current(st, svara_smooth_value(nc));
    SvVocalTractState_set_nasal_coupling_target(st, SvSmoothedParam_target(nc));
    var gn = SvVocalTract_gain(self);
    SvVocalTractState_set_gain_current(st, svara_smooth_value(gn));
    SvVocalTractState_set_gain_target(st, SvSmoothedParam_target(gn));
    SvVocalTractState_set_lip_prev(st, SvVocalTract_lip_prev(self));
    SvVocalTractState_set_lip_radiation(st, SvVocalTract_lip_radiation(self));
    SvVocalTractState_set_interaction_strength(st, SvVocalTract_interaction_strength(self));
    SvVocalTractState_set_interaction_feedback(st, SvVocalTract_interaction_feedback(self));
    SvVocalTractState_set_subglottal_coupling(st, SvVocalTract_subglottal_coupling(self));
    SvVocalTractState_set_nasal_place(st, SvVocalTract_nasal_place(self));
    SvVocalTractState_set_quality(st, SvVocalTract_quality(self));
    SvVocalTractState_set_sample_rate(st, SvVocalTract_sample_rate(self));
    return st;
}

# restore -- rebuild a VocalTract from a state snapshot. Returns a tract pointer
# or a negative SVARA_ERR_*: a decoded state is externally-authored data, so the
# sample rate and the formant list are validated through the ordinary
# constructors rather than trusted.
#must_use
fn svara_tract_restore(st) {
    var self = svara_tract_new(SvVocalTractState_sample_rate(st));
    if (svara_is_err(self) == 1) { return self; }
    var e = svara_tract_set_formants(self, SvVocalTractState_formants(st));
    if (svara_is_err(e) == 1) { return e; }
    var nc = SvVocalTract_nasal_coupling(self);
    SvSmoothedParam_set_current(nc, SvVocalTractState_nasal_coupling_current(st));
    SvSmoothedParam_set_target(nc, SvVocalTractState_nasal_coupling_target(st));
    var gn = SvVocalTract_gain(self);
    SvSmoothedParam_set_current(gn, SvVocalTractState_gain_current(st));
    SvSmoothedParam_set_target(gn, SvVocalTractState_gain_target(st));
    SvVocalTract_set_lip_prev(self, SvVocalTractState_lip_prev(st));
    SvVocalTract_set_lip_radiation(self, SvVocalTractState_lip_radiation(st));
    SvVocalTract_set_interaction_strength(self, SvVocalTractState_interaction_strength(st));
    SvVocalTract_set_interaction_feedback(self, SvVocalTractState_interaction_feedback(st));
    SvVocalTract_set_subglottal_coupling(self, SvVocalTractState_subglottal_coupling(st));
    SvVocalTract_set_quality(self, SvVocalTractState_quality(st));
    # through the setter so the naad notch is retuned, not just the field written
    svara_tract_set_nasal_place(self, SvVocalTractState_nasal_place(st));
    return self;
}

# ---- configuration --------------------------------------------------------
# set_formants -- rebuild the formant bank; returns SVARA_ERR_NONE or an error.
#
# Rust is `self.filter = FormantFilter::new(formants, self.sample_rate)?`, which
# discards the delay lines; svara_formant_filter_rebuild reproduces that state
# exactly while REUSING the filter's storage. That matters because the
# trajectory-planned render path calls this once per output sample and the bump
# allocator never frees: the old build-and-discard form spent 736 bytes of arena
# per sample, so a minute of speech needed gigabytes that were never released.
#must_use
fn svara_tract_set_formants(self, formants) {
    var cur = SvVocalTract_filter(self);
    var e = SVARA_ERR_NONE;
    if (cur != 0) {
        e = svara_formant_filter_rebuild(cur, formants);
    } else {
        var f = svara_formant_filter_new(formants, SvVocalTract_sample_rate(self));
        if (svara_is_err(f) == 1) { return f; }
        SvVocalTract_set_filter(self, f);
    }
    if (svara_is_err(e) == 1) { return e; }
    svara_tract_record_formants(self, formants);
    return SVARA_ERR_NONE;
}

# record_formants -- keep the tract's `formants` vec equal to what the bank was
# just built from, so SvVocalTractState can reproduce it. Copies VALUES, and is a
# no-op self-copy when the caller passed the tract's own vec (the
# set_formants_from_target path). Allocates only when the formant COUNT changes,
# which on the per-sample render path happens once.
fn svara_tract_record_formants(self, formants) {
    var rec = SvVocalTract_formants(self);
    var n = vec_len(formants);
    if (vec_len(rec) != n) {
        rec = vec_new();
        var k = 0;
        while (k < n) { vec_push(rec, svara_formant_new(0, 0, 0)); k = k + 1; }
        SvVocalTract_set_formants(self, rec);
    }
    if (rec == formants) { return 0; }
    var i = 0;
    while (i < n) {
        var src = vec_get(formants, i);
        var dst = vec_get(rec, i);
        SvFormant_set_frequency(dst, SvFormant_frequency(src));
        SvFormant_set_bandwidth(dst, SvFormant_bandwidth(src));
        SvFormant_set_amplitude(dst, SvFormant_amplitude(src));
        i = i + 1;
    }
    return 0;
}

# set_formants_from_target -- as above, from a VowelTarget. Fills the tract's own
# formant vec in place rather than allocating a fresh one per call, so
# set_formants sees its own vec and record_formants is a no-op.
#must_use
fn svara_tract_set_formants_from_target(self, target) {
    var own = SvVocalTract_formants(self);
    # svara_vowel_target_to_formants_into writes FIVE formants unconditionally and
    # documents that precondition (formant.cyr). This call site could violate it:
    # svara_tract_new falls back to a SINGLE 500 Hz formant when the sample rate
    # cannot carry the five-formant schwa (its F5 is 3750 Hz, so anything at or
    # below 7500 Hz), and stores that one-element vec as the tract's record. The
    # write then ran off the end of the vec and ABORTED the process with
    # "vec: index out of bounds" -- with no error code for the caller to check,
    # since the tract itself had been returned as valid.
    #
    # Build a fresh five instead and let set_formants -> filter_rebuild validate
    # it against the sample rate. rebuild validates BEFORE mutating, so a rate
    # that cannot carry five formants now returns SVARA_ERR_INVALID_FORMANT and
    # leaves the fallback bank untouched -- a checkable failure instead of a crash.
    if (vec_len(own) < SVARA_VOWEL_FORMANT_COUNT) {
        return svara_tract_set_formants(self, svara_vowel_target_to_formants(target));
    }
    svara_vowel_target_to_formants_into(target, own);
    return svara_tract_set_formants(self, own);
}

#must_use
fn svara_tract_set_vowel(self, vowel) {
    return svara_tract_set_formants_from_target(self, svara_vowel_target_from_vowel(vowel));
}

# set_nasal_coupling -- velopharyngeal opening (smoothed), clamped [0,1].
fn svara_tract_set_nasal_coupling(self, coupling) {
    svara_smooth_set_target(SvVocalTract_nasal_coupling(self), f64_clamp(coupling, 0, F64_ONE));
}

# set_lip_radiation -- lip-radiation differentiator coefficient, clamped [0,1].
fn svara_tract_set_lip_radiation(self, coefficient) {
    SvVocalTract_set_lip_radiation(self, f64_clamp(coefficient, 0, F64_ONE));
}

# set_nasal_place -- retune the nasal antiformant (preserves filter state).
# The place is also recorded: the naad notch holds only its coefficients, so
# without this a tract could not report its own configuration and
# svara_tract_restore could not reproduce it.
fn svara_tract_set_nasal_place(self, place) {
    var freq = svara_nasal_place_antiformant_frequency(place);
    var q = f64_div(freq, f64_from(SV_T_NASAL_BW));
    filter_biquad_set_params(SvVocalTract_nasal_antiformant(self), freq, q, 0);
    SvVocalTract_set_nasal_place(self, place);
}

# nasal_place -- the place the antiformant is currently tuned to.
#must_use
fn svara_tract_nasal_place(self) { return SvVocalTract_nasal_place(self); }

# set_interaction_strength -- source-filter feedback amount, clamped [0,0.3].
fn svara_tract_set_interaction_strength(self, strength) {
    SvVocalTract_set_interaction_strength(self, f64_clamp(strength, 0, SV_T_0_3));
}

# set_subglottal_coupling -- subglottal-resonance coupling, clamped [0,0.2].
fn svara_tract_set_subglottal_coupling(self, strength) {
    SvVocalTract_set_subglottal_coupling(self, f64_clamp(strength, 0, SV_T_0_2));
}

# set_gain -- output gain (smoothed), floored at 0.
fn svara_tract_set_gain(self, gain) {
    svara_smooth_set_target(SvVocalTract_gain(self), f64_max(gain, 0));
}

# set_quality -- level-of-detail tier (SVARA_QUALITY_*) gating optional stages.
fn svara_tract_set_quality(self, quality) {
    SvVocalTract_set_quality(self, quality);
}

#must_use
fn svara_tract_quality(self) { return SvVocalTract_quality(self); }
#must_use
fn svara_tract_sample_rate(self) { return SvVocalTract_sample_rate(self); }

# ---- processing -----------------------------------------------------------
# process_sample -- one excitation sample through the full (LOD-gated) pipeline.
#inline
fn svara_tract_process_sample(self, input) {
    var q = SvVocalTract_quality(self);

    # source-filter interaction: feed a fraction of last output back
    var excitation = input;
    if (svara_quality_use_interaction(q) == 1) {
        excitation = f64_sub(input,
          f64_mul(SvVocalTract_interaction_strength(self), SvVocalTract_interaction_feedback(self)));
    }

    var formant_out = svara_formant_filter_process_sample(SvVocalTract_filter(self), excitation);

    # nasal coupling: blend oral vs nasalized (smoother always advances)
    var nc = svara_smooth_next(SvVocalTract_nasal_coupling(self));
    var output = formant_out;
    if ((svara_quality_use_nasal_coupling(q) == 1) & (f64_gt(nc, 0) == 1)) {
        var nasal = filter_biquad_process_sample(SvVocalTract_nasal_antiformant(self), formant_out);
        output = f64_add(f64_mul(formant_out, f64_sub(F64_ONE, nc)), f64_mul(nasal, nc));
    }

    # subglottal resonance coupling
    if ((svara_quality_use_subglottal(q) == 1) & (f64_gt(SvVocalTract_subglottal_coupling(self), 0) == 1)) {
        var sg_out = filter_biquad_process_sample(SvVocalTract_subglottal_filter(self), output);
        output = f64_add(output, f64_mul(sg_out, SvVocalTract_subglottal_coupling(self)));
    }

    # lip radiation: first-order high-pass difference
    var radiated = output;
    if (svara_quality_use_lip_radiation(q) == 1) {
        radiated = f64_sub(output, f64_mul(SvVocalTract_lip_radiation(self), SvVocalTract_lip_prev(self)));
        SvVocalTract_set_lip_prev(self, output);
    }

    SvVocalTract_set_interaction_feedback(self, radiated);
    return f64_mul(radiated, svara_smooth_next(SvVocalTract_gain(self)));
}

# synthesize_into -- fill an n-slot f64 buffer from a glottal source.
fn svara_tract_synthesize_into(self, glottal, output, n) {
    var i = 0;
    while (i < n) {
        var exc = svara_glottal_next_sample(glottal);
        store64(output + i * 8, svara_tract_process_sample(self, exc));
        i = i + 1;
    }
}

# synthesize -- allocate an n-slot f64 buffer and fill it. Returns the buffer,
# or 0 if `n` is not an allocatable sample count (see svara_alloc_samples): the
# caller MUST test for 0 -- writing through it would store to address 0.
#must_use
fn svara_tract_synthesize(self, glottal, n) {
    var out = svara_alloc_samples(n);
    if (out == 0) { return 0; }
    svara_tract_synthesize_into(self, glottal, out, n);
    return out;
}

# reset -- clear filter history + feedback state.
fn svara_tract_reset(self) {
    svara_formant_filter_reset(SvVocalTract_filter(self));
    filter_biquad_reset(SvVocalTract_nasal_antiformant(self));
    SvVocalTract_set_lip_prev(self, 0);
    SvVocalTract_set_interaction_feedback(self, 0);
    filter_biquad_reset(SvVocalTract_subglottal_filter(self));
}
