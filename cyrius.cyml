[package]
name = "svara"
version = "${file:VERSION}"
description = "svara — formant and vocal synthesis (glottal source, vocal tract, phonemes, prosody). Cyrius port of an 8,785-line Rust library."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/svara"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
output = "build/svara"

# `[lib]` declares the distlib bundle `cyrius distlib` writes into
# `dist/svara.cyr` — modules concatenated in dependency order (deps before
# dependents), each self-contained (no `include` lines). The bundle resolves
# stdlib + hisab + naad from the CONSUMER's manifest (dhvani / vansh), same
# pattern naad uses. Grows one entry per ported module.
[lib]
modules = [
    "src/error.cyr",
    "src/logging.cyr",
    "src/rng.cyr",
    "src/smooth.cyr",
    "src/lod.cyr",
    "src/formant.cyr",
    "src/spectral.cyr",
    "src/glottal.cyr",
    "src/tract.cyr",
    "src/voice.cyr",
    "src/phoneme.cyr",
    "src/prosody.cyr",
    "src/trajectory.cyr",
    "src/sequence.cyr",
    "src/pool.cyr",
    "src/render.cyr",
    "src/bridge.cyr",
]

# stdlib: math gives clamp/min/max/lerp/sign + F64_* constants; ganita gives
# the transcendentals svara's DSP leans on (sin/cos/exp/ln/pow/sqrt/tanh/…);
# tagged for the few Option-shaped returns; result for hisab's fallible returns
# (`num_fft`, since hisab 3.0.0); bench for .bcyr harnesses.
[deps]
stdlib = [
    "syscalls",
    "string",
    "alloc",
    "str",
    "fmt",
    "vec",
    "io",
    "args",
    "assert",
    "math",
    "ganita",
    "tagged",
    "result",
    "fnptr",
    "bench",
]

# hisab (FFT / HComplex / compensated sum / easing / interp) — consumed by
# spectral.cyr (num_fft, num_neumaier_sum). Pinned to the tag naad uses, for a
# coherent bundle in downstream consumers (dhvani / vansh) that pull both.
# 3.4.1 is hisab's newest tag and pins exactly cyrius 6.7.18.
[deps.hisab]
git = "https://github.com/MacCracken/hisab.git"
tag = "3.4.1"
modules = ["dist/hisab.cyr"]

# naad — biquad / noise (NoiseGenerator) / LFO (modulation) backends consumed by
# glottal.cyr (aspiration noise + vibrato) and tract.cyr (nasal notch, subglottal
# bandpass). The dist bundle references goonj (acoustics) + sakshi (logging), which
# resolve from this manifest; sakshi arrives transitively via hisab. Pinned to the
# released tags naad uses, for a coherent bundle in downstream consumers. naad
# 2.3.3 and goonj 2.3.1 are their newest tags, and both pin cyrius 6.7.18 and hisab
# 3.4.1, so all three agree.
[deps.naad]
git = "https://github.com/MacCracken/naad.git"
tag = "2.3.3"
modules = ["dist/naad.cyr"]

[deps.goonj]
git = "https://github.com/MacCracken/goonj.git"
tag = "2.3.1"
modules = ["dist/goonj.cyr"]
